tp Domain mt (self Memar_Git_Deadline) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Git")(s, VoidError)
}

tp Summary mt (self Memar_Git_Deadline) () (s String) {
    CharacterRun_From.FromCharacterRun("The moment a command stops waiting for locks")(s, VoidError)
}

tp Overview mt (self Memar_Git_Deadline) () (s String) {
    CharacterRun_From.FromCharacterRun("The moment a command stops waiting for locks.")(s, VoidError)
}

tp UserActionNote mt (self Memar_Git_Deadline) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_Git_Deadline) () (s String) {
    CharacterRun_From.FromCharacterRun("One deadline for all the stages of a command, started once, so that the wait is one wait in all.")(s, VoidError)
}
