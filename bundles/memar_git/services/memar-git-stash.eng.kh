tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_Git_Stash in "bundles/memar_git/services/memar-git-stash.kh"

tp Domain mt (self Memar_Git_Stash) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Git")(s, VoidError)
}

tp Summary mt (self Memar_Git_Stash) () (s String) {
    CharacterRun_From.FromCharacterRun("Set uncommitted work aside where a later task can get it back")(s, VoidError)
}

tp Overview mt (self Memar_Git_Stash) () (s String) {
    CharacterRun_From.FromCharacterRun("Set uncommitted work aside where a later task can get it back.")(s, VoidError)
}

tp UserActionNote mt (self Memar_Git_Stash) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_Git_Stash) () (s String) {
    CharacterRun_From.FromCharacterRun("Tracked and untracked work is set aside, ignored work is not. The message may be empty. A failure of git is GitFailed. With a clean tree it says that there is nothing to stash and succeeds, creating no stash. It answers with no stash id; the work is recovered with git's own stash commands. It is preferred to every discard.")(s, VoidError)
}
