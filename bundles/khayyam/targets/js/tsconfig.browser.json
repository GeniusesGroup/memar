{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "../..",
    "outDir": "build/compiler"
  },
  "files": [
    "src/program.ts",
    "src/link.ts",
    "src/run.ts",
    "demo/page-host.ts"
  ]
}
