var httpHandler http.HandlerV1
var srpcHandler srpc.Handler

// Register app layer protocols. Dev can remove below and register only needed protocols handlers.
func registerNetworkApplicationsMux() {
	protocol.App.Log(log.InfoEvent(domainEnglish, "try to register HTTP handler on port number 80 to listen for HTTP protocol"))
	achaemenid.App.SetNetworkApplicationHandler(protocol.NetworkApplicationHTTP, &httpHandler)

	// http.ServeWWWService.WWW.ContentEncodings = []string{compress.} overwrite ContentEncodings if don't like already assign.
	http.ServeWWWService.WWW.Init()
	if protocol.AppMode_Dev {
		go http.ServeWWWService.WWW.ReloadByCLI()
	}

	protocol.App.Log(log.InfoEvent(domainEnglish, "try to register HTTP handler on port number 4 to listen for sRPC protocol"))
	achaemenid.App.SetNetworkApplicationHandler(protocol.NetworkApplicationSRPC, &srpcHandler)
}

// Register some selectable networks. Check to add or delete networks.
