// ReceiveCameraDataSRPC is sRPC handler of ReceiveCameraData service.
func ReceiveCameraDataSRPC(st protocol.Stream) {
	var req = &receiveCameraDataReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}

	err = receiveCameraData(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}
	st.OutcomePayload = make([]byte, srpc.MinLength)
}

