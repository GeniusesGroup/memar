tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_Fs_Commands in "bundles/memar_fs/services/memar-fs-commands.kh"

tp Domain mt (self Memar_Fs_Commands) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Fs")(s, VoidError)
}

tp Summary mt (self Memar_Fs_Commands) () (s String) {
    CharacterRun_From.FromCharacterRun("List every verb of the bundle with its call shape and a line on what it is for")(s, VoidError)
}

tp Overview mt (self Memar_Fs_Commands) () (s String) {
    CharacterRun_From.FromCharacterRun("List every verb of the bundle with its call shape and a line on what it is for.")(s, VoidError)
}

tp UserActionNote mt (self Memar_Fs_Commands) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_Fs_Commands) () (s String) {
    CharacterRun_From.FromCharacterRun("Serves an agent that has no MCP tools, as the commands listing of the Memar server serves the verbs it registers; an agent with MCP finds the same verbs as tools, and the listing and the tools are read from the same declared command lines, so neither is written twice. It lists the three command verbs only, not Copy, which is a library service. The listing carries the constraints those verbs keep, each in the help of its own verb. It reads nothing of a file.")(s, VoidError)
}
