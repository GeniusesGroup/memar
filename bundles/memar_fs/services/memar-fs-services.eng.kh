tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_Fs_Services in "bundles/memar_fs/services/memar-fs-services.kh"

tp Domain mt (self Memar_Fs_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Fs")(s, VoidError)
}

tp Summary mt (self Memar_Fs_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The verbs of the bundle, one getter for each")(s, VoidError)
}

tp Overview mt (self Memar_Fs_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The verbs of the bundle, one getter for each.")(s, VoidError)
}

tp UserActionNote mt (self Memar_Fs_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_Fs_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The four verbs and the listing, one getter for each. Three are command verbs, which the command tree and the MCP tools of the Memar server declare; Copy is a library service with no command.")(s, VoidError)
}
