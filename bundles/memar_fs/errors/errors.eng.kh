tp Domain mt (self Error_Memar_Fs_Refusal) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Fs")(s, VoidError)
}

tp Summary mt (self Error_Memar_Fs_Refusal) () (s String) {
    CharacterRun_From.FromCharacterRun("A verb refuses; nothing is changed, except that Trash goes path by path, and the paths before the refused one are already done")(s, VoidError)
}

tp Overview mt (self Error_Memar_Fs_Refusal) () (s String) {
    CharacterRun_From.FromCharacterRun("A verb refuses; nothing is changed, except that Trash goes path by path, and the paths before the refused one are already done.")(s, VoidError)
}

tp UserActionNote mt (self Error_Memar_Fs_Refusal) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Memar_Fs_Refusal) () (s String) {
    CharacterRun_From.FromCharacterRun("The detail names the verb and what to change in the call.")(s, VoidError)
}

