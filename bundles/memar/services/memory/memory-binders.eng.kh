tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_Memory_Binders in "bundles/memar/services/memory/memory-binders.kh"

tp Domain mt (self Memar_Memory_Binders) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar Memory")(s, VoidError)
}

tp Summary mt (self Memar_Memory_Binders) () (s String) {
    CharacterRun_From.FromCharacterRun("The binders of the adapter modules, found by the capability name of an adapter")(s, VoidError)
}

tp Overview mt (self Memar_Memory_Binders) () (s String) {
    CharacterRun_From.FromCharacterRun("The binders of the adapter modules, found by the capability name of an adapter.")(s, VoidError)
}

tp UserActionNote mt (self Memar_Memory_Binders) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_Memory_Binders) () (s String) {
    CharacterRun_From.FromCharacterRun("The name is lowercase letters and digits in groups joined by single hyphens and is the name of a module among the pluggable store modules; a module that offers no binder is not found. Nothing heavy is loaded until a class is opened.")(s, VoidError)
}
