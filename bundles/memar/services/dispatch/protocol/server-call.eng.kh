tp Server_Call in "./server-call.kh"

mt Summary (self Server_Call) () (s str) {
	return "a face-neutral call a Memar face places on the server process"
}

mt Overview (self Server_Call) () (s str) {
	return "Carries already-decoded service fields, the run refs to invoke, working directory, environment, and optional standard input. Faces (command line, MCP) fill it; the server dispatch answers without reading argv. JSON is the interim wire form until a tighter codec adjunct is chosen."
}
