tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_View_Services in "bundles/memar/services/view/services/view-services.kh"

tp Domain mt (self Memar_View_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar View")(s, VoidError)
}

tp Summary mt (self Memar_View_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The read-only folder a project view key names, built from the nodes of one class")(s, VoidError)
}

tp Overview mt (self Memar_View_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The read-only folder a project view key names, built from the nodes of one class.")(s, VoidError)
}

tp UserActionNote mt (self Memar_View_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_View_Services) () (s String) {
    CharacterRun_From.FromCharacterRun("The folder is ignored by version control, its files are read-only and no verb reads it; a change goes through a verb. The verb is kept in the bundle because it opens a class through the memory services, which are the bundle own, and a pluggable module does not reach a bundle.")(s, VoidError)
}
