tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Memar_View_Refresh in "bundles/memar/services/view/services/view-refresh.kh"

tp Domain mt (self Memar_View_Refresh) () (s String) {
    CharacterRun_From.FromCharacterRun("Memar View")(s, VoidError)
}

tp Summary mt (self Memar_View_Refresh) () (s String) {
    CharacterRun_From.FromCharacterRun("Build the view of a project again from the committed nodes of its class")(s, VoidError)
}

tp Overview mt (self Memar_View_Refresh) () (s String) {
    CharacterRun_From.FromCharacterRun("Build the view of a project again from the committed nodes of its class.")(s, VoidError)
}

tp UserActionNote mt (self Memar_View_Refresh) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Memar_View_Refresh) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the key view of the project, opens the class it names through Open of the memory services, and hands the record it returns, with the presentation registered for the class, to the builder; it closes the store afterwards. Only the files the builder wrote before are touched: a file changed by hand is restored and counted, a file no node shows any more is removed. It is refused, with the exit status one, when the project is not named, the key is unset or not one pair, no presentation is registered for the class, the class cannot be opened, or the build is refused.")(s, VoidError)
}
