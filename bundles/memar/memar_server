"""memar_server — the Memar server process entry: resident serve, no argv face.

PATH installs this as memar_server. The face (memar) places Server_Call on it.
With no arguments it runs the resident; it does not assemble argparse verbs.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
TOP = HERE.parent.parent
for folder in (TOP, HERE, HERE / "services"):
    if str(folder) not in sys.path:
        sys.path.insert(0, str(folder))

importlib.import_module("bundles.memar.services.location.memar_location").declare_program(
    importlib.import_module("bundles.memar.services.location.memar_location").entry_program(__file__)
)
importlib.import_module("modules.knowledge.label.primitive.declared_label").DeclaredLabel.declare_modules(
    importlib.import_module("modules.computer.software.edges.manifest.services.bundle_modules").modules_of(HERE)
)


def main() -> int:
    from resident.services.serve import serve_forever

    return serve_forever()


if __name__ == "__main__":
    raise SystemExit(main())
