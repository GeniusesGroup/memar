"""memar — the one command a person or an agent types to reach Memar.

    memar <verb>              what it routes to; run `memar --help`
    memar --help              what Memar is, and the verbs its services declare

This file routes and nothing else, and it knows no verb: only which module holds
each domain. Every module of a domain, its own file and each file in its
`services/` folder, that has a command-line face declares it through one function,
`describe(verbs)`, the way every Memar type introduces itself
(modules/computer/type/protocol/detail.kh): the consumer calls only the method
it needs, and the declaration stays the one authority for what a verb accepts
and what its help says. A router that restated either would be a second
interface for one behavior, and the two would drift.

**The contract**, which every service with a command line keeps:

    describe(verbs) -> callable | None

`verbs` is where the module's verb goes: `memar`'s own verbs for a domain's
own file (`modules/process/session/session.py`), that domain verb's sub-verbs
for one of its capabilities (`modules/process/session/services/new.py`). It offers argparse's `add_parser`;
the service registers at most one verb on it, with its one-line summary as
`help` and, where it has one, its overview as `description`, adds the verb's
arguments, and returns
the callable that runs it — `run(args)`, given the parsed namespace, returning
an exit status or None for 0. A domain's run, where it returns one, runs before
its sub-verb's, so what every verb of a domain owes is said once. A module that
registers nothing and returns a callable asks to act before whichever verb is
routed — `before(argv)`, given the arguments as typed, even for `--help`, and
never failing the verb. `describe` does no work beyond declaring, and a module
that declares imports nothing heavy at module level, because every invocation
imports every service to assemble the command line.

**Two audiences, two texts.** `memar --help` is addressed to a person who has
Memar and wants to know what it is and what it does for them: it says what
Memar is, which is the command's own and so held here, and lists what the
services declare. The design above is addressed to whoever opens this file.

**Each help states its own work, and no sub-verb's** (owner, 2026-10-14). A
domain verb's overview says what the domain is, the words its sub-verbs share,
and what its own run does; argparse lists its sub-verbs under it, each with the
summary it declared, and each sub-verb's command lines, what it writes, and
when to use it are in that sub-verb's own `--help`. An overview that repeated
them grew with every sub-verb and drifted from each, and the reader who needs
one sub-verb paid for all of them. How a help is shaped beyond that waits for
the command module (`modules-plugable/computer/ui/cli/command/`), which is not built on
until it is complete.

The name is the whole of the design. A framework whose entry point is a path
into a scripts folder asks every caller to know where it lives and what it is
called; `memar` asks for neither, so the same word works in a shell, in an
agent's command, in a CI step, and in a document that tells a reader what to
type.

**What it routes to is what Memar itself does**, and nothing else. A tool that
constrains a host tool the framework has no claim to does not belong on the
shelf — see `modules-plugable/computer/git/services/_host_git_cli.py` root `--help` for why path-invoked constraint scripts stay off the router.

Two launchers carry this file: this one, executable where a file may be, and
`memar.cmd` beside it for a Windows shell that will not run a file without a
known extension. Both hand the same arguments to the same interpreter.

Usage is the interface. Do not duplicate these recipes as prose catalogs.
"""

from __future__ import annotations

import argparse
import functools
import importlib
import os
import sys
from pathlib import Path
from typing import Callable, Iterable

SCRIPTS = Path(__file__).resolve().parent
# The checkout's top too: a module under `modules/` that holds code (its `primitive/` types) is imported by its
# path from there, `modules.content.documentation...`, so the top is on the search path as this folder is.
TOP = SCRIPTS.parent.parent
for folder in (TOP, SCRIPTS, SCRIPTS / "services"):
    if str(folder) not in sys.path:
        sys.path.insert(0, str(folder))

from machine.console import use_utf8_stdio
from machine.plugable_import import load as plugable_load

role_folders = plugable_load("computer.filesystem.services.fs_memar").role_folders

SERVICES = "services"
DESCRIBE = "describe"
# Where modules are looked for, each with the folder its modules' import addresses start from: the checkout's top,
# under which the kernel modules stand in `modules/`, the pluggable ones in `modules-plugable/`, and the bundles in
# `bundles/`; or this folder (`bundles/memar`), which is on the search path too and holds provisional
# modules the router shelves here; and the folders inside a module that are not modules: the role folders the module-skeleton profile
# declares, asked of it and never copied here, and the folders the toolchains keep, which are the router's own.
SEARCHED_ROOTS = (
    ("modules", "."),
    ("modules-plugable", "."),
    ("bundles", "."),
    ("bundles/memar/services", "."),
)
NOT_MODULES = frozenset({SERVICES, *role_folders(), "node_modules", "__pycache__"})
# A module that has a command-line face keeps it in a file named by its folder (`session/session.py`);
# each capability is a file in its `services/` folder. The name the router works with is the folder's
# alone for the module's own file, and the folder, this separator and the file's name for a capability
# (`session_new`), which is how a capability finds the verb it goes under.
DOMAIN_SEPARATOR = "_"
VERB_METAVAR = "<verb>"
HELP_WORDS = ("help",)
RUN_PREFIX = "_memar_run_"

ABOUT = """memar — Memar, a development framework whose model is written down

Memar keeps its model of software design, its rules, and its language sources
as documents in a checkout, and this is the one command that reaches them.

Each verb's own help defines the words that are its own."""

EPILOG = """Ask any verb with `--help` and it says what it accepts.

Before deleting, moving, restoring, or committing files, use
`modules-plugable/computer/git/services/_host_git_cli.py` and the services under
`modules-plugable/computer/filesystem/services/` for delete, move, restore, and
commit. For putting text into a file, use `memar content write` and
`memar content edit`."""


class Verbs:
    """Where one level's verbs go: argparse's sub-parser registration, made on first use.

    A level whose services register nothing gets no verb group, so a domain verb
    that runs itself never asks for a sub-verb it has none of.
    """

    def __init__(self, parser: argparse.ArgumentParser, depth: int) -> None:
        self.parser = parser
        self.depth = depth
        self.group: argparse._SubParsersAction | None = None

    def add_parser(self, name: str, **kwargs) -> argparse.ArgumentParser:
        if self.group is None:
            self.group = self.parser.add_subparsers(
                title="verbs",
                dest=f"_memar_verb_{self.depth}",
                metavar=VERB_METAVAR,
                required=True,
            )
        kwargs.setdefault("formatter_class", argparse.RawDescriptionHelpFormatter)
        return self.group.add_parser(name, **kwargs)

    def registered(self) -> dict[str, argparse.ArgumentParser]:
        return dict(self.group.choices) if self.group is not None else {}


@functools.lru_cache(maxsize=None)
def catalog(top: Path = TOP) -> dict[str, str]:
    """Each name the router works with, and the dotted address its file is imported by.

    A folder that holds a file of its own name has a command line: that file is the domain, and each file in
    its `services/` folder is one of the domain's capabilities, unless another domain's name begins it. A
    folder without a file of its own name, an optional capability added to a domain kept elsewhere,
    offers only the files in its `services/` folder that a domain's name begins.
    """
    found: dict[str, str] = {}
    shelved: list[tuple[str | None, str, str]] = []
    domains: set[str] = set()
    for root, base in SEARCHED_ROOTS:
        for folder, dirs, files in os.walk(top / root):
            dirs[:] = sorted(name for name in dirs if name not in NOT_MODULES)
            leaf = Path(folder).name
            shelf = Path(folder) / SERVICES
            own = f"{leaf}.py" in files
            if not own and not shelf.is_dir():
                continue
            package = ".".join(Path(folder).relative_to(top / base).parts)
            if own:
                if leaf in found:
                    raise SystemExit(f"memar: more than one folder is named {leaf}: {found[leaf]} and {folder}")
                found[leaf] = f"{package}.{leaf}"
                domains.add(leaf)
            for path in sorted(shelf.glob("*.py")):
                if not path.stem.startswith("_"):
                    shelved.append((leaf if own else None, path.stem, f"{package}.{SERVICES}.{path.stem}"))
    # A capability file named by another domain first is that domain's, wherever it is kept.
    for leaf, stem, address in shelved:
        owner = next((each for each in domains if each != leaf and stem.startswith(each + DOMAIN_SEPARATOR)), None)
        if owner:
            found[stem] = address
        elif leaf is not None:
            found[f"{leaf}{DOMAIN_SEPARATOR}{stem}"] = address
    return found


def services(top: Path = TOP) -> list[str]:
    """The names of the files that may declare verbs, each domain's own before its capabilities."""
    return sorted(catalog(top), key=lambda name: (DOMAIN_SEPARATOR in name, name))


def import_path(name: str, names: dict[str, str] | None = None) -> str:
    """What a name from `services` is imported by."""
    # With the same argument `services` gives, so the two calls share one cache entry and the checkout is walked once.
    return (catalog(TOP) if names is None else names)[name]


def assemble(
    names: Iterable[str],
    load: Callable[[str], object] = lambda name: importlib.import_module(import_path(name)),
) -> tuple[argparse.ArgumentParser, list[Callable[[list[str]], None]]]:
    """The command line the services declare, and what asks to run before every verb.

    Pure apart from importing: no service does any work while describing itself.
    A service that fails to import is named on stderr and left out, so one broken
    service costs its own verbs, never `memar --help` or the verb that repairs it.
    """
    top = argparse.ArgumentParser(
        prog="memar",
        description=ABOUT,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    root = Verbs(top, 0)
    levels: dict[str, Verbs] = {}
    before: list[Callable[[list[str]], None]] = []
    for name in names:
        try:
            loaded = load(name)
        except Exception as failed:
            print(
                f"memar: {name} did not load, so its verbs are missing: "
                f"{type(failed).__name__}: {failed}",
                file=sys.stderr,
            )
            continue
        describe = getattr(loaded, DESCRIBE, None)
        if describe is None:
            continue
        domain, separator, _ = name.partition(DOMAIN_SEPARATOR)
        verbs = levels.get(domain) if separator else root
        if verbs is None:
            continue
        known = verbs.registered()
        run = describe(verbs)
        added = {key: parser for key, parser in verbs.registered().items() if key not in known}
        if not added:
            if run is not None:
                before.append(run)
            continue
        for parser in {id(parser): parser for parser in added.values()}.values():
            if run is not None:
                parser.set_defaults(**{f"{RUN_PREFIX}{verbs.depth}": run})
            if not separator:
                levels[domain] = Verbs(parser, verbs.depth + 1)
    return top, before


def runs(parsed: argparse.Namespace) -> list[Callable[[argparse.Namespace], int | None]]:
    """The runs the parsed verbs declared, outermost first."""
    found = {
        int(key[len(RUN_PREFIX):]): value
        for key, value in vars(parsed).items()
        if key.startswith(RUN_PREFIX)
    }
    return [found[depth] for depth in sorted(found)]


def main(argv: list[str] | None = None) -> int:
    use_utf8_stdio()
    args = list(sys.argv[1:] if argv is None else argv)
    top, before = assemble(services())
    for step in before:
        step(args)
    if args[:1] and args[0] in HELP_WORDS:
        args = ["--help", *args[1:]]
    parsed = top.parse_args(args)
    for run in runs(parsed):
        status = run(parsed)
        if status:
            return status
    return 0


def command() -> int:
    """The call as typed: answered by the process that stays when it is switched on and answers, else done in this process."""
    from machine.resident import served

    status = served(sys.argv[1:], TOP)
    return main() if status is None else status


if __name__ == "__main__":
    raise SystemExit(command())
