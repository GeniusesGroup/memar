tp Observer_HTTP_Method in "modules/lib/net/http/protocol/method.observers.kh"
tp Observer_HTTP_Status in "modules/lib/net/http/protocol/status.observers.kh"
tp Observer_Version in "modules/lib/net/http/protocol/version.observers.kh"
tp Mutator_Status in "modules/lib/net/http/protocol/status.mutators.kh"
tp Observer_Host in "modules/net/uri/protocol/host.observers.kh"
tp Observer_URI_Path in "modules/net/uri/protocol/path.observers.kh"
tp Observer_Port in "modules/net/uri/protocol/port.observers.kh"
tp Observer_Query in "modules/net/uri/protocol/query.observers.kh"
tp Observer_Scheme in "modules/net/uri/protocol/scheme.observers.kh"

// PseudoHeader_Request indicate request pseudo header.
// "message start-line" in HTTP/1.x or "pseudo-header fields" in HTTP/2.x||HTTP/3.x
// STR MUST just include ASCII characters.
tp PseudoHeader_Request ab {
    Observer_HTTP_Method
// https://datatracker.ietf.org/doc/html/rfc2616#section-3.2
// http_URL = "http:" "//" host [ ":" port ] [ abs_path [ "?" query ]]
// URI() URI
    Observer_Scheme
    Observer_Host
    Observer_Port
    Observer_URI_Path
    Observer_Query
    Observer_Version
}

// PseudoHeader_Response indicate response pseudo header.
// "message start-line" in HTTP/1.x or "pseudo-header fields" in HTTP/2.x||HTTP/3.x
// STR MUST just include ASCII characters.
tp PseudoHeader_Response ab {
    Observer_Version
    Observer_HTTP_Status
    Mutator_Status
}

