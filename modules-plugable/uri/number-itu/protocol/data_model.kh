tp Field_Number in "modules-plugable/uri/number-itu/protocol/dt-number.kh"
tp Observer_Organization_Identifier in "modules/identity/organization/protocol/identifier.observers.kh"
tp Observer_User_Identifier in "modules/identity/user/protocol/identifier.observers.kh"
tp Observer_Request_Identifier in "modules/process/request/protocol/identifier.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"
tp User_Identifier in "modules/identity/user/protocol/identifier.kh"

tp Field_ProviderID ab

tp ProviderID mt (self Field_ProviderID) () (u User_Identifier)

tp NumberDataModel ab {
	Observer_User_Identifier
	Observer_Organization_Identifier
	Field_ProviderID
	Field_Number
	Observer_Request_Identifier
	Observer_Time_Request
}

