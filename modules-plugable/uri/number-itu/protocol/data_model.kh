tp Field_Number in "modules-plugable/uri/number-itu/protocol/dt-number.kh"
tp Field_OrganizationUUID in "modules/identity/organization/protocol/dt-uuid.kh"
tp Field_UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp Observer_RequestID in "memar/modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "memar/modules/process/time/protocol/request.observers.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"

tp Field_ProviderID ab

tp ProviderID mt (self Field_ProviderID) () (u UserUUID)

tp NumberDataModel ab {
	Field_UserUUID
	Field_OrganizationUUID
	Field_ProviderID
	Field_Number
	Observer_RequestID
	Observer_Time_Request
}

