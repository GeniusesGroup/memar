tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Field_Number in "modules-plugable/uri/number-itu/protocol/dt-number.kh"
tp Field_OrganizationUUID in "modules/identity/organization/protocol/dt-uuid.kh"
tp Field_UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp Number in "modules-plugable/uri/number-itu/protocol/dt-number.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"

tp BS_Register_Request ab {
	Field_OrganizationUUID
	Field_Number
}

tp BS_Count_Request ab {
	Field_UserUUID
	Field_OrganizationUUID
}

tp BS_Get_Request ab {
	Field_UserUUID
	Field_OrganizationUUID
}

tp Field_VerificationToken ab

tp Token mt (self Field_VerificationToken) () (t String)

tp BS_SendVerification_Request ab {
	Field_Number
}

tp BS_Verify_Request ab {
	Field_Number
	Field_VerificationToken
}

tp BS_IsVerified_Request ab {
	Field_Number
}

tp BS_IsVerified_Response ab

tp Verified mt (self BS_IsVerified_Response) () (b Boolean)

tp BS_IsExist_Request ab {
	Field_Number
}

tp BS_IsExist_Response ab

tp Exist mt (self BS_IsExist_Response) () (b Boolean)

