tp Observer_ITU_VerificationToken in "modules-plugable/uri/number-itu/protocol/itu-verification-token.observers.kh"

tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Observer_Number in "modules-plugable/uri/number-itu/protocol/number.observers.kh"
tp Observer_Organization_Identifier in "modules/identity/organization/protocol/identifier.observers.kh"
tp Observer_User_Identifier in "modules/identity/user/protocol/identifier.observers.kh"



tp BS_Register_Request ab {
	Observer_Organization_Identifier
	Observer_Number
}

tp BS_Count_Request ab {
	Observer_User_Identifier
	Observer_Organization_Identifier
}

tp BS_Get_Request ab {
	Observer_User_Identifier
	Observer_Organization_Identifier
}


tp BS_SendVerification_Request ab {
	Observer_Number
}

tp BS_Verify_Request ab {
	Observer_Number
	Observer_ITU_VerificationToken
}

tp BS_IsVerified_Request ab {
	Observer_Number
}

tp BS_IsVerified_Response ab

tp Verified mt (self BS_IsVerified_Response) () (b Boolean)

tp BS_IsExist_Request ab {
	Observer_Number
}

tp BS_IsExist_Response ab

tp Exist mt (self BS_IsExist_Response) () (b Boolean)
