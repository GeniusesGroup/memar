tp Array_ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Number in "modules-plugable/uri/number-itu/protocol/dt-number.kh"
tp NumberDataModel in "modules-plugable/uri/number-itu/protocol/data_model.kh"
tp NumberOfVersion in "modules/computer/memory/protocol/version.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/protocol/version.kh"

tp NumberStorage ab

tp Save mt (self NumberStorage) (dm NumberDataModel) (n NumberOfVersion, e Error)

tp Count mt (self NumberStorage) (userID UserUUID, orgID UserUUID) (n NumberOfVersion, e Error)

tp Get mt (self NumberStorage) (userID UserUUID, orgID UserUUID, vo VersionOffset) (dm NumberDataModel, n NumberOfVersion, e Error)

tp FindByNumber mt (self NumberStorage) (number Number, offset Container_Offset, limit Container_Limit) (userIDs Array_ThingUUID, n NumberOfVersion, e Error)

