tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Title_Find in "modules-plugable/uri/title/services/find-title/protocol/find-title.kh"

tp Domain mt (self Title_Find) () (s String) {
    CharacterRun_From.FromCharacterRun("Title")(s, VoidError)
}

tp Summary mt (self Title_Find) () (s String) {
    CharacterRun_From.FromCharacterRun("Finds the title of a thing")(s, VoidError)
}

tp Overview mt (self Title_Find) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the text named for the thing, in one read of the text domain's place, and returns it as the title, or that it has none; a thing without a title is not an error.")(s, VoidError)
}

tp UserActionNote mt (self Title_Find) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Title_Find) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
