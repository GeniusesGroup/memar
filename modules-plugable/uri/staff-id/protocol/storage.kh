tp Error in "memar/modules/process/error/protocol/error.kh"
tp NumberOfVersion in "memar/modules/computer/memory/protocol/version.kh"
tp StaffIDDataModel in "modules-plugable/uri/staff-id/protocol/data_model.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "memar/modules/computer/memory/protocol/version.kh"

tp StaffIDStorage ab

tp Save mt (self StaffIDStorage) (dm StaffIDDataModel) (n NumberOfVersion, e Error)

tp Count mt (self StaffIDStorage) (staffID UserUUID) (n NumberOfVersion, e Error)

tp Get mt (self StaffIDStorage) (staffID UserUUID, vo VersionOffset) (dm StaffIDDataModel, n NumberOfVersion, e Error)

