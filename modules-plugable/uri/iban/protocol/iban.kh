tp String in "memar/modules/computer/codec/string/protocol/string.kh"
tp U8 in "memar/modules/math/integer/unsigned-8.kh"

tp IBAN ab

tp GetIBAN mt (self IBAN) () (s String)

tp CountryCode mt (self IBAN) () (c String)

tp CheckDigits mt (self IBAN) () (d U8)

tp BBAN mt (self IBAN) () (b String)

