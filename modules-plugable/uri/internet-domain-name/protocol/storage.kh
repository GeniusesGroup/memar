tp Array_DomainName in "modules-plugable/uri/internet-domain-name/protocol/dt-name.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp DomainName in "modules-plugable/uri/internet-domain-name/protocol/dt-name.kh"
tp DomainNameDataModel in "modules-plugable/uri/internet-domain-name/protocol/data_model.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp DomainNameStorage ab

tp Save mt (self DomainNameStorage) (dm DomainNameDataModel) (n NumberOfVersion, e Error)

tp Count mt (self DomainNameStorage) (n DomainName) (nv NumberOfVersion, e Error)

tp Get mt (self DomainNameStorage) (n DomainName, vo VersionOffset) (dm DomainNameDataModel, nv NumberOfVersion, e Error)

tp FindByUserID mt (self DomainNameStorage) (userID UserUUID, offset Container_Offset, limit Container_Limit) (domains Array_DomainName, nv NumberOfVersion, e Error)

