tp Array_DomainName in "modules-plugable/uri/internet-domain-name/protocol/dt-name.kh"
tp Field_DomainName in "modules-plugable/uri/internet-domain-name/protocol/dt-name.kh"
tp Field_DomainStatus in "modules-plugable/uri/internet-domain-name/protocol/dt-status.kh"
tp Field_UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp NumberOfElement in "memar/modules/computer/adt/container/protocol/length.kh"
tp Pagination_Offset_Request in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Pagination_Response in "memar/modules/computer/adt/container/protocol/pagination.kh"

tp BS_Register_Request ab {
	Field_DomainName
	Field_UserUUID
}

tp BS_Count_Request ab {
	Field_DomainName
}

tp BS_Count_Response ab

tp Numbers mt (self BS_Count_Response) () (n NumberOfElement)

tp BS_Get_Request ab {
	Field_DomainName
}

tp BS_FindByUserID_Request ab {
	Field_UserUUID
	Pagination_Offset_Request
}

tp BS_FindByUserID_Response ab {
	Pagination_Response
}

tp Domains mt (self BS_FindByUserID_Response) () (d Array_DomainName)

tp BS_ChangeStatus_Request ab {
	Field_DomainName
	Field_DomainStatus
}

