tp Observer_Account_Identifier in "modules/economics/account/protocol/identifier.observers.kh"
tp Observer_CVC in "modules-plugable/uri/iso-7812/protocol/cvc.observers.kh"
tp Observer_CardNumber in "modules-plugable/uri/iso-7812/protocol/card-number.observers.kh"
tp Observer_ExpireDate in "modules-plugable/uri/iso-7812/protocol/expire-date.observers.kh"
tp BS_Register_Request ab {
	Observer_Account_Identifier
	Observer_CardNumber
	Observer_ExpireDate
	Observer_CVC
}

tp BS_Get_Request ab {
	Observer_Account_Identifier
}

