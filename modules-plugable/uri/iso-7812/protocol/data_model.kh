tp Card in "modules-plugable/uri/iso-7812/protocol/card.kh"
tp Field_CardID in "modules-plugable/uri/iso-7812/protocol/dt-uuid.kh"
tp Observer_RequestID in "memar/modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "memar/modules/process/time/protocol/request.observers.kh"

tp Field_CardNumber ab

tp CardNumber mt (self Field_CardNumber) () (c Card)

tp CardDataModel ab {
	Field_CardID
	Field_CardNumber
	Observer_RequestID
	Observer_Time_Request
}

