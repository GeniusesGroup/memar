tp Card in "modules-plugable/uri/iso-7812/protocol/card.kh"
tp Observer_Card_Identifier in "modules-plugable/uri/iso-7812/protocol/identifier.observers.kh"
tp Observer_Request_Identifier in "modules/process/request/protocol/identifier.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"

tp Field_CardNumber ab

tp CardNumber mt (self Field_CardNumber) () (c Card)

tp CardDataModel ab {
	Observer_Card_Identifier
	Field_CardNumber
	Observer_Request_Identifier
	Observer_Time_Request
}

