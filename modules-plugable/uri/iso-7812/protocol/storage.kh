tp Array_ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp Card in "modules-plugable/uri/iso-7812/protocol/card.kh"
tp CardDataModel in "modules-plugable/uri/iso-7812/protocol/data_model.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp CardStorage ab

tp Save mt (self CardStorage) (dm CardDataModel) (n NumberOfVersion, e Error)

tp Count mt (self CardStorage) (financialCardID ThingUUID) (n NumberOfVersion, e Error)

tp Get mt (self CardStorage) (financialCardID ThingUUID, vo VersionOffset) (dm CardDataModel, n NumberOfVersion, e Error)

tp FIND_FinancialCardIDs_BY_UserID mt (self CardStorage) (userID UserUUID, offset Container_Offset, limit Container_Limit) (financialCardIDs Array_ThingUUID, n NumberOfVersion, e Error)

tp FIND_FinancialCardIDs_BY_CardNumber mt (self CardStorage) (cardNumber Card) (financialCardIDs Array_ThingUUID, e Error)

