tp Field_UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp Observer_RequestID in "memar/modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "memar/modules/process/time/protocol/request.observers.kh"
tp ShortID in "modules-plugable/uri/uri-shortener/protocol/dt-id.kh"
tp String in "memar/modules/computer/codec/string/protocol/string.kh"

tp Field_ShortID ab

tp GetShortID mt (self Field_ShortID) () (i ShortID)

tp Field_URI ab

tp URI mt (self Field_URI) () (u String)

tp ShortenerDataModel ab {
	Field_ShortID
	Field_URI
	Field_UserUUID
	Observer_RequestID
	Observer_Time_Request
}

