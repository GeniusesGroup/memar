tp Observer_Username_VerificationToken in "modules-plugable/uri/username/ui/protocol/username-verification-token.observers.kh"

tp Observer_ProtocolType in "modules-plugable/uri/username/ui/protocol/protocol-type.observers.kh"

tp Array_MemoryAddress in "modules/computer/memory/address/protocol/address.kh"
tp Observer_Organization_Identifier in "modules/identity/organization/protocol/identifier.observers.kh"
tp Observer_User_Identifier in "modules/identity/user/protocol/identifier.observers.kh"
tp Observer_Username in "modules-plugable/uri/username/ui/protocol/username.observers.kh"
tp Pagination_Offset_Request in "modules/computer/adt/container/protocol/pagination.kh"
tp Pagination_Response in "modules/computer/adt/container/protocol/pagination.kh"

tp BS_Register_Request ab {
	Observer_User_Identifier
	Observer_Username
}

tp BS_Count_Request ab {
	Observer_User_Identifier
}

tp BS_Get_Request ab {
	Observer_User_Identifier
}

tp BS_FindByUsername_Request ab {
	Observer_Username
	Pagination_Offset_Request
}

tp BS_FindByUsername_Response ab {
	Pagination_Response
}

tp UserIDs mt (self BS_FindByUsername_Response) () (u Array_MemoryAddress)


tp BS_SendManualVerification_Request ab {
	Observer_User_Identifier
	Observer_Organization_Identifier
	Observer_Username
	Observer_ProtocolType
}


tp BS_VerifyManually_Request ab {
	Observer_User_Identifier
	Observer_Organization_Identifier
	Observer_Username
