tp Array_ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Field_Username in "modules-plugable/uri/username/widget/protocol/dt-username.kh"
tp NumberOfVersion in "modules/computer/memory/protocol/version.kh"
tp Username in "modules-plugable/uri/username/widget/protocol/dt-username.kh"
tp UsernameDataModel in "modules-plugable/uri/username/widget/protocol/data_model.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/protocol/version.kh"

tp UsernameStorage ab

tp Save mt (self UsernameStorage) (dm UsernameDataModel) (n NumberOfVersion, e Error)

tp Count mt (self UsernameStorage) (userID UserUUID, orgID UserUUID) (n NumberOfVersion, e Error)

tp Get mt (self UsernameStorage) (userID UserUUID, orgID UserUUID, vo VersionOffset) (dm UsernameDataModel, n NumberOfVersion, e Error)

tp FindByUsername mt (self UsernameStorage) (username Username, offset Container_Offset, limit Container_Limit) (userIDs Array_ThingUUID, n NumberOfVersion, e Error)

tp ListOrgs mt (self UsernameStorage) (userID UserUUID, offset Container_Offset, limit Container_Limit) (orgIDs Array_ThingUUID, n NumberOfVersion, e Error)

