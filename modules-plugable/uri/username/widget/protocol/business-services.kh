tp Array_ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp Field_OrganizationUUID in "modules/identity/organization/protocol/dt-uuid.kh"
tp Field_UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp Field_Username in "modules-plugable/uri/username/widget/protocol/dt-username.kh"
tp Pagination_Offset_Request in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Pagination_Response in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp String in "memar/modules/computer/codec/string/protocol/string.kh"

tp BS_Register_Request ab {
	Field_UserUUID
	Field_Username
}

tp BS_Count_Request ab {
	Field_UserUUID
}

tp BS_Get_Request ab {
	Field_UserUUID
}

tp BS_FindByUsername_Request ab {
	Field_Username
	Pagination_Offset_Request
}

tp BS_FindByUsername_Response ab {
	Pagination_Response
}

tp UserIDs mt (self BS_FindByUsername_Response) () (u Array_ThingUUID)

tp Field_ProtocolType ab

tp ProtocolType mt (self Field_ProtocolType) () (p String)

tp BS_SendManualVerification_Request ab {
	Field_UserUUID
	Field_OrganizationUUID
	Field_Username
	Field_ProtocolType
}

tp Field_VerificationToken ab

tp Token mt (self Field_VerificationToken) () (t String)

tp BS_VerifyManually_Request ab {
	Field_UserUUID
	Field_OrganizationUUID
	Field_Username
	Field_VerificationToken
}

tp BS_ChangeStatus_Request ab {
	Field_Username
}

