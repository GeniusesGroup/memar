tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Stringer code the data to/from human readable format. It can be any other format like JSON(not recommended).
tp Codec_Stringer ab {
    Codec_Stringer_To
    Codec_Stringer_From
}

tp Codec_Stringer_To ab
tp ToString mt (self Codec_Stringer_To) () (str String, err Error)

tp Codec_Stringer_From ab
tp FromString mt (self Codec_Stringer_From) (str String) (err Error)
