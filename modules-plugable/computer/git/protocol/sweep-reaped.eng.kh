tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Sweep_Reaped in "modules-plugable/computer/git/protocol/sweep-reaped.kh"

tp Domain mt (self Sweep_Reaped) () (s String) {
    CharacterRun_From.FromCharacterRun("Git")(s, VoidError)
}

tp Summary mt (self Sweep_Reaped) () (s String) {
    CharacterRun_From.FromCharacterRun("The folders one sweep moved")(s, VoidError)
}

tp Overview mt (self Sweep_Reaped) () (s String) {
    CharacterRun_From.FromCharacterRun("Each folder the sweep moved to the recycle bin, in the order it moved them, with how long it had been idle.")(s, VoidError)
}

tp UserActionNote mt (self Sweep_Reaped) () (s String) {
    CharacterRun_From.FromCharacterRun("Nothing to do.")(s, VoidError)
}

tp DevActionNote mt (self Sweep_Reaped) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
