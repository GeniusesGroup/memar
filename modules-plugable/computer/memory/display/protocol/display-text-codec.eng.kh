tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Display_Text_Codec in "modules-plugable/computer/memory/display/protocol/display-text-codec.kh"

tp Domain mt (self Display_Text_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Display Text Codec")(s, VoidError)
}

tp Summary mt (self Display_Text_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Packs typed Graph or store answers into text bytes for eyes")(s, VoidError)
}

tp Overview mt (self Display_Text_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Packs typed Graph or store answers into text bytes for eyes. Organization choice of form (JSON, YAML, …). Not a storage body codec and not a graph layout codec.")(s, VoidError)
}

tp UserActionNote mt (self Display_Text_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Display_Text_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("PackSides, PackSide, PackGetSide and PackParts. Opaque buffers become encoding tokens. Refuse dump-wrapper shapes.")(s, VoidError)
}
