    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_HeldRange) () (s String) {
    CharacterRun_From.FromCharacterRun("A range of addresses a store decides alone")(s, VoidError)
}

tp Overview mt (self GitStore_HeldRange) () (s String) {
    CharacterRun_From.FromCharacterRun("A range of addresses a store decides alone.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_HeldRange) () (s String) {
