}

tp Summary mt (self GitStore_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("What the module offers so that a class can be bound to the git store")(s, VoidError)
}

tp Overview mt (self GitStore_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("What the module offers so that a class can be bound to the git store.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_Binder) () (s String) {
