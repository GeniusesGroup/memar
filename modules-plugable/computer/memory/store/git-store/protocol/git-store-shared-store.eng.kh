tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp GitStore_SharedStore in "modules-plugable/computer/memory/store/git-store/protocol/git-store-shared-store.kh"

tp Domain mt (self GitStore_SharedStore) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_SharedStore) () (s String) {
    CharacterRun_From.FromCharacterRun("The git remote every committed batch of a class is published to")(s, VoidError)
}

tp Overview mt (self GitStore_SharedStore) () (s String) {
    CharacterRun_From.FromCharacterRun("The git remote every committed batch of a class is published to.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_SharedStore) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self GitStore_SharedStore) () (s String) {
    CharacterRun_From.FromCharacterRun("A remote name or a URL. The adapter takes no default, not even the origin of the project, so that no store is pushed to a host nobody named; a class without one is not replicated.")(s, VoidError)
}
