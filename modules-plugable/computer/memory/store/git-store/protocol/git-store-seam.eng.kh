tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp GitStore_Seam in "modules-plugable/computer/memory/store/git-store/protocol/git-store-seam.kh"

tp Domain mt (self GitStore_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("What the adapter exposes for the groups it owes")(s, VoidError)
}

tp Overview mt (self GitStore_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("What the adapter exposes for the groups it owes.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self GitStore_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("FallBack makes the handles opened after it ask the given fallback, or the adapter own when none is given, for what lies outside the held ranges. GetWorkingTree is the working tree of the repository, not given for a bare one. SharedReachable says whether the shared store can be reached from now on. GetSharedState is the state of the class at the shared store as State answers it, not given when it holds none. Sibling is a new, empty adapter on another machine store of the same class and shared store.")(s, VoidError)
}
