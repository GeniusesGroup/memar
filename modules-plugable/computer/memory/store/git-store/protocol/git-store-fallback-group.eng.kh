tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp GitStore_FallbackGroup in "modules-plugable/computer/memory/store/git-store/protocol/git-store-fallback-group.kh"

tp Domain mt (self GitStore_FallbackGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_FallbackGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group fallback")(s, VoidError)
}

tp Overview mt (self GitStore_FallbackGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group fallback.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_FallbackGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self GitStore_FallbackGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Owed by this module, which declares the capability, and coded with it: unavailable is not absent, list unavailable is not short, held only updates, fallback not found and fallback found. Applies to a store that declares fallback.")(s, VoidError)
}
