tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp GitStore_WorkingTreeGroup in "modules-plugable/computer/memory/store/git-store/protocol/git-store-working-tree-group.kh"

tp Domain mt (self GitStore_WorkingTreeGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_WorkingTreeGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group working tree")(s, VoidError)
}

tp Overview mt (self GitStore_WorkingTreeGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group working tree.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_WorkingTreeGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self GitStore_WorkingTreeGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Owed by this module: after any sequence of the operations a listing of the working tree of the project, its tracked files and its index are as they were. Applies to a store that declares it leaves the working tree untouched.")(s, VoidError)
}
