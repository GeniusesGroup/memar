tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp GitStore_Capabilities in "modules-plugable/computer/memory/store/git-store/protocol/git-store-capabilities.kh"

tp Domain mt (self GitStore_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Git Store")(s, VoidError)
}

tp Summary mt (self GitStore_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("What the git store declares of what it is")(s, VoidError)
}

tp Overview mt (self GitStore_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("What the git store declares of what it is.")(s, VoidError)
}

tp UserActionNote mt (self GitStore_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self GitStore_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("A sparse store of addresses and values of any length that can compare and write; atomic batch, durable, shared between the processes of one machine, fallback and leaves the working tree untouched; and replicated when, and only when, the class names a shared store. It is not lockable: the expectation is the control of writers.")(s, VoidError)
}
