tp Record_Identifier in "modules-plugable/computer/memory/store/record/protocol/identifier.kh"
tp Record_ID in "modules-plugable/computer/memory/store/record/protocol/record-id.kh"
tp Record_DomainKey in "modules-plugable/computer/memory/store/record/protocol/record-domain-key.kh"

tp Record_Key ab {
    Record_Identifier
}

tp GetID mt (self Record_Key) () (id Record_ID)

tp GetDomainKey mt (self Record_Key) () (domainKey Record_DomainKey)

tp Of mt (self Record_Key) (id Record_ID, domainKey Record_DomainKey) (key Record_Key)
