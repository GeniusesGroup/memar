tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Unmet in "modules-plugable/computer/memory/store/record/protocol/record-unmet.kh"

tp Domain mt (self Record_Unmet) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Unmet) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter declares less of than a class needs")(s, VoidError)
}

tp Overview mt (self Record_Unmet) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter declares less of than a class needs.")(s, VoidError)
}

tp UserActionNote mt (self Record_Unmet) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Unmet) () (s String) {
    CharacterRun_From.FromCharacterRun("One reason for each missing capability or limit, each said for a reader; empty when the needs are met.")(s, VoidError)
}
