tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_NodesAnswer in "modules-plugable/computer/memory/store/record/protocol/record-nodes-answer.kh"

tp Domain mt (self Record_NodesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_NodesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("What nodes and scan answer")(s, VoidError)
}

tp Overview mt (self Record_NodesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("What nodes and scan answer.")(s, VoidError)
}

tp UserActionNote mt (self Record_NodesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_NodesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The ids of the page, or Unavailable when the adapter cannot answer the whole range, or Refused as a whole.")(s, VoidError)
}
