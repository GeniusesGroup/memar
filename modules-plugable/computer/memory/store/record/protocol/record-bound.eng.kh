tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Bound in "modules-plugable/computer/memory/store/record/protocol/record-bound.kh"

tp Domain mt (self Record_Bound) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Bound) () (s String) {
    CharacterRun_From.FromCharacterRun("An adapter bound to a class: it opens the store the class is kept in and names that store")(s, VoidError)
}

tp Overview mt (self Record_Bound) () (s String) {
    CharacterRun_From.FromCharacterRun("An adapter bound to a class: it opens the store the class is kept in and names that store.")(s, VoidError)
}

tp UserActionNote mt (self Record_Bound) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Bound) () (s String) {
    CharacterRun_From.FromCharacterRun("Two classes bound to one store are told by SameStore and opening them is refused, because two adapters never write one store and a node class decides its store.")(s, VoidError)
}
