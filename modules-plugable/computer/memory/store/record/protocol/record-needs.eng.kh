tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Needs in "modules-plugable/computer/memory/store/record/protocol/record-needs.kh"

tp Domain mt (self Record_Needs) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Needs) () (s String) {
    CharacterRun_From.FromCharacterRun("What a class needs of the adapter it is opened on")(s, VoidError)
}

tp Overview mt (self Record_Needs) () (s String) {
    CharacterRun_From.FromCharacterRun("What a class needs of the adapter it is opened on.")(s, VoidError)
}

tp UserActionNote mt (self Record_Needs) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Needs) () (s String) {
    CharacterRun_From.FromCharacterRun("The capabilities, and the least limits it uses where a limit is given. A class that records state changes needs atomic batch. Opening a class on an adapter that declares less is refused.")(s, VoidError)
}
