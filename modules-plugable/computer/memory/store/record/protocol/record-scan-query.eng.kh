tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_ScanQuery in "modules-plugable/computer/memory/store/record/protocol/record-scan-query.kh"

tp Domain mt (self Record_ScanQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_ScanQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("A query of node ids that carry every label of a set")(s, VoidError)
}

tp Overview mt (self Record_ScanQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("A query of node ids that carry every label of a set.")(s, VoidError)
}

tp UserActionNote mt (self Record_ScanQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_ScanQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("The set holds at least one label; paging by after visits every id that matches throughout the paging exactly once and any other id at most once, even while other nodes are written.")(s, VoidError)
}
