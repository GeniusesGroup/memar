tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_NodesQuery in "modules-plugable/computer/memory/store/record/protocol/record-nodes-query.kh"

tp Domain mt (self Record_NodesQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_NodesQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("The range of existence instants, the page and the direction a listing of node ids asks")(s, VoidError)
}

tp Overview mt (self Record_NodesQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("The range of existence instants, the page and the direction a listing of node ids asks.")(s, VoidError)
}

tp UserActionNote mt (self Record_NodesQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_NodesQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("From and to are whole milliseconds of six bytes bounding the half open range from to to; after bounds from below when ascending and from above when descending; a limit is at least one. A page shorter than the limit is the end of the range, and no adapter returns a short page for another reason.")(s, VoidError)
}
