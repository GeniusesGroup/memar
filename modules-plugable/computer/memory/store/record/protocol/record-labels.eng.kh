tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Labels in "modules-plugable/computer/memory/store/record/protocol/record-labels.kh"

tp Domain mt (self Record_Labels) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Labels) () (s String) {
    CharacterRun_From.FromCharacterRun("The ids attached to a node")(s, VoidError)
}

tp Overview mt (self Record_Labels) () (s String) {
    CharacterRun_From.FromCharacterRun("The ids attached to a node.")(s, VoidError)
}

tp UserActionNote mt (self Record_Labels) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Labels) () (s String) {
    CharacterRun_From.FromCharacterRun("Held by the part under the domain key labels as the concatenation of the ids, ascending and without repetition; a write of that part in any other form is refused. The record treats a label as an id and gives it no meaning.")(s, VoidError)
}
