tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Key in "modules-plugable/computer/memory/store/record/protocol/record-key.kh"

tp Domain mt (self Record_Key) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Key) () (s String) {
    CharacterRun_From.FromCharacterRun("The address of a part: the id of its node, then the domain key")(s, VoidError)
}

tp Overview mt (self Record_Key) () (s String) {
    CharacterRun_From.FromCharacterRun("The address of a part: the id of its node, then the domain key.")(s, VoidError)
}

tp UserActionNote mt (self Record_Key) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Key) () (s String) {
    CharacterRun_From.FromCharacterRun("The 16 bytes of the id then the ASCII bytes of the domain key, with no separator, so the keys of one node are adjacent in byte order. Bytes that are not an id followed by one to 64 bytes of a domain key are not a key.")(s, VoidError)
}
