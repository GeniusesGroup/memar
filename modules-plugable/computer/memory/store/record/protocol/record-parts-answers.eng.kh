tp Record_PartsAnswers in "modules-plugable/computer/memory/store/record/protocol/record-parts-answers.kh"

tp Domain mt (self Record_PartsAnswers) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_PartsAnswers) () (s String) {
    CharacterRun_From.FromCharacterRun("One answer of parts for each id given, in the order given")(s, VoidError)
}

tp Overview mt (self Record_PartsAnswers) () (s String) {
    CharacterRun_From.FromCharacterRun("One answer of parts for each id given, in the order given.")(s, VoidError)
}

tp UserActionNote mt (self Record_PartsAnswers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_PartsAnswers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
