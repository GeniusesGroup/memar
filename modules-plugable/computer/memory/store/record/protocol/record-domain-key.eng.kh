tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_DomainKey in "modules-plugable/computer/memory/store/record/protocol/record-domain-key.kh"

tp Domain mt (self Record_DomainKey) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_DomainKey) () (s String) {
    CharacterRun_From.FromCharacterRun("The name under which a domain keeps its part on a node")(s, VoidError)
}

tp Overview mt (self Record_DomainKey) () (s String) {
    CharacterRun_From.FromCharacterRun("The name under which a domain keeps its part on a node.")(s, VoidError)
}

tp UserActionNote mt (self Record_DomainKey) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_DomainKey) () (s String) {
    CharacterRun_From.FromCharacterRun("Lowercase letters and digits in groups joined by single hyphens, at most 64 characters, compared by equality alone. The name labels is reserved to the record and holds the labels of a node.")(s, VoidError)
}
