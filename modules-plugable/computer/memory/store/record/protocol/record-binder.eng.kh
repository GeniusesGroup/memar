tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Binder in "modules-plugable/computer/memory/store/record/protocol/record-binder.kh"

tp Domain mt (self Record_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter module offers so that a class can be bound to it")(s, VoidError)
}

tp Overview mt (self Record_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter module offers so that a class can be bound to it.")(s, VoidError)
}

tp UserActionNote mt (self Record_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Bind answers the adapter that serves the class from the keys of the memar block of the manifest that the adapter declares itself, and does no work on the medium. The adapter is named by its capability, which is the name of its module.")(s, VoidError)
}
