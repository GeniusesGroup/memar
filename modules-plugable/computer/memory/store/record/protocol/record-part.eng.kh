tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Record_Part in "modules-plugable/computer/memory/store/record/protocol/record-part.kh"

tp Domain mt (self Record_Part) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Record")(s, VoidError)
}

tp Summary mt (self Record_Part) () (s String) {
    CharacterRun_From.FromCharacterRun("A domain key of a node with the token of its value")(s, VoidError)
}

tp Overview mt (self Record_Part) () (s String) {
    CharacterRun_From.FromCharacterRun("A domain key of a node with the token of its value.")(s, VoidError)
}

tp UserActionNote mt (self Record_Part) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Record_Part) () (s String) {
    CharacterRun_From.FromCharacterRun("The value is a byte string of any length, an empty one differing from an absent one, and its encoding is the domain's and canonical, because the token is taken over the bytes.")(s, VoidError)
}
