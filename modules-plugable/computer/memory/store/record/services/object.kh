package object

import (
	"io"

	"golang.org/x/crypto/sha3"

	error_p "memar/process/error/protocol"
	"memar/protocol"
	"memar/syllab"
	"memar/time/unix"
)

// Object has needed methods to implements protocol.Object interface!
type Object []byte

func (ob Object) Metadata() protocol.ObjectMetadata { return Metadata(ob) }
func (ob Object) Data() protocol.Codec              { return ob[MetadataLength:] }

func NewObject(data protocol.Codec) (ob Object, md Metadata) {
	ob = make([]byte, MetadataLength, int(MetadataLength)+data.Len())
	md = Metadata(ob)
	md.setWriteTime(unix.Now())
	md.setMediaTypeID(data.MediaType().ID())
	md.setCompressTypeID(data.CompressType().URN().ID())
	md.setDataLength(data.Len())

	ob = data.MarshalTo(ob[MetadataLength:])
	var objectID = sha3.Sum256(ob[32:])
	md.setID(objectID)
	return
}

//memar:impl /memar/protocol.Codec
func (ob Object) MediaType() protocol.MediaType {
	return protocol.OS.GetMediaTypeByID(ob.Metadata().MediaTypeID())
}
func (ob Object) CompressType() protocol.CompressType {
	return protocol.OS.GetCompressTypeByID(ob.Metadata().CompressTypeID())
}

func (ob Object) Decode(source protocol.Codec) (n int, err error_p.Error) {
	err = &ErrSourceNotChangeable
	return
}
func (ob Object) Encode(destination protocol.Codec) (n int, err error_p.Error) {
	var _, goErr = c.WriteTo(writer)
	if goErr != nil {
		// err =
		return
	}
	return
}
func (ob Object) Unmarshal(data []byte) (n int, err error_p.Error) {
	err = &ErrSourceNotChangeable
	return
}
func (ob Object) Marshal() (data []byte, err error_p.Error) { return ob, nil }
func (ob Object) MarshalTo(data []byte) (added []byte, err error_p.Error) {
	added = append(data, ob...)
	return
}
func (ob Object) Len() int { return len(ob) }

