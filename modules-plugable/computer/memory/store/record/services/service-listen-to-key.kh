// HashListenToKey get the recordID by index hash when new record set
// Must send this request to specific node that handle that range
// TODO::: it can't be simple byte, maybe channel
func HashListenToKey(req *HashListenToKeyReq) (res *HashListenToKeyRes, err error_p.Error) {
	var node protocol.ApplicationNode
	node, err = protocol.App.GetNodeByStorage(req.MediaTypeID, req.IndexKey)
	if err != nil {
		return
	}

	if node.Node.State == protocol.ApplicationState_LocalNode {
		// return HashListenToKey(req)
	}

	var st protocol.Stream
	st, err = node.Conn.MakeOutcomeStream(0)
	if err != nil {
		return
	}

	st.Service = &HashListenToKeyService
	st.OutcomePayload = req.ToSyllab()

	err = node.Conn.Send(st)
	if err != nil {
		return
	}

	// Sender can reuse exiting stream to send new record

	var res = &HashListenToKeyRes{}
	res.FromSyllab(srpc.GetPayload(st.IncomePayload))
	return
}

// HashListenToKeySRPC is sRPC handler of HashListenToKey service.
func HashListenToKeySRPC(st protocol.Stream) {
	if st.Connection.UserID != protocol.OS.AppManifest().AppUUID() {
		// TODO::: Attack??
		err = authorization.ErrUserNotAllow
		return
	}

	var req = &HashListenToKeyReq{}
	req.FromSyllab(srpc.GetPayload(st.IncomePayload))

	var res *HashListenToKeyRes
	res, err = HashListenToKey(req)
	if err != nil {
		return
	}

	st.OutcomePayload = res.ToSyllab()
}

// HashListenToKeyReq is request structure of HashListenToKey()
type HashListenToKeyReq struct {
	MediaTypeID    uint64
	IndexKey       [16]byte
	ReceiveChannel chan []byte `syllab:"-"`
}

// HashListenToKeyRes is response structure of HashListenToKey()
type HashListenToKeyRes struct {
	Record []byte
}

/*
	-- Syllab Encoder & Decoder --
