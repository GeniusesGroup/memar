tp Domain mt (self Error_Files_RootCollision) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_RootCollision) () (s String) {
    CharacterRun_From.FromCharacterRun("A memory root that nests inside another class's memory root")(s, VoidError)
}

tp Overview mt (self Error_Files_RootCollision) () (s String) {
    CharacterRun_From.FromCharacterRun("A memory root that nests inside another class's memory root.")(s, VoidError)
}

tp UserActionNote mt (self Error_Files_RootCollision) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_RootCollision) () (s String) {
    CharacterRun_From.FromCharacterRun("Two classes may share one root; one root must not be a directory under another class's root. The class bound second is refused, naming both roots.")(s, VoidError)
}

