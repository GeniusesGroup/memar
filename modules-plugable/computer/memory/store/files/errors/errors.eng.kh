    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_Lost) () (s String) {
    CharacterRun_From.FromCharacterRun("The files medium lost a committed batch the adapter expected to hold")(s, VoidError)
}

tp Overview mt (self Error_Files_Lost) () (s String) {
    CharacterRun_From.FromCharacterRun("The files medium lost a committed batch the adapter expected to hold.")(s, VoidError)
}

