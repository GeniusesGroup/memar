    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_Lost) () (s String) {
    CharacterRun_From.FromCharacterRun("A durable batch that is no longer readable as a whole after a crash or an external delete under the memory root.")(s, VoidError)
