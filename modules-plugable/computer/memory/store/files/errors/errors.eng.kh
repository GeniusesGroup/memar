tp Error_Files_Lost in "modules-plugable/computer/memory/store/files/errors/errors.kh"
tp Error_Files_BadBody in "modules-plugable/computer/memory/store/files/errors/errors.kh"
tp Error_Files_BadCodec in "modules-plugable/computer/memory/store/files/errors/errors.kh"

tp Domain mt (self Error_Files_BadParameter) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_BadParameter) () (s String) {
    CharacterRun_From.FromCharacterRun("A files adapter parameter the manifest must not carry")(s, VoidError)
}

tp Overview mt (self Error_Files_BadParameter) () (s String) {
    CharacterRun_From.FromCharacterRun("A files adapter parameter the manifest must not carry.")(s, VoidError)
}

tp UserActionNote mt (self Error_Files_BadParameter) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_BadParameter) () (s String) {
    CharacterRun_From.FromCharacterRun("A key other than files-memory-root, files-body-codec, files-shard-threshold and files-shard-prefix-length, or a value those keys cannot parse.")(s, VoidError)
}

tp Domain mt (self Error_Files_BadBody) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_BadBody) () (s String) {
    CharacterRun_From.FromCharacterRun("A node body the bound body codec cannot unpack")(s, VoidError)
}

tp Overview mt (self Error_Files_BadBody) () (s String) {
    CharacterRun_From.FromCharacterRun("A node body the bound body codec cannot unpack.")(s, VoidError)
}

tp UserActionNote mt (self Error_Files_BadBody) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_BadBody) () (s String) {
    CharacterRun_From.FromCharacterRun("Returned when Files_Body_Codec.Unpack refuses the bytes of a node file under the bound codec. The adapter does not sniff another codec.")(s, VoidError)
}

tp Domain mt (self Error_Files_BadCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_BadCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("A files-body-codec name that is not registered")(s, VoidError)
}

tp Overview mt (self Error_Files_BadCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("A files-body-codec name that is not registered.")(s, VoidError)
}

tp UserActionNote mt (self Error_Files_BadCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_BadCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("Bind refuses a files-body-codec value that is not the GetName of a registered Files_Body_Codec (json at first ship; yaml when that codec is added).")(s, VoidError)
}


tp Domain mt (self Error_Files_BadAddress) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Error_Files_BadAddress) () (s String) {
    CharacterRun_From.FromCharacterRun("An address the files path encoding cannot map")(s, VoidError)
}

tp Overview mt (self Error_Files_BadAddress) () (s String) {
    CharacterRun_From.FromCharacterRun("An address the files path encoding cannot map.")(s, VoidError)
}

tp UserActionNote mt (self Error_Files_BadAddress) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Error_Files_BadAddress) () (s String) {
