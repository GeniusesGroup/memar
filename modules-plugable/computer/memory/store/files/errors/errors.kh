tp Error in "modules/process/error/protocol/error.kh"
tp Error_Store_Malformed in "modules/computer/memory/store/errors/errors.kh"
tp Error_Store_Failed in "modules/computer/memory/store/errors/errors.kh"

tp Error_Files_BadParameter ab {
    Error
}

tp Error_Files_BadAddress ab {
    Error_Store_Malformed
}

