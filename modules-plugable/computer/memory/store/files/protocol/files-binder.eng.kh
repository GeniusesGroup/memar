tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Files_Binder in "modules-plugable/computer/memory/store/files/protocol/files-binder.kh"

tp Domain mt (self Files_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Files_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Binds a record class to the files store adapter")(s, VoidError)
}

tp Overview mt (self Files_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Binds a record class to the files store adapter.")(s, VoidError)
}

tp UserActionNote mt (self Files_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Files_Binder) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the files keys of the memar block for the class, does no work on the medium, and returns a Files_Adapter whose store equality is the sameness of the memory root. Two classes that share one root share one store.")(s, VoidError)
}
