tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Files_Adapter in "modules-plugable/computer/memory/store/files/protocol/files-adapter.kh"

tp Domain mt (self Files_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Files_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("A bound files store for one record class over a filesystem directory")(s, VoidError)
}

tp Overview mt (self Files_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("A bound files store for one record class over a filesystem directory.")(s, VoidError)
}

tp UserActionNote mt (self Files_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Files_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("GetMemoryRoot is a Storage_Directory from the filesystem module, resolved at bind from the files-memory-root parameter string. FileAt maps the address through Files_Path to the node id file then opens or creates that Storage_File; domain parts live as properties of one UTF-8 JSON object in that file, not as separate paths and not as binary length-prefix frames. It does not define File. SameStore is true when two adapters share the same root directory. Close ends what this handle holds open.")(s, VoidError)
}
