tp String in "modules/computer/codec/string/protocol/string.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp W64 in "modules/math/integer/unsigned-64.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"
tp Record_Class in "modules-plugable/computer/memory/store/record/protocol/record-class.kh"

tp Files_Parameters ab

tp GetMemoryRoot mt (self Files_Parameters) (class Record_Class) (root String)

tp GetBodyCodecName mt (self Files_Parameters) (class Record_Class) (name String)

tp GetShardThreshold mt (self Files_Parameters) (class Record_Class) (count W64, given Boolean)

tp GetShardPrefixLength mt (self Files_Parameters) (class Record_Class) (length W32)
