tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Files_Path in "modules-plugable/computer/memory/store/files/protocol/files-path.kh"

tp Domain mt (self Files_Path) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Files_Path) () (s String) {
    CharacterRun_From.FromCharacterRun("Maps a store address to the node file URI_Path under the memory root")(s, VoidError)
}

tp Overview mt (self Files_Path) () (s String) {
    CharacterRun_From.FromCharacterRun("Maps a store address to the node file URI_Path under the memory root.")(s, VoidError)
}

tp UserActionNote mt (self Files_Path) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Files_Path) () (s String) {
    CharacterRun_From.FromCharacterRun("For a record key, the path is only the id segment (canonical UUID text of the sixteen id bytes, else lowercase hex), with no domain folder and no domain in the name. The domain key is used by the adapter to select a part inside that file, not by this path map. When shardEnabled is true and shardPrefixLength is above zero, an optional leading hex prefix directory of the id bytes may be inserted; default is flat. Other address lengths use lowercase hex of every address byte as the sole segment. Cannot encode is Error_Files_BadAddress.")(s, VoidError)
}
