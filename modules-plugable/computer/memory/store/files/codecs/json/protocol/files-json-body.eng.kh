tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Files_JSON_Body_Codec in "modules-plugable/computer/memory/store/files/codecs/json/protocol/files-json-body.kh"

tp Domain mt (self Files_JSON_Body_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Files Store")(s, VoidError)
}

tp Summary mt (self Files_JSON_Body_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Default body codec: one UTF-8 JSON object per node")(s, VoidError)
}

tp Overview mt (self Files_JSON_Body_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("Default body codec: one UTF-8 JSON object per node.")(s, VoidError)
}

tp UserActionNote mt (self Files_JSON_Body_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Files_JSON_Body_Codec) () (s String) {
    CharacterRun_From.FromCharacterRun("GetName returns json. Body is a pretty-printed UTF-8 JSON object with trailing newline; each property name is a domain key. Part bytes that are UTF-8 JSON become a native JSON value and are stored as the compact re-encoding; other UTF-8 text uses an object with key $files.text; other bytes use $files.bytes with base64. This policy is private to this codec. No migration of other body formats is owed.")(s, VoidError)
}
