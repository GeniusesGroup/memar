tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_LockableGroup in "modules-plugable/computer/memory/store/lockable/protocol/store-lockable-group.kh"

tp Domain mt (self Store_LockableGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store Lockable")(s, VoidError)
}

tp Summary mt (self Store_LockableGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group lockable")(s, VoidError)
}

tp Overview mt (self Store_LockableGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("The conformance group lockable.")(s, VoidError)
}

tp UserActionNote mt (self Store_LockableGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_LockableGroup) () (s String) {
    CharacterRun_From.FromCharacterRun("Owed by this module, which declares the capability: a lock excludes a second holder, a lock lapses with its lease and not before, and a store offers Lock exactly when it declares lockable.")(s, VoidError)
}
