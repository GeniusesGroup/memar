tp Error in "modules/process/error/protocol/error.kh"

tp ADT in "modules/computer/adt/protocol/adt.kh"
tp Container_Clear in "modules/computer/adt/container/protocol/clear.kh"
tp Observer_Container_AvailableLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_Capacity in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_OccupiedLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_PageNumber in "modules-plugable/computer/memory/store/page/protocol/page.observers.kh"
tp NonVolatile in "modules-plugable/computer/memory/store/nonvolatile/protocol/nonvolatile.kh"

// Several pages are summarized to a block.
// A block is the smallest unit of access on a memory.
// Currently, 128 pages are mostly combined into one block; therefore with 4KB page, a block contains 512 KB.
tp Storage_Block ab {
    Observer_PageNumber
    Container_Clear
// TODO::: Capacity and Length is `byte` or `page`??
    Observer_Container_Capacity
    Observer_Container_OccupiedLength
    Observer_Container_AvailableLength
    NonVolatile
    ADT
    Clone_Storage_Block
    Copy_Storage_Block
}

tp BlockNumber ab

tp BlockIndex ab

