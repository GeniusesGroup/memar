tp Array_Dynamic in "modules/computer/adt/array/protocol/dynamic.kh"
tp Container_ElementIndex in "modules/computer/adt/container/protocol/index.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp IndexOneOne_Key in "modules-plugable/computer/memory/store/index/protocol/key.kh"
tp RecordUUID in "modules-plugable/computer/memory/store/record/protocol/uuid.kh"

// Model is the interface that show how a pehrest index system work.
// https://github.com/geniusesgroup/memar/
tp IndexOneOne_Model ab
tp KeysNumbers mt (self IndexOneOne_Model) () (num NumberOfElement, err Error)

tp IndexOneOne_Model_Lock mt (self IndexOneOne_Model) (key IndexOneOne_Key) (lastUUID RecordUUID, err Error)

tp IndexOneOne_Model_Unlock mt (self IndexOneOne_Model) (key IndexOneOne_Key, latestUUID RecordUUID) (err Error)

tp IndexOneOne_Model_Get mt (self IndexOneOne_Model) (key IndexOneOne_Key) (uuid RecordUUID, err Error)

tp IndexOneOne_Model_Set mt (self IndexOneOne_Model) (key IndexOneOne_Key, uuid RecordUUID) (err Error)

// make invisible just by remove from primary index
tp IndexOneOne_Model_Delete mt (self IndexOneOne_Model) (key IndexOneOne_Key) (err Error)

tp IndexOneOne_Model_ListKeys mt (self IndexOneOne_Model) (offset Container_ElementIndex, limit NumberOfElement) (d Array_Dynamic, err Error)
