tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"
tp Graph_Direction in "modules-plugable/computer/memory/store/graph/protocol/graph-direction.kh"
tp Graph_Path_Mode in "modules-plugable/computer/memory/store/graph/protocol/graph-path-mode.kh"

tp Graph_Path_Query ab

tp GetFrom mt (self Graph_Path_Query) () (from Computer_Buffer)

tp GetRelation mt (self Graph_Path_Query) () (relation Computer_Buffer)

tp GetDirection mt (self Graph_Path_Query) () (direction Graph_Direction)

tp GetMinHops mt (self Graph_Path_Query) () (hops W32)

tp GetMaxHops mt (self Graph_Path_Query) () (hops W32)

tp GetMode mt (self Graph_Path_Query) () (mode Graph_Path_Mode)

tp GetLimit mt (self Graph_Path_Query) () (limit W32, given Boolean)
