tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"
tp Graph_Pattern_Steps in "modules-plugable/computer/memory/store/graph/protocol/graph-pattern-steps.kh"

tp Graph_Pattern ab

tp GetSlotCount mt (self Graph_Pattern) () (count W32)

tp GetSteps mt (self Graph_Pattern) () (steps Graph_Pattern_Steps)

tp GetBoundSlot mt (self Graph_Pattern) () (slot W32, given Boolean)

tp GetBoundVertex mt (self Graph_Pattern) () (vertex Computer_Buffer, given Boolean)

tp GetLimit mt (self Graph_Pattern) () (limit W32, given Boolean)
