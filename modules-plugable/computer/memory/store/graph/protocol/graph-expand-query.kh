tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"
tp Graph_Direction in "modules-plugable/computer/memory/store/graph/protocol/graph-direction.kh"

tp Graph_Expand_Query ab

tp GetFrom mt (self Graph_Expand_Query) () (from Computer_Buffer)

tp GetRelation mt (self Graph_Expand_Query) () (relation Computer_Buffer)

tp GetDirection mt (self Graph_Expand_Query) () (direction Graph_Direction)

tp GetLimit mt (self Graph_Expand_Query) () (limit W32, given Boolean)
