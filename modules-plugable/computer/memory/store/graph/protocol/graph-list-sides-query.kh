tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"
tp Graph_SideRef in "modules-plugable/computer/memory/store/graph/protocol/graph-side-ref.kh"

tp Graph_ListSidesQuery ab

tp GetFrom mt (self Graph_ListSidesQuery) () (from Computer_Buffer)

tp GetRelation mt (self Graph_ListSidesQuery) () (relation Computer_Buffer)

tp GetAfter mt (self Graph_ListSidesQuery) () (after Graph_SideRef, given Boolean)

tp GetLimit mt (self Graph_ListSidesQuery) () (limit W32, given Boolean)

tp GetDescending mt (self Graph_ListSidesQuery) () (descending Boolean)
