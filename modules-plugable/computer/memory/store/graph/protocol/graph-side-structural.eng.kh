tp String in "modules/string/protocol/string.kh"
tp Graph_Side_Structural in "modules-plugable/computer/memory/store/graph/protocol/graph-side-structural.kh"

tp Domain mt (self Graph_Side_Structural) () (s String) {
    return "computer.memory.store.graph"
}

tp Summary mt (self Graph_Side_Structural) () (s String) {
    return "well-known TypeUUIDs for the four structural roles of a durable graph side"
}

tp Overview mt (self Graph_Side_Structural) () (s String) {
    return "Slot, to, fields and ended are TypeUUIDs Graph owns; English side keys are refused. Values live in the Python realization side_structural.py once."
}

tp UserActionNote mt (self Graph_Side_Structural) () (s String) {
    return "use the TypeUUID accessors; do not write slot, to, fields or ended as English keys"
}

tp DevActionNote mt (self Graph_Side_Structural) () (s String) {
    return "mint and read the four UUIDs only in side_structural.py; Files and Graph validators import that file"
}
