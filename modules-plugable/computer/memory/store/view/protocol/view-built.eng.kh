tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Built in "modules-plugable/computer/memory/store/view/protocol/view-built.kh"

tp Domain mt (self View_Built) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Built) () (s String) {
    CharacterRun_From.FromCharacterRun("A build that finished: files written, removed, left as they were, and found changed by hand")(s, VoidError)
}

tp Overview mt (self View_Built) () (s String) {
    CharacterRun_From.FromCharacterRun("A build that finished: files written, removed, left as they were, and found changed by hand.")(s, VoidError)
}

tp UserActionNote mt (self View_Built) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Built) () (s String) {
    CharacterRun_From.FromCharacterRun("Building twice with no change in between rewrites no file, and building after the folder is deleted gives the same bytes.")(s, VoidError)
}
