vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Files in "modules-plugable/computer/memory/store/view/protocol/view-files.kh"

tp Domain mt (self View_Files) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Files) () (s String) {
    CharacterRun_From.FromCharacterRun("The files a presentation shows for one node")(s, VoidError)
}

tp Overview mt (self View_Files) () (s String) {
    CharacterRun_From.FromCharacterRun("The files a presentation shows for one node.")(s, VoidError)
}

tp UserActionNote mt (self View_Files) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Files) () (s String) {
    CharacterRun_From.FromCharacterRun("No two files of the build show the same path.")(s, VoidError)
}
