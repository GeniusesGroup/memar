tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_BuildAnswer in "modules-plugable/computer/memory/store/view/protocol/view-build-answer.kh"

tp Domain mt (self View_BuildAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_BuildAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("What a build answers")(s, VoidError)
}

tp Overview mt (self View_BuildAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("What a build answers.")(s, VoidError)
}

tp UserActionNote mt (self View_BuildAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_BuildAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Built when it finished, Refused when it did not start; a refusal is decided before anything is written or removed.")(s, VoidError)
}
