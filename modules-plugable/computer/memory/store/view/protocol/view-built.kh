tp W32 in "modules/math/integer/unsigned-32.kh"
tp View_BuildAnswer in "modules-plugable/computer/memory/store/view/protocol/view-build-answer.kh"

tp View_Built ab {
    View_BuildAnswer
}

tp GetWritten mt (self View_Built) () (count W32)

tp GetRemoved mt (self View_Built) () (count W32)

tp GetUnchanged mt (self View_Built) () (count W32)

tp GetDrift mt (self View_Built) () (count W32)
