tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Listing in "modules-plugable/computer/memory/store/view/protocol/view-listing.kh"

tp Domain mt (self View_Listing) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Listing) () (s String) {
    CharacterRun_From.FromCharacterRun("The list the builder keeps in the folder: every file it wrote, each with the token of its bytes")(s, VoidError)
}

tp Overview mt (self View_Listing) () (s String) {
    CharacterRun_From.FromCharacterRun("The list the builder keeps in the folder: every file it wrote, each with the token of its bytes.")(s, VoidError)
}

tp UserActionNote mt (self View_Listing) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Listing) () (s String) {
    CharacterRun_From.FromCharacterRun("Named memar-view with a leading dot. The builder touches only the files the list names and refuses a folder holding a file it did not write, so a folder in use for something else is never cleaned. A file found changed is rewritten from the store and counted as drift.")(s, VoidError)
}
