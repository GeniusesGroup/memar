tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Registry in "modules-plugable/computer/memory/store/view/protocol/view-registry.kh"

tp Domain mt (self View_Registry) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Registry) () (s String) {
    CharacterRun_From.FromCharacterRun("The presentation registered for each class")(s, VoidError)
}

tp Overview mt (self View_Registry) () (s String) {
    CharacterRun_From.FromCharacterRun("The presentation registered for each class.")(s, VoidError)
}

tp UserActionNote mt (self View_Registry) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Registry) () (s String) {
    CharacterRun_From.FromCharacterRun("A second registration for a class replaces the first. Importing the module registers nothing.")(s, VoidError)
}
