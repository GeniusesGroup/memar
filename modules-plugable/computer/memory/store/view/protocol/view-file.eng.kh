tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_File in "modules-plugable/computer/memory/store/view/protocol/view-file.kh"

tp Domain mt (self View_File) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_File) () (s String) {
    CharacterRun_From.FromCharacterRun("A file a presentation shows: a path and its bytes")(s, VoidError)
}

tp Overview mt (self View_File) () (s String) {
    CharacterRun_From.FromCharacterRun("A file a presentation shows: a path and its bytes.")(s, VoidError)
}

tp UserActionNote mt (self View_File) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_File) () (s String) {
    CharacterRun_From.FromCharacterRun("Made read-only by the operating system when written.")(s, VoidError)
}
