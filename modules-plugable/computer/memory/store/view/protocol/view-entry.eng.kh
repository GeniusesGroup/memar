tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Entry in "modules-plugable/computer/memory/store/view/protocol/view-entry.kh"

tp Domain mt (self View_Entry) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Entry) () (s String) {
    CharacterRun_From.FromCharacterRun("A file the builder wrote with the token of its bytes")(s, VoidError)
}

tp Overview mt (self View_Entry) () (s String) {
    CharacterRun_From.FromCharacterRun("A file the builder wrote with the token of its bytes.")(s, VoidError)
}

tp UserActionNote mt (self View_Entry) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Entry) () (s String) {
    CharacterRun_From.FromCharacterRun("The token is the SHA-256 of the bytes, the one the store gives a part.")(s, VoidError)
}
