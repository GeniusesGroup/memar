    CharacterRun_From.FromCharacterRun("The class a project shows and the folder it is built in")(s, VoidError)
}

tp Overview mt (self View_Preference) () (s String) {
    CharacterRun_From.FromCharacterRun("The class a project shows and the folder it is built in.")(s, VoidError)
}

tp UserActionNote mt (self View_Preference) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Preference) () (s String) {
