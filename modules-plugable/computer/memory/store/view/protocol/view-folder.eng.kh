tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp View_Folder in "modules-plugable/computer/memory/store/view/protocol/view-folder.kh"

tp Domain mt (self View_Folder) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory View")(s, VoidError)
}

tp Summary mt (self View_Folder) () (s String) {
    CharacterRun_From.FromCharacterRun("The folder a view is built in, relative to the top folder of the project")(s, VoidError)
}

tp Overview mt (self View_Folder) () (s String) {
    CharacterRun_From.FromCharacterRun("The folder a view is built in, relative to the top folder of the project.")(s, VoidError)
}

tp UserActionNote mt (self View_Folder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self View_Folder) () (s String) {
    CharacterRun_From.FromCharacterRun("Ignored by version control, which the builder checks before it writes; refused when it is the top of a working tree or holds a file the builder did not write.")(s, VoidError)
}
