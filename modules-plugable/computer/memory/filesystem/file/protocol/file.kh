tp Mutator_File in "modules-plugable/computer/memory/filesystem/file/protocol/file.mutators.kh"

tp Observer_File_Data in "modules-plugable/computer/memory/filesystem/file/protocol/data.observers.kh"
tp Observer_File_Metadata in "modules-plugable/computer/memory/filesystem/file/protocol/metadata.observers.kh"
// File is the descriptor interface that must implement by any to be an file.
// File owner is one app so it must handle concurrent protection internally not by file it self.
// A file other apps use is still owned by one app; the others reach it through that app's SDK, not
// through an OS-level shared tree (modules/computer/os/os.md#storage-block-abstractions-not-filesystems,
// modules/process/service/rules/sdk/sdk.md#local-and-network-invocation). Which app serves shared files is a default-app
// choice (modules/computer/os/os.md), not part of this protocol.
//
// https://en.wikipedia.org/wiki/Computer_file
tp Storage_File ab {
    Observer_File_Metadata
    Observer_File_Data
    Mutator_File
}

