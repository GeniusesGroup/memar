//memar:impl memar/protocol.Codec
func (f *File) MediaType() protocol.MediaType       { return f.mediaType }
func (f *File) CompressType() protocol.CompressType { return f.compressType }

func (f *File) Decode(source protocol.Codec) (n int, err error_p.Error) {
	var buf bytes.Buffer
	var _, goErr = io.Copy(&buf, reader)
	if goErr != nil {
		// err =
	}
	err = f.Unmarshal(buf.Bytes())
	return
}

// Encode write file to given writer
func (f *File) Encode(destination protocol.Codec) (n int, err error_p.Error) {
	_, err = f.WriteTo(writer)
	return
}

// Marshal encodes and return whole file data!
func (f *File) Marshal() (data []byte, err error_p.Error) {
	if f.data != nil {
		return f.data
	}
	data, _ = goos.ReadFile(f.metadata.uri.Path())
	return
}

// MarshalTo encodes whole file data to given data and return it with new len!
func (f *File) MarshalTo(data []byte) (added []byte, err error_p.Error) {
	data = append(data, f.data...)
	return data
}

// Unmarshal save given data to the file. It will overwritten exiting data.
func (f *File) Unmarshal(data []byte) (n int, err error_p.Error) {
	// TODO::: MediaType??
	f.data = data
	return
}

// Len return length of file
func (f *File) Len() (ln int) { return len(f.data) }

