tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Stringer_GO is same as `fmt.Stringer`
// It just exist to prevent protocol package not couple to a implementation package(fmt).
tp Stringer_GO ab
// It will clone the underlying buffer and return standalone string.
tp ToGoString mt (self Stringer_GO) () (str String, err Error)

tp FromGoString mt (self Stringer_GO) (str String) (err Error)

