tp Observer_MediaType in "modules/identifier/mediatype/protocol/media-type.observers.kh"
tp Information in "modules/gui/protocol/information.kh"
tp Picture_Image in "modules/codec/picture/protocol/image.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Page_Manifest ab {
    Observer_MediaType
}
// "all", "noindex", "nofollow", "none", "noarchive", "nosnippet", "notranslate", "noimageindex", "unavailable_after: [RFC-850 date/time]"
tp Robots mt (self Page_Manifest) () (s String)

tp GUI_Page_Manifest_Icon mt (self Page_Manifest) () (i Picture_Image)

// It is locale info
tp Info mt (self Page_Manifest) () (info Information)
// think about a page that show a user medical records, doctor need to know user birthday, so /user page must ready to reach by doctor
// or doctor need to know other doctors visits to know any advice from them for this user.

// To route page by path of HTTP-URI
tp GUI_Page_Manifest_Path mt (self Page_Manifest) () (s String)
// /product?id=1&title=book
