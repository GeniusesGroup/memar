// Information store application, page, widget locale details
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl
tp Information ab
tp Language mt (self Information) () (s String)

tp GUI_Information_Name mt (self Information) () (s String)

tp ShortName mt (self Information) () (s String)

tp Tagline mt (self Information) () (s String)

tp Slogan mt (self Information) () (s String)

tp Description mt (self Information) () (s String)

tp GUI_Information_Tags mt (self Information) () (d Array_Dynamic)

