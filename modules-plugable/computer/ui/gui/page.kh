tp GUI_Information in "modules-plugable/computer/ui/gui/information.kh"
tp PageState in "modules-plugable/computer/ui/gui/protocol/page-state.kh"
tp Picture_Image in "modules/computer/codec/picture/protocol/image.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"

// Page implements gui_p.Page interface
tp GUI_Page cp {
    robots String
    icon Picture_Image
    info GUI_Information

    // To route page by path of HTTP-URI
    path String

    activeState PageState

}

