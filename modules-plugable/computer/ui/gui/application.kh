tp GUI_Information_2 in "modules/gui/information.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Application store the data to run a GUI application
// Such to implement phase 1 (compile go to js) to run in webview.
// https://github.com/webview/webview
tp GUI_Application_2 cp {
    // full domain name use for gui app like gui.geniuses.group
    Domain String
    LocaleInfo GUI_Information_2
    ContentPreferences String
    PresentationPreferences String

    UserPreferences UserPreferences
    DesignLanguageStyles String

}

// UserPreferences :
tp UserPreferences cp {
    UsersState UsersState
}

// UsersState :
tp UsersState cp {
    activeUserID String
}

// TODO(go-migrate): [tp GUI_Application_2] impl struct gui.Application and protocol gui_p.Application (Application in modules/gui/protocol/application.kh) both qualify to Application; the capsule carries the bridge's counter fallback until a naming decision.
