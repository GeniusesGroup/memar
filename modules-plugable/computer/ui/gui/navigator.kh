tp GUI_Page in "modules-plugable/computer/ui/gui/page.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"

tp GUI_Navigator cp {
    switcherPage GUI_Page
    homePage GUI_Page
    activePage GUI_Page
}

// Active a page like alt+tab in windows to show Pages() and their states
tp SwitcherPage mt (self GUI_Navigator) () () {}

// It must reorder by recently active page be last item in the array

// Navigate(url string)
tp ActivatePage mt (self GUI_Navigator) (url String) () {}

