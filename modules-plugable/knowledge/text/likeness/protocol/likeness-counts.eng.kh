tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Likeness_Counts in "modules-plugable/knowledge/text/likeness/protocol/likeness-counts.kh"

tp Domain mt (self Likeness_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Likeness_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("The counts a weight is derived against")(s, VoidError)
}

tp Overview mt (self Likeness_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("The number of entries of a scope and, for a word, the number of entries keeping it; the live ones for a signing as texts arrive, a snapshot taken when a renewal begins for the signing of that pass.")(s, VoidError)
}

tp UserActionNote mt (self Likeness_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Likeness_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
