tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Likeness_Signature in "modules-plugable/knowledge/text/likeness/protocol/likeness-signature.kh"

tp Domain mt (self Likeness_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Likeness_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("The kept summary of one text: its highest-weighted labels")(s, VoidError)
}

tp Overview mt (self Likeness_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("At most a fixed number of Label values with a weight each, taken to unit length; it carries no identity, so a typed text that is not yet kept can be ranked as a query, and the store pairs it with a subject and a text when it keeps one.")(s, VoidError)
}

tp UserActionNote mt (self Likeness_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Likeness_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
