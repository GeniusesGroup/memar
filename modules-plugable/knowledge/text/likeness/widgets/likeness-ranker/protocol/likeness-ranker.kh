tp Error in "modules/process/error/protocol/error.kh"
tp Text in "modules/knowledge/text/protocol/dt-text.kh"
tp Text_Likeness in "modules-plugable/knowledge/text/likeness/protocol/text-likeness.kh"
tp Observer_Text_Scope in "modules/knowledge/text/protocol/scope.observers.kh"
tp Observer_Text_Holder in "modules/knowledge/text/protocol/holder.observers.kh"
tp Text_To_Labels in "modules/knowledge/text/widgets/text-to-labels/protocol/text-to-labels.kh"
tp Likeness_Sign in "modules-plugable/knowledge/text/likeness/services/sign-text/protocol/sign-text.kh"
tp Likeness_Rank in "modules-plugable/knowledge/text/likeness/services/rank-likeness/protocol/rank-likeness.kh"
tp Text_Holders in "modules/knowledge/text/protocol/text-holders.kh"
tp Likeness_Hits in "modules-plugable/knowledge/text/likeness/services/rank-likeness/protocol/likeness-hits.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"

tp Likeness_Ranker ab {
	Text_To_Labels
	Likeness_Sign
	Likeness_Rank
	Observer_Text_Scope
	Observer_Text_Holder
}

tp RankText mt (self Likeness_Ranker) (text Text, excluded Text_Holders, limit NumberOfElement, min_likeness Text_Likeness) (hits Likeness_Hits, err Error)

tp RankHolder mt (self Likeness_Ranker) (excluded Text_Holders, limit NumberOfElement, min_likeness Text_Likeness) (hits Likeness_Hits, err Error)
