tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Has_Signature in "modules-plugable/knowledge/text/likeness/services/has-signature/protocol/has-signature.kh"

tp Domain mt (self Has_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Has_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("Reports whether a scope keeps one signature")(s, VoidError)
}

tp Overview mt (self Has_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads one signature of one holder in one scope. The answer says whether that signature is kept.")(s, VoidError)
}

tp UserActionNote mt (self Has_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Has_Signature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
