tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Begin_Renewal in "modules-plugable/knowledge/text/likeness/services/begin-renewal/protocol/begin-renewal.kh"

tp Domain mt (self Begin_Renewal) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Begin_Renewal) () (s String) {
    CharacterRun_From.FromCharacterRun("Freezes one scope's counts for a renewal")(s, VoidError)
}

tp Overview mt (self Begin_Renewal) () (s String) {
    CharacterRun_From.FromCharacterRun("Takes the snapshot of one scope's counts that the signing of that pass uses, and freezes them so later keeps do not re-enter renewal.")(s, VoidError)
}

tp UserActionNote mt (self Begin_Renewal) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Begin_Renewal) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
