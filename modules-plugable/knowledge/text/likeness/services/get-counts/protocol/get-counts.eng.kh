tp Get_Counts in "modules-plugable/knowledge/text/likeness/services/get-counts/protocol/get-counts.kh"

tp Domain mt (self Get_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Get_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the counts a weight is derived against")(s, VoidError)
}

tp Overview mt (self Get_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the live counts of one scope: how many entries it has, and how many keep each word.")(s, VoidError)
}

tp UserActionNote mt (self Get_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Counts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
