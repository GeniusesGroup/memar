tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Signatures in "modules-plugable/knowledge/text/likeness/services/signatures/protocol/signatures.kh"

tp Domain mt (self Get_Signatures) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Get_Signatures) () (s String) {
    CharacterRun_From.FromCharacterRun("Lists the signatures one holder keeps")(s, VoidError)
}

tp Overview mt (self Get_Signatures) () (s String) {
    CharacterRun_From.FromCharacterRun("Lists the signatures one holder keeps in one scope.")(s, VoidError)
}

tp UserActionNote mt (self Get_Signatures) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Signatures) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
