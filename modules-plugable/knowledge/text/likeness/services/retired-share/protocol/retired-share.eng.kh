tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Retired_Share in "modules-plugable/knowledge/text/likeness/services/retired-share/protocol/retired-share.kh"

tp Domain mt (self Get_Retired_Share) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Get_Retired_Share) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads how much of one scope is retired")(s, VoidError)
}

tp Overview mt (self Get_Retired_Share) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the retired share of one scope.")(s, VoidError)
}

tp UserActionNote mt (self Get_Retired_Share) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Retired_Share) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
