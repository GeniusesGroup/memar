tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Remove_Retired in "modules-plugable/knowledge/text/likeness/services/remove-retired/protocol/remove-retired.kh"

tp Domain mt (self Remove_Retired) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Remove_Retired) () (s String) {
    CharacterRun_From.FromCharacterRun("Removes the retired entries of one scope")(s, VoidError)
}

tp Overview mt (self Remove_Retired) () (s String) {
    CharacterRun_From.FromCharacterRun("Removes the retired entries of one scope and writes nothing else.")(s, VoidError)
}

tp UserActionNote mt (self Remove_Retired) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Remove_Retired) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
