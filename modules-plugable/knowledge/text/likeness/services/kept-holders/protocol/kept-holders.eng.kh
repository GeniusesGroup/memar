tp Get_Kept_Holders in "modules-plugable/knowledge/text/likeness/services/kept-holders/protocol/kept-holders.kh"

tp Domain mt (self Get_Kept_Holders) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Get_Kept_Holders) () (s String) {
    CharacterRun_From.FromCharacterRun("Lists the holders that keep one text")(s, VoidError)
}

tp Overview mt (self Get_Kept_Holders) () (s String) {
    CharacterRun_From.FromCharacterRun("Lists the holders that keep one text in one scope.")(s, VoidError)
}

tp UserActionNote mt (self Get_Kept_Holders) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Kept_Holders) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
