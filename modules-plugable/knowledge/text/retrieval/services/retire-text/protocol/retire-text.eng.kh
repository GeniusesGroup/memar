tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Retire_Text in "modules-plugable/knowledge/text/retrieval/services/retire-text/protocol/retire-text.kh"

tp Domain mt (self Retire_Text) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Retire_Text) () (s String) {
    CharacterRun_From.FromCharacterRun("Retires every index entry of one text")(s, VoidError)
}

tp Overview mt (self Retire_Text) () (s String) {
    CharacterRun_From.FromCharacterRun("Retires every entry of one text in one scope.")(s, VoidError)
}

tp UserActionNote mt (self Retire_Text) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Retire_Text) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
