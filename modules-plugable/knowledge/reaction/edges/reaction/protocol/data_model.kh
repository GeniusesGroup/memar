tp Field_ReactionTo ab

tp ReactionTo mt (self Field_ReactionTo) () (t ThingUUID)

tp Field_ReactionType ab

tp ReactionType mt (self Field_ReactionType) () (c Character)

tp ReactionDataModel ab {
	Field_UserUUID
	Field_ReactionTo
	Field_ReactionType
	Observer_RequestID
	Observer_Time_Creation
	Versioned
}

