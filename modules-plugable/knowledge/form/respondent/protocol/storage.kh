tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp VersionOffset in "memar/modules/computer/memory/protocol/version.kh"

tp FormRespondentStorage ab

tp Save mt (self FormRespondentStorage) (dm FormRespondentDataModel) (n NumberOfVersion, e Error)

tp Count mt (self FormRespondentStorage) (t ThingUUID) (n NumberOfVersion, e Error)

tp Get mt (self FormRespondentStorage) (t ThingUUID, vo VersionOffset) (dm FormRespondentDataModel, n NumberOfVersion, e Error)

