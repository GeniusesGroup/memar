tp Observer_Time_Request in "memar/modules/process/time/protocol/dt-request.observers.kh"
tp UserUUID in "org/modules/identity/user/protocol/dt-uuid.kh"

tp Field_AnswerBy ab

tp AnswerBy mt (self Field_AnswerBy) () (u UserUUID)

tp Field_FillBy ab

tp FillBy mt (self Field_FillBy) () (u UserUUID)

tp FormRespondentDataModel ab {
	Field_FormRespondentID
	Field_FormID
	Field_AnswerBy
	Field_FillBy
	Observer_RequestID
	Observer_Time_Request
}

