tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Label_Accepted in "modules-plugable/knowledge/label/services/accepted-labels/protocol/accepted-labels.kh"

tp Domain mt (self Label_Accepted) () (s String) {
    CharacterRun_From.FromCharacterRun("Label")(s, VoidError)
}

tp Summary mt (self Label_Accepted) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the labels a subject accepts")(s, VoidError)
}

tp Overview mt (self Label_Accepted) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the reverse side of the allowed-label relation for the given subject. The answer is the identifiers of the accepted labels. It does not resolve their text or decide which labels a subject ought to accept.")(s, VoidError)
}

tp UserActionNote mt (self Label_Accepted) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Label_Accepted) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
