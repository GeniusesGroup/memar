tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Label_Allow in "modules-plugable/knowledge/label/services/allow-label/protocol/allow-label.kh"

tp Domain mt (self Label_Allow) () (s String) {
    CharacterRun_From.FromCharacterRun("Label")(s, VoidError)
}

tp Summary mt (self Label_Allow) () (s String) {
    CharacterRun_From.FromCharacterRun("Places an allowed-label relation")(s, VoidError)
}

tp Overview mt (self Label_Allow) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes the allowed-label edge and its reverse together. A call writes one edge; a caller that requires uniqueness or authorization composes those checks before it calls this service.")(s, VoidError)
}

tp UserActionNote mt (self Label_Allow) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Label_Allow) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
