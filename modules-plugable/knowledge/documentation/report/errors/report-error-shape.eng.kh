tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Report_Error_Shape in "modules-plugable/knowledge/documentation/report/errors/errors.kh"

tp Domain mt (self Report_Error_Shape) () (s String) {
    CharacterRun_From.FromCharacterRun("Report")(s, VoidError)
}

tp Summary mt (self Report_Error_Shape) () (s String) {
    CharacterRun_From.FromCharacterRun("The text does not follow the report template")(s, VoidError)
}

tp Overview mt (self Report_Error_Shape) () (s String) {
    CharacterRun_From.FromCharacterRun("A text written in another shape is not read as a report.")(s, VoidError)
}

tp UserActionNote mt (self Report_Error_Shape) () (s String) {
    CharacterRun_From.FromCharacterRun("Write the report to the template.")(s, VoidError)
}

tp DevActionNote mt (self Report_Error_Shape) () (s String) {
    CharacterRun_From.FromCharacterRun("A caller fault; nothing was written.")(s, VoidError)
}
