tp Label in "modules/knowledge/label/protocol/label.kh"
tp Labels in "modules/knowledge/label/protocol/labels.kh"
tp Project_Identifier in "modules-plugable/management/task/labels/project/protocol/identifier.kh"
tp Plan in "modules-plugable/knowledge/documentation/plan/protocol/plan.kh"
tp Service in "modules/process/service/protocol/service.kh"

tp Plan_Front ab {
	Service
}

tp GetLabels mt (self Plan_Front) (plan Plan) (labels Labels)

tp GetProject mt (self Plan_Front) (plan Plan) (project Project_Identifier)

tp GetTopics mt (self Plan_Front) (plan Plan, declared Labels) (topics Labels)

tp GetAct mt (self Plan_Front) (plan Plan, declared Labels) (act Label)
