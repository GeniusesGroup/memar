tp AccessControl in "modules-plugable/management/access-control/protocol/authorization.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp Observer_Request_Identifier in "modules/process/request/protocol/identifier.observers.kh"
tp Observer_Time_Creation in "modules/process/time/protocol/creation.observers.kh"
tp Observer_Group_Identifier in "modules/management/group/protocol/identifier.observers.kh"
tp Observer_User_Identifier in "modules/identity/user/protocol/identifier.observers.kh"
tp Observer_Record_Identifier in "modules-plugable/computer/memory/store/record/protocol/identifier.observers.kh"
tp Record_Identifiers in "modules-plugable/computer/memory/store/record/protocol/identifiers.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp GroupUserAccessControl ab {
	Observer_Group_Identifier
	Observer_User_Identifier
	AccessControl
	Observer_Request_Identifier
	Observer_Time_Creation
}

tp GroupUserAccessControlStorage ab {
	Observer_Record_Identifier
}

tp Save mt (self GroupUserAccessControlStorage) (g GroupUserAccessControl) (n NumberOfVersion, e Error)

tp Count mt (self GroupUserAccessControlStorage) () (n NumberOfVersion, e Error)

tp Get mt (self GroupUserAccessControlStorage) (vo VersionOffset) (g GroupUserAccessControl, n NumberOfVersion, e Error)

tp Last mt (self GroupUserAccessControlStorage) () (g GroupUserAccessControl, n NumberOfVersion, e Error)

tp GetIDs mt (self GroupUserAccessControlStorage) (offset Container_Offset, limit Container_Limit) (ids Record_Identifiers, n NumberOfVersion, e Error)
