tp AccessControl in "org/modules-plugable/management/access-control/protocol/authorization.kh"
tp Array_ThingUUID in "org/modules/identity/thing/protocol/dt-uuid.kh"
tp Container_Limit in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Error in "memar/modules/process/error/protocol/error.kh"
tp NumberOfVersion in "memar/modules/memory/protocol/version.kh"
tp Observer_RequestID in "memar/modules/process/request/protocol/dt-uuid.observers.kh"
tp Observer_Time_Creation in "memar/modules/process/time/protocol/dt-creation.observers.kh"
tp ThingUUID in "org/modules/identity/thing/protocol/dt-uuid.kh"
tp UserUUID in "org/modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "memar/modules/memory/protocol/version.kh"

tp Field_GroupID ab

tp GroupID mt (self Field_GroupID) () (t ThingUUID)

tp Field_UserID ab

tp UserID mt (self Field_UserID) () (u UserUUID)

tp GroupUserAccessControl ab {
	Field_GroupID
	Field_UserID
	AccessControl
	Observer_RequestID
	Observer_Time_Creation
}

tp GroupUserAccessControlStorage ab

tp Save mt (self GroupUserAccessControlStorage) (g GroupUserAccessControl) (n NumberOfVersion, e Error)

tp Count mt (self GroupUserAccessControlStorage) (t ThingUUID) (n NumberOfVersion, e Error)

tp Get mt (self GroupUserAccessControlStorage) (t ThingUUID, vo VersionOffset) (g GroupUserAccessControl, n NumberOfVersion, e Error)

tp Last mt (self GroupUserAccessControlStorage) (t ThingUUID) (g GroupUserAccessControl, n NumberOfVersion, e Error)

tp GetIDs mt (self GroupUserAccessControlStorage) (offset Container_Offset, limit Container_Limit) (a Array_ThingUUID, n NumberOfVersion, e Error)

