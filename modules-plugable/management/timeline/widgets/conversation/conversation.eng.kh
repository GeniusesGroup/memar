tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conversation in "modules-plugable/management/timeline/widgets/conversation/conversation.kh"

tp Domain mt (self Conversation) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Conversation) () (s String) {
    CharacterRun_From.FromCharacterRun("Says into a timeline and reads what was said")(s, VoidError)
}

tp Overview mt (self Conversation) () (s String) {
    CharacterRun_From.FromCharacterRun("Post checks a text against the template of its kind, creates the content, places it in the timeline by the placer and answers the placement's number; it is refused, and nothing is created, when the check refuses, and nothing is placed when the timeline changed since the caller read it. Latest answers the number and text of the latest content of a kind in a timeline, found being false when there is none. Share places a content that exists in one more timeline and answers its number there. Each operation composes the services of the text, content and timeline modules, given to it; none of them calls another.")(s, VoidError)
}

tp UserActionNote mt (self Conversation) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conversation) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
