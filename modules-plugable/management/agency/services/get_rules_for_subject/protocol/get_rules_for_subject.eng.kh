tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Rules_For_Subject in "./get_rules_for_subject.kh"

tp Domain mt (self Get_Rules_For_Subject) () (s String) {
	CharacterRun_From.FromCharacterRun("ai")(s, VoidError)
}

tp Name mt (self Get_Rules_For_Subject) () (s String) {
	CharacterRun_From.FromCharacterRun("get rules for subject")(s, VoidError)
}
