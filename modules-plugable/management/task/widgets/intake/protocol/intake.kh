tp CharacterRun in "modules/computer/codec/character/protocol/character-run.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Text in "modules/knowledge/text/protocol/dt-text.kh"
tp Text_Field_Preds in "modules-plugable/knowledge/text/retrieval/protocol/text-field-preds.kh"
tp Text_Index_Hits in "modules-plugable/knowledge/text/retrieval/services/score-text-index/protocol/text-index-hits.kh"
tp Text_Holders in "modules/knowledge/text/protocol/text-holders.kh"
tp Text_Find_Holders in "modules-plugable/knowledge/text/retrieval/widgets/text-find-holders/protocol/text-find-holders.kh"
tp Observer_Task_Identifier in "modules/management/task/protocol/identifier.observers.kh"

tp Intake ab {
	Text_Find_Holders
	Observer_Task_Identifier
}

tp Open mt (self Intake) (text Text, excluded Text_Holders, limit NumberOfElement, preds Text_Field_Preds, title CharacterRun, project CharacterRun) (hits Text_Index_Hits, err Error)
