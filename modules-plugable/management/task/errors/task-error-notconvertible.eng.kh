tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Error_NotConvertible in "modules-plugable/management/task/errors/predecessor.kh"

tp Domain mt (self Task_Error_NotConvertible) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Error_NotConvertible) () (s String) {
    CharacterRun_From.FromCharacterRun("The task cannot be converted")(s, VoidError)
}

tp Overview mt (self Task_Error_NotConvertible) () (s String) {
    CharacterRun_From.FromCharacterRun("The conversion service refused the task: its answers after the change would differ from its answers before it. Nothing was changed.")(s, VoidError)
}

tp UserActionNote mt (self Task_Error_NotConvertible) () (s String) {
    CharacterRun_From.FromCharacterRun("Leave the task to the module that wrote it.")(s, VoidError)
}

tp DevActionNote mt (self Task_Error_NotConvertible) () (s String) {
    CharacterRun_From.FromCharacterRun("Reported in the refused count of a step; the task is as it was.")(s, VoidError)
}
