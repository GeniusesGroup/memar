tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Error_NotFound in "modules-plugable/management/task/errors/store.kh"

tp Domain mt (self Task_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("The task does not exist")(s, VoidError)
}

tp Overview mt (self Task_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("No task with this identifier is kept in the project, so none of its facts can be read or replaced.")(s, VoidError)
}

tp UserActionNote mt (self Task_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("Check the task identifier and the project.")(s, VoidError)
}

tp DevActionNote mt (self Task_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("A caller fault; nothing was written.")(s, VoidError)
}
