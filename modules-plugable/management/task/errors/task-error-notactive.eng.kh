tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Error_NotActive in "modules-plugable/management/task/errors/status.kh"

tp Domain mt (self Task_Error_NotActive) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Error_NotActive) () (s String) {
    CharacterRun_From.FromCharacterRun("Only an active task is queued")(s, VoidError)
}

tp Overview mt (self Task_Error_NotActive) () (s String) {
    CharacterRun_From.FromCharacterRun("The task is in another state than active, so queuing it would put a task being worked or finished back in line.")(s, VoidError)
}

tp UserActionNote mt (self Task_Error_NotActive) () (s String) {
    CharacterRun_From.FromCharacterRun("Leave the task as it is.")(s, VoidError)
}

tp DevActionNote mt (self Task_Error_NotActive) () (s String) {
    CharacterRun_From.FromCharacterRun("A caller fault; nothing was written.")(s, VoidError)
}
