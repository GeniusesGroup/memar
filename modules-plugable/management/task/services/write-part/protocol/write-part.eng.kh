tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_WritePart in "modules-plugable/management/task/services/write-part/protocol/write-part.kh"

tp Domain mt (self Task_WritePart) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}
tp Summary mt (self Task_WritePart) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes a task part relation")(s, VoidError)
}
tp Overview mt (self Task_WritePart) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes a part-of edge and its reverse together. The caller checks the applicable policies and whether the relation already exists.")(s, VoidError)
}
tp UserActionNote mt (self Task_WritePart) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
tp DevActionNote mt (self Task_WritePart) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
