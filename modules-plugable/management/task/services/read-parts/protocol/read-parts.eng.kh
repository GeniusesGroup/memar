tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_ReadParts in "modules-plugable/management/task/services/read-parts/protocol/read-parts.kh"

tp Domain mt (self Task_ReadParts) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}
tp Summary mt (self Task_ReadParts) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the parts of a task")(s, VoidError)
}
tp Overview mt (self Task_ReadParts) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the task identifiers on the reverse side of the part-of relation. A graph failure is returned to the caller rather than treated as an empty set of parts.")(s, VoidError)
}
tp UserActionNote mt (self Task_ReadParts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
tp DevActionNote mt (self Task_ReadParts) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
