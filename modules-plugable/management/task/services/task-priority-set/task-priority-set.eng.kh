tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Priority_Set in "modules-plugable/management/task/services/task-priority-set/task-priority-set.kh"

tp Domain mt (self Task_Priority_Set) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Priority_Set) () (s String) {
    CharacterRun_From.FromCharacterRun("Sets the priority of a task")(s, VoidError)
}

tp Overview mt (self Task_Priority_Set) () (s String) {
    CharacterRun_From.FromCharacterRun("Replaces the one fact, against the version the caller read, and nothing else of the task. A caller that read a different version is refused by the store.")(s, VoidError)
}

tp UserActionNote mt (self Task_Priority_Set) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Priority_Set) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
