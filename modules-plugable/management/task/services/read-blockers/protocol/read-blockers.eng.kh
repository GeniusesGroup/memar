tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_ReadBlockers in "modules-plugable/management/task/services/read-blockers/protocol/read-blockers.kh"

tp Domain mt (self Task_ReadBlockers) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}
tp Summary mt (self Task_ReadBlockers) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the tasks a task depends on")(s, VoidError)
}
tp Overview mt (self Task_ReadBlockers) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads the blocked-by relation of a task. A graph failure is returned to the caller rather than treated as an empty set of dependencies.")(s, VoidError)
}
tp UserActionNote mt (self Task_ReadBlockers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
tp DevActionNote mt (self Task_ReadBlockers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
