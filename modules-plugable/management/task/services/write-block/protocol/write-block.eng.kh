tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_WriteBlock in "modules-plugable/management/task/services/write-block/protocol/write-block.kh"

tp Domain mt (self Task_WriteBlock) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}
tp Summary mt (self Task_WriteBlock) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes a task blocking relation")(s, VoidError)
}
tp Overview mt (self Task_WriteBlock) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes a blocks edge and its reverse together. The caller checks the applicable policies and whether the relation already exists.")(s, VoidError)
}
tp UserActionNote mt (self Task_WriteBlock) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
tp DevActionNote mt (self Task_WriteBlock) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
