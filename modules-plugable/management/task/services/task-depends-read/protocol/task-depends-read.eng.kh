tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Depends_On in "modules-plugable/management/task/services/task-depends-read/protocol/task-depends-read.kh"

tp Domain mt (self Get_Depends_On) () (s String) {
	CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Get_Depends_On) () (s String) {
	CharacterRun_From.FromCharacterRun("Reads the tasks a task cannot start without")(s, VoidError)
}

tp Overview mt (self Get_Depends_On) () (s String) {
	CharacterRun_From.FromCharacterRun("One call reads the citations the task depends on, and the version of that record. Empty citations mean the task depends on none. The service does not resolve a project, check that a cited task exists, or refuse a cycle.")(s, VoidError)
}

tp UserActionNote mt (self Get_Depends_On) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Depends_On) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
