tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Predecessor_Adapter in "modules-plugable/management/task/protocol/task-predecessor-adapter.kh"

tp Domain mt (self Task_Predecessor_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Predecessor_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("The only entrance to the generation of the task module before this one")(s, VoidError)
}

tp Overview mt (self Task_Predecessor_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("Answers a read of a task written by the predecessor by calling the predecessor's services that read, and gives the answer in this module's shape. It reaches no service that writes, and fails only with the error of a call on a datum of its writer.")(s, VoidError)
}

tp UserActionNote mt (self Task_Predecessor_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Predecessor_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("The predecessor's own adapter is its entrance to the generation before it; a chain of adapters reaches the first generation.")(s, VoidError)
}
