tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Citations in "modules-plugable/management/task/protocol/task-citations.kh"

tp Domain mt (self Task_Citations) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Citations) () (s String) {
    CharacterRun_From.FromCharacterRun("The citations a task holds under one relation")(s, VoidError)
}

tp Overview mt (self Task_Citations) () (s String) {
    CharacterRun_From.FromCharacterRun("An ordered list of citations, each task once, in the order written.")(s, VoidError)
}

tp UserActionNote mt (self Task_Citations) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Citations) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
