tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Reader in "modules-plugable/management/task/protocol/task-reader.kh"

tp Domain mt (self Task_Reader) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Reader) () (s String) {
    CharacterRun_From.FromCharacterRun("What a task's current plan and report say")(s, VoidError)
}

tp Overview mt (self Task_Reader) () (s String) {
    CharacterRun_From.FromCharacterRun("The reads of a task whose answer is its current plan and its current report, in the shape of the current task module. The current module serves a task it wrote; the adapter serves a task its predecessor wrote, and a caller cannot tell which answered.")(s, VoidError)
}

tp UserActionNote mt (self Task_Reader) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Reader) () (s String) {
    CharacterRun_From.FromCharacterRun("Both implementations answer the same reads; a core never inspects the form of the data it is given.")(s, VoidError)
}
