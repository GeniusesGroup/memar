tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Labels_Store in "modules-plugable/management/task/protocol/task-labels-store.kh"

tp Domain mt (self Task_Labels_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Labels_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Where the labels of a task are kept, read and replaced")(s, VoidError)
}

tp Overview mt (self Task_Labels_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The only way the labels of a task are read or replaced, given to a service and never opened as a file by one. The labels are the label module's Labels; a replace expecting a version that changed meanwhile is the store's refusal.")(s, VoidError)
}

tp UserActionNote mt (self Task_Labels_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Labels_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
