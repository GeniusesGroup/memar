tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Content_Store in "modules-plugable/management/task/protocol/task-content-store.kh"

tp Domain mt (self Task_Content_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Content_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Where the contents of a task are kept, read and added")(s, VoidError)
}

tp Overview mt (self Task_Content_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The only way a content of a task is read or added, given to a service; a store calls no other store. A content is any text of the task: its kind is a label of the label module and names the template the caller wrote it to (a plan, a report, a change record, a message of a person, any other); the store reads none of it. ReadLatestContent returns the highest-numbered content of a kind, found being false when the task holds none of that kind. AddContent puts the text as the next content, numbered after every content of the task, and never over one that is there; after is the number of the latest content of that kind the caller read, zero when it read none, and a store that holds a later one of that kind refuses with Task_Error_Changed. A task that does not exist is Task_Error_NotFound. How a content is kept is the realization's.")(s, VoidError)
}

tp UserActionNote mt (self Task_Content_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Content_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
