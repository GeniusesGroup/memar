tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Observer_Task_Type in "modules-plugable/management/task/protocol/task-type.observers.kh"
tp Observer_Predecessor_Type in "modules-plugable/management/task/protocol/predecessor-type.observers.kh"
tp Domain mt (self Observer_Task_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Observer_Task_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("The identity of the current task module")(s, VoidError)
}

tp Overview mt (self Observer_Task_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("The Type_Identifier of the module that owns the stored shape of a task now in force; the stamp of every task that module writes. The value is given by the realization in one place. When the module whose shape is the facts of one thing (texts as contents of their own) is that module, the value is fec2d0e7-eb2b-4179-9f94-2b38b956849f. The old module names nothing of the new one.")(s, VoidError)
}

tp UserActionNote mt (self Observer_Task_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Observer_Task_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp Domain mt (self Observer_Predecessor_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Observer_Predecessor_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("The identity of the generation before the current task module")(s, VoidError)
}

tp Overview mt (self Observer_Predecessor_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("The Type_Identifier of the module that owned the shape before the current one and is EndOfLife; a task with no stamp is counted as written by the first generation. The value is given by the realization in one place. When the retired place-shaped facts module is current, that predecessor is 6e94ed31-f133-485c-a3c0-72def253b37b.")(s, VoidError)
}

tp UserActionNote mt (self Observer_Predecessor_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Observer_Predecessor_Type) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
