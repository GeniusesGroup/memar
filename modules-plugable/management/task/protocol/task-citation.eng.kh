tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Citation in "modules-plugable/management/task/protocol/task-citation.kh"

tp Domain mt (self Task_Citation) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Citation) () (s String) {
    CharacterRun_From.FromCharacterRun("A task another task cites, with the project it is of")(s, VoidError)
}

tp Overview mt (self Task_Citation) () (s String) {
    CharacterRun_From.FromCharacterRun("How a task holds a reference to another task: the task identifier, and the name of the project it is of when it is written, named being false when the task is of the same project. That a citation means depends-on or part-of is an edge of the task kernel, which this type does not declare; resolving the project, checking that the task exists and refusing a cycle are the task domain's and not this type's.")(s, VoidError)
}

tp UserActionNote mt (self Task_Citation) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Citation) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
