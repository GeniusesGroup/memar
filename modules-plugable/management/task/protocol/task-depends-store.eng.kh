tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Task_Depends_Store in "modules-plugable/management/task/protocol/task-depends-store.kh"

tp Domain mt (self Task_Depends_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Task")(s, VoidError)
}

tp Summary mt (self Task_Depends_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Where the tasks a task cannot start without are kept, read and replaced")(s, VoidError)
}

tp Overview mt (self Task_Depends_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The only way what a task depends on is read or replaced. Empty citations mean the task depends on none.")(s, VoidError)
}

tp UserActionNote mt (self Task_Depends_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Task_Depends_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
