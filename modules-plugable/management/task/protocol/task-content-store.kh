tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Label in "modules/knowledge/label/protocol/label.kh"
tp Project in "modules/process/project/protocol/project.kh"
tp Text in "modules/knowledge/text/protocol/dt-text.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
