tp Task_Content_Store ab

tp ReadLatestContent mt (self Task_Content_Store) (project Project, task ThingUUID, kind Label) (number W32, text Text, found Boolean, err Error)

tp AddContent mt (self Task_Content_Store) (project Project, task ThingUUID, kind Label, text Text, author ThingUUID, after W32) (number W32, err Error)
