tp Observer_RequestID in "memar/modules/process/request/protocol/dt-uuid.observers.kh"
tp Observer_Time_Request in "memar/modules/process/time/protocol/dt-request.observers.kh"

tp Observer_PricePayable_Price ab

tp GetPrice mt (self Observer_PricePayable_Price) () (a Amount)

tp PricePayableDataModel ab {
	Field_ProductID
	Field_CountUnitID
	Observer_PricePayable_Price
	Observer_RequestID
	Observer_Time_Request
}

