tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"
tp PricePayableDataModel in "modules-plugable/economics/discount/analytics/price-payable/protocol/data_model.kh"

tp PricePayableStorage ab

tp Save mt (self PricePayableStorage) (dm PricePayableDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self PricePayableStorage) (productID ThingUUID, countUnitID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self PricePayableStorage) (productID ThingUUID, countUnitID ThingUUID, vo VersionOffset) (dm PricePayableDataModel, nv NumberOfVersion, err Error)

