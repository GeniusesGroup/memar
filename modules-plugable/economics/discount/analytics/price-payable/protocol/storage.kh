tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp Product_Identifier in "modules/economics/product/protocol/identifier.kh"
tp CountUnit_Identifier in "modules/identity/thing/edges/count_unit/protocol/identifier.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"
tp PricePayableDataModel in "modules-plugable/economics/discount/analytics/price-payable/protocol/data_model.kh"

tp PricePayableStorage ab

tp Save mt (self PricePayableStorage) (dm PricePayableDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self PricePayableStorage) (productID Product_Identifier, countUnitID CountUnit_Identifier) (nv NumberOfVersion, err Error)

tp Get mt (self PricePayableStorage) (productID Product_Identifier, countUnitID CountUnit_Identifier, vo VersionOffset) (dm PricePayableDataModel, nv NumberOfVersion, err Error)

