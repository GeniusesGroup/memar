tp Observer_DiscountUsageUtcDay_TotalRedeemed ab

tp GetTotalRedeemed mt (self Observer_DiscountUsageUtcDay_TotalRedeemed) () (n U64)

tp Observer_DiscountUsageUtcDay_TotalRedeemedAmount ab

tp GetTotalRedeemedAmount mt (self Observer_DiscountUsageUtcDay_TotalRedeemedAmount) () (a Amount)

tp DiscountUsageUtcDayDataModel ab {
	Observer_Utc_DayElapsed
	Observer_DiscountUsageUtcDay_TotalRedeemed
	Observer_DiscountUsageUtcDay_TotalRedeemedAmount
	Observer_RequestID
	Observer_Time_Request
}

