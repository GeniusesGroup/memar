tp DiscountUsageUtcMinuteDataModel ab {
	Observer_MinuteElapsed
	Observer_DiscountUsageUtcMinute_TotalRedeemed
	Observer_DiscountUsageUtcMinute_TotalRedeemedAmount
	Observer_Time_Request
}

