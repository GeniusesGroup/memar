tp U64 in "memar/modules/math/integer/unsigned-64.kh"
tp Amount in "modules-plugable/economics/money/protocol/dt-money-amount.kh"
tp Discount_Type in "modules-plugable/economics/discount/protocol/dt-type.kh"
tp Field_ProductID in "modules/economics/product/protocol/dt-uuid.kh"

tp Discount_Product ab {
	Field_ProductID
}

tp MinAmount mt (self Discount_Product) () (n U64)

tp MaxAmount mt (self Discount_Product) () (n U64)

tp MinPrice mt (self Discount_Product) () (a Amount)

tp MinStock mt (self Discount_Product) () (n U64)

tp Type mt (self Discount_Product) () (t Discount_Type)

