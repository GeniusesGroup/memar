tp Amount in "modules-plugable/economics/money/protocol/dt-money-amount.kh"
tp Observer_Each in "modules-plugable/economics/voucher/protocol/each.observers.kh"
tp Observer_Invoice_Identifier in "modules/economics/invoice/protocol/identifier.observers.kh"
tp Observer_InvoiceType in "modules-plugable/economics/voucher/protocol/invoice-type.observers.kh"
tp U64 in "modules/math/integer/unsigned-64.kh"

tp Voucher_Invoice_Condition ab {
	Observer_Each
}

tp MinPrice mt (self Voucher_Invoice_Condition) () (a Amount)

tp MinAmount mt (self Voucher_Invoice_Condition) () (n U64)

tp Voucher_Invoice_ID ab {
	Observer_Invoice_Identifier
}

tp Voucher_Invoice_Type ab {
	Observer_InvoiceType
}

tp Voucher_Invoice_MaxUsage ab

tp MaximumInvoice mt (self Voucher_Invoice_MaxUsage) () (n U64)

