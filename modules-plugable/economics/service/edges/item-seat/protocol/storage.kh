tp NumberOfVersion in "memar/modules/computer/memory/protocol/version.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp VersionOffset in "memar/modules/computer/memory/protocol/version.kh"

tp ItemSeatStorage ab

tp Save mt (self ItemSeatStorage) (dm ItemSeatDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self ItemSeatStorage) (invoiceID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self ItemSeatStorage) (invoiceID ThingUUID, vo VersionOffset) (dm ItemSeatDataModel, nv NumberOfVersion, err Error)

