tp Field_ProductID in "modules/economics/product/protocol/dt-uuid.kh"
tp Field_Service_Seat_Type in "modules-plugable/economics/service/edges/seat/protocol/dt-type.kh"
tp Observer_RequestID in "modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"
tp RecordUUID in "modules-plugable/computer/memory/store/record/protocol/uuid.kh"
tp U64 in "modules/math/integer/unsigned-64.kh"

tp Observer_Seat_SeatCapacity ab

tp GetSeatCapacity mt (self Observer_Seat_SeatCapacity) () (n U64)

tp Observer_Seat_MapID ab

tp GetMapID mt (self Observer_Seat_MapID) () (m RecordUUID)

tp SeatDataModel ab {
	Field_ProductID
	Field_Service_Seat_Type
	Observer_Seat_SeatCapacity
	Observer_Seat_MapID
	Observer_RequestID
	Observer_Time_Request
}

