tp Array_ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp SeatDataModel in "modules-plugable/economics/service/edges/seat/protocol/data_model.kh"
tp Service_Seat_Type in "modules-plugable/economics/service/edges/seat/protocol/dt-type.kh"
tp RecordUUID in "modules-plugable/computer/memory/store/record/protocol/uuid.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp SeatStorage ab

tp Save mt (self SeatStorage) (dm SeatDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self SeatStorage) (productID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self SeatStorage) (productID ThingUUID, vo VersionOffset) (dm SeatDataModel, nv NumberOfVersion, err Error)

tp FindProductIDsByMapID mt (self SeatStorage) (mapID RecordUUID, offset Container_Offset, limit Container_Limit) (productIDs Array_ThingUUID, nv NumberOfVersion, err Error)

tp FilterProductIDsBySeatType mt (self SeatStorage) (t Service_Seat_Type, offset Container_Offset, limit Container_Limit) (productIDs Array_ThingUUID, nv NumberOfVersion, err Error)

