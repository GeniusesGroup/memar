tp MultipleUseStorage ab

tp Save mt (self MultipleUseStorage) (dm MultipleUseDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self MultipleUseStorage) (productID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self MultipleUseStorage) (productID ThingUUID, vo VersionOffset) (dm MultipleUseDataModel, nv NumberOfVersion, err Error)

