tp MultipleUseStorage ab

tp Save mt (self MultipleUseStorage) (dm MultipleUseDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self MultipleUseStorage) (productID Product_Identifier) (nv NumberOfVersion, err Error)

tp Get mt (self MultipleUseStorage) (productID Product_Identifier, vo VersionOffset) (dm MultipleUseDataModel, nv NumberOfVersion, err Error)

