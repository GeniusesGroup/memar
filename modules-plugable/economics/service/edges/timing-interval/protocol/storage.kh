tp TimingIntervalStorage ab

tp Save mt (self TimingIntervalStorage) (dm TimingIntervalDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self TimingIntervalStorage) (productID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self TimingIntervalStorage) (productID ThingUUID, vo VersionOffset) (dm TimingIntervalDataModel, nv NumberOfVersion, err Error)

