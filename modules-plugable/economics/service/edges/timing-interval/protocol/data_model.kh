tp Observer_Time_Request in "memar/modules/process/time/protocol/dt-request.observers.kh"

tp Observer_TimingInterval_Minimum ab {
	Observer_Duration_Second
}

tp Observer_TimingInterval_Expected ab {
	Observer_Duration_Second
}

tp Observer_TimingInterval_Maximum ab {
	Observer_Duration_Second
}

tp TimingIntervalDataModel ab {
	Field_ProductID
	Observer_TimingInterval_Minimum
	Observer_TimingInterval_Expected
	Observer_TimingInterval_Maximum
	Observer_RequestID
	Observer_Time_Request
}

