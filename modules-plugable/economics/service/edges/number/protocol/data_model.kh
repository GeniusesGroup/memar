tp Decimal_Quantity in "modules/math/decimal/protocol/quantity.kh"
tp Field_ProductID in "modules/economics/product/protocol/dt-uuid.kh"
tp Observer_RequestID in "modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"

tp Observer_Number_Minimum ab

tp GetMinimum mt (self Observer_Number_Minimum) () (q Decimal_Quantity)

tp Observer_Number_Maximum ab

tp GetMaximum mt (self Observer_Number_Maximum) () (q Decimal_Quantity)

tp Observer_Number_MaximumInvoiceByBuy ab

tp GetMaximumInvoiceByBuy mt (self Observer_Number_MaximumInvoiceByBuy) () (q Decimal_Quantity)

tp NumberDataModel ab {
	Field_ProductID
	Observer_Number_Minimum
	Observer_Number_Maximum
	Observer_Number_MaximumInvoiceByBuy
	Observer_RequestID
	Observer_Time_Request
}

