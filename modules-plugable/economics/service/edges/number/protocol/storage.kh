tp Error in "modules/process/error/protocol/error.kh"
tp NumberDataModel in "modules-plugable/economics/service/edges/number/protocol/data_model.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp NumberStorage ab

tp Save mt (self NumberStorage) (dm NumberDataModel) (nv NumberOfVersion, err Error)

tp Count mt (self NumberStorage) (productID ThingUUID) (nv NumberOfVersion, err Error)

tp Get mt (self NumberStorage) (productID ThingUUID, vo VersionOffset) (dm NumberDataModel, nv NumberOfVersion, err Error)

