)

var registerProductInventoryService = service.Service{
	URN:                "urn:giti:sabz.city:service:register-product-inventory",
	Domain:             DomainName,
	ID:                 12325781733357796824,
	IssueDate:          1608124881,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDCreate,
		UserType: protocol.UserType_Org,
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Register Product Inventory",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"Product",
	},

	SRPCHandler: RegisterProductInventorySRPC,
	ServeHTTP:   RegisterProductInventoryHTTP,
}

// RegisterProductInventorySRPC is sRPC handler of RegisterProductInventory service.
func RegisterProductInventorySRPC(st protocol.Stream) {
	var req = &registerProductInventoryReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}

	err = registerProductInventory(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength)
}

// RegisterProductInventoryHTTP is HTTP handler of RegisterProductInventory service.
func RegisterProductInventoryHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &registerProductInventoryReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	err = registerProductInventory(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
}

type registerProductInventoryReq struct {
	QuiddityID   [32]byte          `json:",string"`
	Language     protocol.Language // Just use to check quiddity exist and belong to requested org
	ProductionID [32]byte          `json:",string"`
	Amount       int64
}

func registerProductInventory(st protocol.Stream, req *registerProductInventoryReq) (err protocol.Error) {
	// TODO::: remove below if condition without body of it, when all org ready to use platfrom
	if st.Connection.DelegateUserID != adminUserID {
		err = st.Authorize()
		if err != nil {
			return
		}
		return
	}

	// Check quiddity exits and belong to this Org
	var getQuiddityReq = getQuiddityReq{
		ID:       req.QuiddityID,
		Language: req.Language,
	}
	var getQuiddityRes *getQuiddityRes
	getQuiddityRes, err = getQuiddity(st, &getQuiddityReq)
	if err != nil {
		return
	}
	// TODO:::remove first condition of below if when all org ready to use platfrom separately
	if st.Connection.DelegateUserID != adminUserID && getQuiddityRes.OrgID != st.Connection.UserID {
		err = authorization.ErrUserNotAllow
		return
	}
	if getQuiddityRes.Status == data.QuiddityStatusBlocked {
		err = ErrBlockedByJustice
		return
	}

	var pi = data.ProductInventory{
		QuiddityID: req.QuiddityID,
		DCID:       st.Connection.UserID,
	}
	err = pi.LockByQuiddityIDDCID()
	if err.Equal(ganjine.ErrRecordNotFound) {
		err = nil
	}
	if err != nil {
		return
	}
	pi = data.ProductInventory{
		AppInstanceID:    achaemenid.App.Nodes.LocalNode.InstanceID,
		UserConnectionID: st.Connection.ID,
		OwnerID:          st.Connection.UserID,
		QuiddityID:       req.QuiddityID,
		Amount:           req.Amount,
		Balance:          pi.Balance + req.Amount,

		ReferenceID: req.ProductionID,
		DCID:        st.Connection.UserID, // product must register first in product owner OrgID and update it later.
		// ProductAuctionID: req.ProductAuctionID,
		// SellerID:         req.SellerID,
		Status: data.ProductInventoryRegister,
	}
	err = pi.UnLock()
	return
}

/*
	Request Encoders & Decoders
* /

func (req *registerProductInventoryReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.QuiddityID[:], buf[0:])
	req.Language = protocol.Language(syllab.GetUInt32(buf, 32))
	copy(req.ProductionID[:], buf[36:])
	req.Amount = syllab.GetInt64(buf, 68)
	return
}

func (req *registerProductInventoryReq) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[0:], req.QuiddityID[:])
	syllab.SetUInt32(buf, 32, uint32(req.Language))
	copy(buf[36:], req.ProductionID[:])
	syllab.SetInt64(buf, 68, req.Amount)
	return
}

func (req *registerProductInventoryReq) LenOfSyllabStack() uint32 {
	return 76
}

func (req *registerProductInventoryReq) LenOfSyllabHeap() (ln uint32) {
	return
}

func (req *registerProductInventoryReq) LenAsSyllab() uint64 {
	return uint64(req.LenOfSyllabStack() + req.LenOfSyllabHeap())
}

func (req *registerProductInventoryReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "QuiddityID":
			err = decoder.DecodeByteArrayAsBase64(req.QuiddityID[:])
		case "Language":
			var num uint32
			num, err = decoder.DecodeUInt32()
			req.Language = protocol.Language(num)
		case "ProductionID":
			err = decoder.DecodeByteArrayAsBase64(req.ProductionID[:])
		case "Amount":
			req.Amount, err = decoder.DecodeInt64()
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (req *registerProductInventoryReq) ToJSON(payload []byte) (added []byte, err protocol.Error) {
	var encoder = json.Encoder{Buf: payload}
	encoder.EncodeString(`{"QuiddityID":"`)
	encoder.EncodeByteSliceAsBase64(req.QuiddityID[:])
	encoder.EncodeString(`","Language":`)
	encoder.EncodeUInt32(uint32(req.Language))
	encoder.EncodeString(`,"ProductionID":"`)
	encoder.EncodeByteSliceAsBase64(req.ProductionID[:])
	encoder.EncodeString(`","Amount":`)
	encoder.EncodeInt64(req.Amount)
	encoder.EncodeByte('}')
	return encoder.Buf
}

func (req *registerProductInventoryReq) LenAsJSON() (ln int) {
	ln = 169
	return
}
