// FindRecordsIDsByQuiddityIDOwnerID find RecordsIDs by given QuiddityID+OwnerID
func (pi *ProductInventory) FindRecordsIDsByQuiddityIDOwnerID(offset, limit uint64) (RecordsIDs [][32]byte, err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: pi.hashQuiddityIDOwnerIDForRecordIDDaily(),
		Offset:   offset,
		Limit:    limit,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	RecordsIDs = indexRes.IndexValues
	return
}

// FindRecordsIDsByQuiddityIDDCID find RecordsIDs by given QuiddityID+DCID
func (pi *ProductInventory) FindRecordsIDsByQuiddityIDDCID(offset, limit uint64) (RecordsIDs [][32]byte, err protocol.Error) {
	// TODO:::
	pi.WriteTime = time.Now()
	var indexRequest = pehrest.HashGetValuesReq{
		IndexKey: pi.hashQuiddityIDDCIDForRecordIDDaily(),
		Offset:   offset,
		Limit:    limit,
	}
	var indexRes *pehrest.HashGetValuesRes
	for pi.WriteTime > 1608422400 { // 1608422400 = 12/20/2020 @ 12:00am (UTC) as Persian Yalda day that platfrom starts!
		indexRes, err = psdk.HashGetValues(&indexRequest)
		if err == nil {
			break
		}
		pi.WriteTime -= (24 * 60 * 60) // daily
		indexRequest.IndexKey = pi.hashQuiddityIDDCIDForRecordIDDaily()
	}
	if err != nil {
		return
	}
	RecordsIDs = indexRes.IndexValues
	return
}

// FindQuiddityIDsByDCID find QuiddityIDs by given DCID
func (pi *ProductInventory) FindQuiddityIDsByDCID(offset, limit uint64) (RecordsIDs [][32]byte, err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: pi.hashDCIDForQuiddityID(),
		Offset:   offset,
		Limit:    limit,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	RecordsIDs = indexRes.IndexValues
	return
}

