/*
	-- Syllab Encoder & Decoder --
* /

func (pi *ProductInventory) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < pi.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(pi.RecordID[:], buf[0:])
	pi.RecordStructureID = syllab.GetUInt64(buf, 32)
	pi.RecordSize = syllab.GetUInt64(buf, 40)
	pi.WriteTime = time.Time(syllab.GetInt64(buf, 48))
	copy(pi.OwnerAppID[:], buf[56:])

	copy(pi.AppInstanceID[:], buf[88:])
	copy(pi.UserConnectionID[:], buf[120:])
	copy(pi.OwnerID[:], buf[152:])
	copy(pi.QuiddityID[:], buf[184:])
	pi.Amount = syllab.GetInt64(buf, 216)
	pi.Balance = syllab.GetInt64(buf, 224)

	copy(pi.ReferenceID[:], buf[232:])
	copy(pi.DCID[:], buf[264:])
	copy(pi.ProductAuctionID[:], buf[296:])
	copy(pi.SellerID[:], buf[328:])
	pi.Status = ProductInventoryStatus(syllab.GetUInt8(buf, 360))
	return
}

func (pi *ProductInventory) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[88:], pi.AppInstanceID[:])
	copy(buf[120:], pi.UserConnectionID[:])
	copy(buf[152:], pi.OwnerID[:])
	copy(buf[184:], pi.QuiddityID[:])
	syllab.SetInt64(buf, 216, pi.Amount)
	syllab.SetInt64(buf, 224, pi.Balance)

	copy(buf[232:], pi.ReferenceID[:])
	copy(buf[264:], pi.DCID[:])
	copy(buf[296:], pi.ProductAuctionID[:])
	copy(buf[328:], pi.SellerID[:])
	syllab.SetUInt8(buf, 360, uint8(pi.Status))
	return
}

func (pi *ProductInventory) LenOfSyllabStack() uint32 {
	return 361
}

func (pi *ProductInventory) LenOfSyllabHeap() (ln uint32) {
	return
}

func (pi *ProductInventory) LenAsSyllab() uint64 {
	return uint64(pi.LenOfSyllabStack() + pi.LenOfSyllabHeap())
}

