// ProductInventoryStatus indicate Product record status
type ProductInventoryStatus uint8

// ProductInventory status
const (
	ProductInventoryNotSet   ProductInventoryStatus = iota
	ProductInventoryRegister                        // ReferenceID=ProductionID
	ProductInventoryReadyToSell
	ProductInventoryChangeDCRequested
	ProductInventoryChangeDCApproved
	ProductInventoryChangeQuiddity // Split to small size product! || Split from upper size product!
	ProductInventoryChangeOwner    // ReferenceID-Seller=UserID		ReferenceID-Buyer=DCID
	ProductInventoryVoid
	ProductInventoryPreSale // use in budget analysis and also can be trade!

	// 0x0 for non expire record, 0x1 for sell to first above SuggestPrice||buy first below it!

	// ManagerApprove
	// WarehouseApprove
	// ActiveWithApprove
	// ActiveWithoutApprove
	// ActiveWithOrderer
	// Inactive
	// Normal
	// Reject
)
