// IndexRecordIDForQuiddityIDOwnerIDDaily save RecordID chain for QuiddityID+OwnerID daily
func (pi *ProductInventory) IndexRecordIDForQuiddityIDOwnerIDDaily() {
	var indexRequest = pehrest.HashSetValueReq{
		Type:       ganjine.RequestTypeBroadcast,
		IndexKey:   pi.hashQuiddityIDOwnerIDForRecordIDDaily(),
		IndexValue: pi.RecordID,
	}
	var err = psdk.HashSetValue(&indexRequest)
	if err != nil {
		if protocol.LogMode_Debug {
			protocol.App.Log(log.DebugEvent(domainEnglish, "Ganjine - IndexRecordIDForQuiddityIDOwnerID:", err)
		}
		// TODO::: we must retry more due to record wrote successfully!
	}
}

func (pi *ProductInventory) hashQuiddityIDOwnerIDForRecordIDDaily() (hash [32]byte) {
	const field = "QuiddityID+OwnerID"
	var buf = make([]byte, 80+len(field)) // 8+32+32+8
	syllab.SetUInt64(buf, 0, productInventoryStructureID)
	copy(buf[8:], pi.QuiddityID[:])
	copy(buf[40:], pi.OwnerID[:])
	syllab.SetInt64(buf, 72, pi.WriteTime.RoundToDay())
	copy(buf[80:], field)
	return sha3.Sum256(buf)
}

