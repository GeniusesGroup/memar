const (
	productInventoryStructureID uint64 = 1086912575236019950 // 10842087306691562097
)

var productInventoryStructure = ds.DataStructure{
	URN:             "urn:giti:sabz.city:data-structure:product-inventory",
	ID:              1086912575236019950,
	IssueDate:       1599279351,
	ExpiryDate:      0,
	ExpireInFavorOf: "",
	Status:          protocol.Software_PreAlpha,
	Structure:       ProductInventory{},

	Detail: map[protocol.LanguageID]ds.DataStructureDetail{
		protocol.LanguageEnglish: {
			Name: "Product Inventory",
			Description: `store product(goods) inventory details!
The base chain is on QuiddityID+OwnerID that can retrieve by other indexes too. The base transaction chain is on QuidittyID+DCID.`,
			TAGS: []string{},
		},
	},
}

// ProductInventory ---Read locale description in productInventoryStructure---
type ProductInventory struct {
	RequestID      [32]byte // user-request domain
	QuiddityID     [16]byte `index-hash:"RecordID[pair,OwnerID,daily],OwnerID[not-exist]"`
	OwnerID        [16]byte `index-hash:"QuiddityID[daily,not-exist]"` // Who belong to! Just org can be first owner!
	ReferenceID    [16]byte // UserID that amount transfer, ProductOrderID
	Amount         int64    // this transaction
	Stock          int64    // overall
	// InventoryType  uint8    // Number||Gram||Liter
}

// Save save ProductInventory as raw record!
func (pi *ProductInventory) Save() (metadata protocol.ObjectMetadata, err protocol.Error) {
	metadata, err = protocol.App.ObjectDirectory().Save(pi)
	return
}

// SaveNew save ProductInventory record with all indexes!
func (pi *ProductInventory) SaveNew() (err protocol.Error) {
	err = pi.Save()
	if err != nil {
		return
	}
	pi.IndexRecordIDForQuiddityIDOwnerIDDaily()
	if pi.DCID != [32]byte{} {
		pi.IndexRecordIDForQuiddityIDDCIDDaily()
	}
	if pi.ProductAuctionID != [32]byte{} {
		pi.IndexRecordIDForProductAuctionIDDaily()
	}
	if pi.SellerID != [32]byte{} {
		pi.IndexRecordIDForSellerIDDaily()
	}
	pi.ListQuiddityIDForOwnerIDDaily()
	if pi.DCID != [32]byte{} {
		pi.ListDCIDForQuiddityID()
		pi.ListQuiddityIDForDCID()
	}
	return
}

// SaveInInvoice method set some data and write entire Product record with needed indexes for register invoice!
func (pi *ProductInventory) SaveInInvoice() (err protocol.Error) {
	err = pi.Save()
	if err != nil {
		return
	}
	pi.IndexRecordIDForQuiddityIDOwnerIDDaily()
	if pi.DCID != [32]byte{} {
		pi.IndexRecordIDForQuiddityIDDCIDDaily()
	}
	if pi.ProductAuctionID != [32]byte{} {
		pi.IndexRecordIDForProductAuctionIDDaily()
	}
	if pi.SellerID != [32]byte{} {
		pi.IndexRecordIDForSellerIDDaily()
	}
	pi.ListQuiddityIDForOwnerIDDaily()
	return
}

// GetByRecordID method read all existing record data by given RecordID!
func (pi *ProductInventory) GetByRecordID() (err protocol.Error) {
	var req = ganjine.GetRecordReq{
		RecordID:          pi.RecordID,
		RecordStructureID: productInventoryStructureID,
	}
	var res *ganjine.GetRecordRes
	res, err = gsdk.GetRecord(&req)
	if err != nil {
		return
	}

	err = pi.FromSyllab(res.Record)
	if err != nil {
		return
	}

	if pi.RecordStructureID != productInventoryStructureID {
		err = ganjine.ErrMisMatchedStructureID
	}
	return
}

/*
	-- Get Last Methods --
* /

// GetLastByQuiddityIDOwnerID find and read last version of record and lock it by given QuiddityID+OwnerID
func (pi *ProductInventory) GetLastByQuiddityIDOwnerID() (err protocol.Error) {
	pi.WriteTime = time.Now()
	var indexRequest = pehrest.HashGetValuesReq{
		IndexKey: pi.hashQuiddityIDOwnerIDForRecordIDDaily(),
		Offset:   18446744073709551615,
		Limit:    1,
	}
	var indexRes *pehrest.HashGetValuesRes
	for pi.WriteTime > 1608422400 { // 1608422400 = 12/20/2020 @ 12:00am (UTC) as Persian Yalda day that platfrom starts!
		indexRes, err = psdk.HashGetValues(&indexRequest)
		if err == nil {
			break
		}
		pi.WriteTime -= (24 * 60 * 60) // daily
		indexRequest.IndexKey = pi.hashQuiddityIDDCIDForRecordIDDaily()
	}
	if err != nil {
		return
	}

	pi.RecordID = indexRes.IndexValues[0]
	err = pi.GetByRecordID()
	if err.Equal(ganjine.ErrMisMatchedStructureID) {
		protocol.App.Log(log.WarnEvent(domainEnglish, "Platform collapsed!! HASH Collision Occurred on", productInventoryStructureID)
	}
	return
}

