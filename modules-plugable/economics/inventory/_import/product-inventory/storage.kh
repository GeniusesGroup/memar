// UnLock will unlock userID to let other services set new in-time transaction records!
func (pi *ProductInventory) UnLock() (err protocol.Error) {
	// TODO:::
	err = pi.SaveNew()
	if err != nil {
		return
	}
	return
}

// UnLockInInvoice will unlock userID to let other services set new in-time transaction records!
func (pi *ProductInventory) UnLockInInvoice() (err protocol.Error) {
	// TODO:::
	err = pi.SaveInInvoice()
	if err != nil {
		return
	}
	return
}

