tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Put_Rank in "modules-plugable/identity/thing/priority/services/put-rank/protocol/put-rank.kh"

tp Domain mt (self Put_Rank) () (s String) {
	CharacterRun_From.FromCharacterRun("Priority")(s, VoidError)
}

tp Summary mt (self Put_Rank) () (s String) {
	CharacterRun_From.FromCharacterRun("Sets the rank a thing carries")(s, VoidError)
}

tp Overview mt (self Put_Rank) () (s String) {
	CharacterRun_From.FromCharacterRun("The thing carries the rank the request names. It writes no label.")(s, VoidError)
}

tp UserActionNote mt (self Put_Rank) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Put_Rank) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
