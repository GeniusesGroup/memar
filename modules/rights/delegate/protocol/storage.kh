tp Array_Dynamic in "modules/computer/adt/array/protocol/dynamic.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp DelegateDataModel in "modules/rights/delegate/protocol/data_model.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp NumberOfVersion in "modules/computer/memory/version/protocol/version.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"
tp VersionOffset in "modules/computer/memory/version/protocol/version.kh"

tp Array_DelegateRuleUUID ab {
	Array_Dynamic
}

tp Array_GivenDelegateUserUUID ab {
	Array_Dynamic
}

tp Array_GottenDelegateUserUUID ab {
	Array_Dynamic
}

tp DelegateStorage ab

tp Save mt (self DelegateStorage) (ud DelegateDataModel) (n NumberOfVersion, e Error)

tp Count mt (self DelegateStorage) (givenUserID UserUUID, gottenUserID UserUUID, ruleID ThingUUID) (n NumberOfVersion, e Error)

tp Get mt (self DelegateStorage) (givenUserID UserUUID, gottenUserID UserUUID, ruleID ThingUUID, vo VersionOffset) (d DelegateDataModel, n NumberOfVersion, e Error)

tp ListRoles mt (self DelegateStorage) (givenUserID UserUUID, gottenUserID UserUUID, offset Container_Offset, limit Container_Limit) (r Array_DelegateRuleUUID, n NumberOfVersion, e Error)

tp ListGottenUsers mt (self DelegateStorage) (ruleID ThingUUID, offset Container_Offset, limit Container_Limit) (o Array_GottenDelegateUserUUID, n NumberOfVersion, e Error)

tp ListGivenUsers mt (self DelegateStorage) (ruleID ThingUUID, offset Container_Offset, limit Container_Limit) (g Array_GivenDelegateUserUUID, n NumberOfVersion, e Error)

tp ListGottenDelegateUsers mt (self DelegateStorage) (gottenUserID UserUUID, offset Container_Offset, limit Container_Limit) (g Array_GivenDelegateUserUUID, n NumberOfVersion, e Error)

tp ListGivenDelegateUsers mt (self DelegateStorage) (givenUserID UserUUID, offset Container_Offset, limit Container_Limit) (o Array_GottenDelegateUserUUID, n NumberOfVersion, e Error)

