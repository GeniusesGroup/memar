tp Array_Dynamic in "memar/modules/computer/adt/array/protocol/dynamic.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"

tp Field_ContractTermsLabel ab

tp ContractTermsLabel mt (self Field_ContractTermsLabel) () (t ThingUUID)

tp Field_ContractTermsValue ab

tp ContractTermsValue mt (self Field_ContractTermsValue) () (t ThingUUID)

tp Field_ContractTermsModule ab

tp ContractTermsModule mt (self Field_ContractTermsModule) () (t ThingUUID)

tp ContractTermsData ab {
	Field_ContractTermsLabel
	Field_ContractTermsValue
	Field_ContractTermsModule
}

tp Array_ContractTermsData ab {
	Array_Dynamic
}

tp Field_ContractTerms ab

tp ContractTerms mt (self Field_ContractTerms) () (d Array_ContractTermsData)

