tp Field_ContractID in "modules/rights/contract/protocol/dt-uuid.kh"
tp Myriad in "memar/modules/math/per/myriad.kh"
tp ThingUUID in "modules/identity/thing/protocol/dt-uuid.kh"
tp UserUUID in "modules/identity/user/protocol/dt-uuid.kh"

tp Field_ExpertID ab

tp ExpertID mt (self Field_ExpertID) () (u UserUUID)

tp Field_Opinion ab

tp Opinion mt (self Field_Opinion) () (t ThingUUID)

tp Field_Progress ab

tp Progress mt (self Field_Progress) () (p Myriad)

tp ContractExpertOpinion ab {
	Field_ContractID
	Field_ExpertID
	Field_Opinion
	Field_Progress
}

