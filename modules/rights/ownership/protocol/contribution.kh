tp Thing_Identifier in "modules/identity/thing/protocol/identifier.kh"
tp User_Identifier in "modules/identity/user/protocol/identifier.kh"
tp UserKind in "modules/identity/user/protocol/dt-type.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp Contribution_Role ab
tp Contribution_Role_Name mt (self Contribution_Role) () (s String)

tp Contribution_Value ab
tp Contribution_Value_Via mt (self Contribution_Value) () (u User_Identifier)
tp Contribution_Value_Effort mt (self Contribution_Value) () (s String)

tp Contribution_Iterate ab
tp Contribution_Iterate_Next mt (self Contribution_Iterate) (thing Thing_Identifier, user User_Identifier, value Contribution_Value) (err Error)

tp Contribution_Kinds ab
tp Contribution_Kinds_Of mt (self Contribution_Kinds) (user User_Identifier) (kind UserKind, err Error)

tp Contributions ab
tp Contributions_Add mt (self Contributions) (role Contribution_Role, thing Thing_Identifier, user User_Identifier, value Contribution_Value) (err Error)
tp Contributions_Remove mt (self Contributions) (role Contribution_Role, thing Thing_Identifier, user User_Identifier) (err Error)
tp Contributions_UsersOf mt (self Contributions) (role Contribution_Role, thing Thing_Identifier, iterate Contribution_Iterate) (err Error)
tp Contributions_ThingsOf mt (self Contributions) (role Contribution_Role, user User_Identifier, iterate Contribution_Iterate) (err Error)

tp Contributions_Reading ab {
    Contributions
    Contribution_Kinds
}
tp Contributions_Reading_OnlyModelOrTool mt (self Contributions_Reading) (thing Thing_Identifier) (only Boolean, err Error)
tp Contributions_Reading_PersonConfirmed mt (self Contributions_Reading) (thing Thing_Identifier) (confirmed Boolean, err Error)
