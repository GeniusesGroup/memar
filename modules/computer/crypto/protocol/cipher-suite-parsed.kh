tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp String in "modules/codec/string/protocol/string.kh"
tp Stringer in "modules/codec/string/protocol/stringer.kh"
tp UUID_Hash in "modules/identifier/protocol/uuid.kh"

tp CipherSuite_Parsed ab {
    Stringer
    UUID_Hash
}
tp Protocol mt (self CipherSuite_Parsed) () (s String)

tp KeyExchange mt (self CipherSuite_Parsed) () (s String)

tp Authentication mt (self CipherSuite_Parsed) () (s String)

tp SessionCipher mt (self CipherSuite_Parsed) () (s String)

tp EncryptionKeySize mt (self CipherSuite_Parsed) () (s String)

tp EncryptionType mt (self CipherSuite_Parsed) () (s String)

tp Hash mt (self CipherSuite_Parsed) () (s String)

// Insecure is true if the cipher suite has known security issues
// due to its primitives, design, or implementation.
tp Insecure mt (self CipherSuite_Parsed) () (b Boolean)

