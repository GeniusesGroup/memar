func findUserAppConnectionByGivenDelegate(st protocol.Stream, req *findUserAppConnectionByGivenDelegateReq) (res *findUserAppConnectionByGivenDelegateRes, err error_p.Error) {
	err = st.Authorize()
	if err != nil {
		return
	}

	var uac = data.UserAppConnection{
		UserID: st.Connection.UserID,
	}
	var indexRes [][32]byte
	indexRes, err = uac.FindIDsByGivenDelegate(req.Offset, req.Limit)
	if err.Equal(ganjine.ErrRecordNotFound) {
		err = nil
	}
	if err != nil {
		return
	}

	res = &findUserAppConnectionByGivenDelegateRes{
		IDs: indexRes,
	}
	return
