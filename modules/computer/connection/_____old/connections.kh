// RegisterConnection register new connection in server connection pool
func (c *connections) RegisterConnection(conn protocol.Connection) {
	c.mutex.Lock()
	defer c.mutex.Unlock()
	c.poolByConnID[conn.ID] = conn
	if conn.GPAddr != AddrNil {
		c.poolByPeerAddr[conn.GPAddr] = conn
	}
	if conn.UserID != [32]byte{} {
		c.poolByUserID[conn.UserID] = append(c.poolByUserID[conn.UserID], conn)
	}
	if conn.UserType == user_p.Type_Unset {
		c.GuestConnectionCount++
	}
}

// CloseConnection un-register exiting connection in server connection pool
func (c *connections) CloseConnection(conn *Connection) {
	c.mutex.Lock()
	defer c.mutex.Unlock()
	if conn.UserType == user_p.Type_Unset {
		c.GuestConnectionCount--
	}

	// TODO::: Is it worth to don't delete connection just reset it and send it to pool of unused connection due to GC
	delete(c.poolByConnID, conn.ID)
	delete(c.poolByPeerAddr, conn.GPAddr)
	// delete(c.poolByUserID, conn.UserID)

	// Let unfinished stream handled
}

// RevokeConnection un-register exiting connection in server connection pool without given any time to finish any stream
func (c *connections) RevokeConnection(conn *Connection) {
	c.mutex.Lock()
	defer c.mutex.Unlock()
	if conn.UserType == user_p.Type_Unset {
		c.GuestConnectionCount--
	}

	// Remove all unfinished stream first

	delete(c.poolByConnID, conn.ID)
	delete(c.poolByPeerAddr, conn.GPAddr)
	// delete(c.poolByUserID, conn.UserID)
}

// get from platfrom resources
func (c *Connections) getConnectionByID(connID [32]byte) (conn protocol.Connection) {
	var err error_p.Error
	var uac = UserAppConnection{
		ID: connID,
	}
	err = uac.GetLastByID()
	if err != nil {
		return
	}
	return &uac
}

// getConnectionsByUserIDThingID returns available connection by given data
func (c *Connections) GetConnectionsByUserIDThingID(userID, thingID [32]byte) (conn protocol.Connection) {
	var err error_p.Error
	var uac = UserAppConnection{
		UserID:  userID,
		ThingID: thingID,
	}
	err = uac.GetLastByUserIDThingID()
	if err != nil {
		return
	}
	return &uac
}

// SaveConnection get a connection and save it its data by platform rules
func (c *Connections) SaveConnection(conn protocol.Connection) {
	var uac = UserAppConnection{
		/* Unique data * /
		AppInstanceID:    protocol.App.LocalNode().ID(),
		UserConnectionID: conn.ID(),
		Status:           UserAppConnectionUpdate,
		// Description:      conn.Description,

		/* Connection data * /
		ID:     conn.ID,
		Weight: conn.Weight,

		/* Peer data * /
		// Peer Location
		GPAddr:  conn.GPAddr,
		IPAddr:  conn.IPAddr,
		ThingID: conn.ThingID,
		// Peer Identifiers
		UserID:           conn.UserID,
		UserType:         conn.UserType,
		DelegateUserID:   conn.DelegateUserID,
		DelegateUserType: conn.DelegateUserType,

		/* Security data * /
		PeerPublicKey: conn.PeerPublicKey,
		AccessControl: conn.AccessControl,

		// Metrics data
		LastUsage:             conn.LastUsage,
		PacketPayloadSize:     conn.PacketPayloadSize,
		MaxBandwidth:          conn.MaxBandwidth,
		ServiceCallCount:      conn.ServiceCallCount,
		BytesSent:             conn.BytesSent,
		PacketsSent:           conn.PacketsSent,
		BytesReceived:         conn.BytesReceived,
		PacketsReceived:       conn.PacketsReceived,
		FailedPacketsReceived: conn.FailedPacketsReceived,
		FailedServiceCall:     conn.FailedServiceCall,
	}
	var err error_p.Error
	err = uac.Set()
	if err != nil {
		// TODO::: Handle error due to called by go keyword!!
	}
	uac.IndexRecordIDForID()
	if conn.State == protocol.ConnectionState_New {
		conn.State = protocol.ConnectionState_Loaded
		if conn.UserType == user_p.Type_Unset {
			uac.IndexIDForUserTypeDaily()
		} else {
			uac.IndexIDForUserID()
			if uac.ThingID != [32]byte{} {
				uac.IndexIDForThingID()
				uac.IndexIDForUserIDThingID()
				uac.ListThingIDForUserID()
				uac.ListUserIDForThingID()
			}
		}
	}
	return
}

func (c *Connections) Shutdown() {
	protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - ShutDown - connections saving proccess begin...")
	protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - ShutDown - Number of active connections:", len(c.poolByConnID))
	for _, conn := range c.poolByConnID {
		go c.SaveConnection(conn)
	}
	protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - ShutDown - connections saving proccess end now")
}

func (c *Connections) connectionIdleTimeoutSaveAndFree() {
	var timer = time.NewTimer(Server.Manifest.TechnicalInfo.ConnectionIdleTimeout.ConvertToTimeDuration())
	for {
		select {
		case <-timer.C:
			protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - Cron - Idle connections timeout save and free proccess begin...")
			protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - Cron - Number of active connections:", len(c.poolByConnID))
			// It is conccurent proccess and not take more than one or two second, so set timeNow here
			var timeNow = time.Now()

			c.mutex.Lock()
			defer c.mutex.Unlock()
			for _, conn := range c.poolByConnID {
				if !conn.LastUsage.AddDuration(Server.Manifest.TechnicalInfo.ConnectionIdleTimeout).Pass(timeNow) {
					continue
				}

				go c.SaveConnection(conn)

				if conn.UserType == user_p.Type_Unset {
					c.GuestConnectionCount--
				}
				// Remove all unfinished stream first
				delete(c.poolByConnID, conn.ID)
				delete(c.poolByPeerGPAddr, conn.GPAddr)
			}

			timer.Reset(Server.Manifest.TechnicalInfo.ConnectionIdleTimeout.ConvertToTimeDuration())
			protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - Cron - Number of active connections after:", len(c.poolByConnID))
			protocol.App.Log(log.InfoEvent(domainEnglish, "Achaemenid - Cron - Idle connections timeout save and free proccess end now")
		}
	}
}
*/
