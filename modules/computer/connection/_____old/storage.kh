/*
	-- Syllab Encoder & Decoder --
* /

func (uac *UserAppConnection) CheckSyllab(payload []byte) {
	if uint32(len(buf)) < uac.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}
	return
}

func (uac *UserAppConnection) FromSyllab(payload []byte, stackIndex uint32) {
	copy(uac.AppInstanceID[:], buf[88:])
	copy(uac.UserConnectionID[:], buf[120:])
	uac.Status = UserAppConnectionStatus(syllab.GetUInt8(buf, 152))
	uac.Description = syllab.UnsafeGetString(buf, 153)

	copy(uac.ID[:], buf[161:])
	uac.Weight = operation_p.Weight(syllab.GetUInt8(buf, 193))

	copy(uac.GPAddr[:], buf[194:])
	copy(uac.IPAddr[:], buf[208:])
	copy(uac.ThingID[:], buf[224:])

	copy(uac.UserID[:], buf[256:])
	uac.UserType = user_p.Type(syllab.GetUInt8(buf, 288))
	copy(uac.DelegateUserID[:], buf[289:])
	uac.DelegateUserType = user_p.Type(syllab.GetUInt8(buf, 321))

	copy(uac.PeerPublicKey[:], buf[322:])
	uac.AccessControl.FromSyllab(buf, 354)

	uac.LastUsage = time.Time(syllab.GetInt64(buf, 354+uac.AccessControl.LenOfSyllabStack()))
	uac.PacketPayloadSize = syllab.GetUInt16(buf, 362+uac.AccessControl.LenOfSyllabStack())
	uac.MaxBandwidth = syllab.GetUInt64(buf, 364+uac.AccessControl.LenOfSyllabStack())
	uac.ServiceCallCount = syllab.GetUInt64(buf, 372+uac.AccessControl.LenOfSyllabStack())
	uac.BytesSent = syllab.GetUInt64(buf, 380+uac.AccessControl.LenOfSyllabStack())
	uac.PacketsSent = syllab.GetUInt64(buf, 388+uac.AccessControl.LenOfSyllabStack())
	uac.BytesReceived = syllab.GetUInt64(buf, 396+uac.AccessControl.LenOfSyllabStack())
	uac.PacketsReceived = syllab.GetUInt64(buf, 404+uac.AccessControl.LenOfSyllabStack())
	uac.FailedPacketsReceived = syllab.GetUInt64(buf, 412+uac.AccessControl.LenOfSyllabStack())
	uac.FailedServiceCall = syllab.GetUInt64(buf, 420+uac.AccessControl.LenOfSyllabStack())
	return
}

func (uac *UserAppConnection) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[88:], uac.AppInstanceID[:])
	copy(buf[120:], uac.UserConnectionID[:])
	syllab.SetUInt8(buf, 152, uint8(uac.Status))
	heapIndex = syllab.SetString(buf, uac.Description, 153, heapIndex)

	copy(buf[161:], uac.ID[:])
	syllab.SetUInt8(buf, 193, uint8(uac.Weight))

	copy(buf[194:], uac.GPAddr[:])
	copy(buf[208:], uac.IPAddr[:])
	copy(buf[224:], uac.ThingID[:])

	copy(buf[256:], uac.UserID[:])
	syllab.SetUInt8(buf, 288, uint8(uac.UserType))
	copy(buf[289:], uac.DelegateUserID[:])
	syllab.SetUInt8(buf, 321, uint8(uac.DelegateUserType))

	copy(buf[322:], uac.PeerPublicKey[:])
	uac.AccessControl.ToSyllab(buf, 354, heapIndex)

	syllab.SetInt64(buf, 354+uac.AccessControl.LenOfSyllabStack(), int64(uac.LastUsage))
	syllab.SetUInt16(buf, 362+uac.AccessControl.LenOfSyllabStack(), uac.PacketPayloadSize)
	syllab.SetUInt64(buf, 364+uac.AccessControl.LenOfSyllabStack(), uac.MaxBandwidth)
	syllab.SetUInt64(buf, 372+uac.AccessControl.LenOfSyllabStack(), uac.ServiceCallCount)
	syllab.SetUInt64(buf, 380+uac.AccessControl.LenOfSyllabStack(), uac.BytesSent)
	syllab.SetUInt64(buf, 388+uac.AccessControl.LenOfSyllabStack(), uac.PacketsSent)
	syllab.SetUInt64(buf, 396+uac.AccessControl.LenOfSyllabStack(), uac.BytesReceived)
	syllab.SetUInt64(buf, 404+uac.AccessControl.LenOfSyllabStack(), uac.PacketsReceived)
	syllab.SetUInt64(buf, 412+uac.AccessControl.LenOfSyllabStack(), uac.FailedPacketsReceived)
	syllab.SetUInt64(buf, 420+uac.AccessControl.LenOfSyllabStack(), uac.FailedServiceCall)
	return
}

func (uac *UserAppConnection) LenOfSyllabStack() uint32 {
	return 428 + uac.AccessControl.LenOfSyllabStack()
}

func (uac *UserAppConnection) LenOfSyllabHeap() (ln uint32) {
	ln = uint32(len(uac.Description))
	ln += uac.AccessControl.LenOfSyllabHeap()
	return
}

func (uac *UserAppConnection) LenAsSyllab() uint64 {
	return uint64(uac.LenOfSyllabStack() + uac.LenOfSyllabHeap())
}

/*
	-- Record types --
* /

// UserAppConnectionStatus use to indicate UserAppConnection record status
type UserAppConnectionStatus uint8

// UserAppConnection status
const (
	UserAppConnectionUnset UserAppConnectionStatus = iota
	UserAppConnectionIssued
	UserAppConnectionUpdate
	UserAppConnectionExpired
	UserAppConnectionRevoked
)
*/
