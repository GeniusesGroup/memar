tp Boolean in "memar/modules/math/boolean/protocol/boolean.kh"

tp Observer_AcceptedEmail ab

tp GetAcceptedEmail mt (self Observer_AcceptedEmail) () (b Boolean)

tp Observer_AcceptedSMS ab

tp GetAcceptedSMS mt (self Observer_AcceptedSMS) () (b Boolean)

tp Observer_AcceptedPhoneCall ab

tp GetAcceptedPhoneCall mt (self Observer_AcceptedPhoneCall) () (b Boolean)

tp Field_AcceptedProtocols ab {
	Observer_AcceptedEmail
	Observer_AcceptedSMS
	Observer_AcceptedPhoneCall
}

