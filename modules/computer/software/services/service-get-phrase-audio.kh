/*
	Request Encoders & Decoders
* /

func (req *getPhraseCaptchaAudioReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.CaptchaID[:], buf[0:])
	req.Language = protocol.Language(syllab.GetUInt8(buf, 16))
	req.AudioFormat = AudioFormat(syllab.GetUInt8(buf, 17))
	return
}

func (req *getPhraseCaptchaAudioReq) LenOfSyllabStack() uint32 {
	return 18
}

func (req *getPhraseCaptchaAudioReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "CaptchaID":
			err = decoder.DecodeByteArrayAsBase64(req.CaptchaID[:])
		case "Language":
			var num uint32
			num, err = decoder.DecodeUInt32()
			req.Language = protocol.Language(num)
		case "AudioFormat":
			var num uint8
			num, err = decoder.DecodeUInt8()
			req.AudioFormat = AudioFormat(num)
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

/*
	Response Encoders & Decoders
* /

func (res *getPhraseCaptchaAudioRes) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32)
	copy(buf[0:], res.Audio)
}

func (res *getPhraseCaptchaAudioRes) LenOfSyllabStack() uint32 {
	return 8
}

func (res *getPhraseCaptchaAudioRes) LenOfSyllabHeap() (ln uint32) {
	ln += uint32(len(res.Audio))
	return
}

func (res *getPhraseCaptchaAudioRes) LenAsSyllab() uint64 {
	return uint64(res.LenOfSyllabStack() + res.LenOfSyllabHeap())
}

