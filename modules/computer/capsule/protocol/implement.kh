tp Array_Dynamic in "modules/computer/adt/array/protocol/dynamic.kh"

tp Capsule_Implement ab

// Implement indicates the capsule implementation interfaces e.g. Error.
// It CAN also write above capsule as comment in this format:::
// `//memar:impl memar/process/error/protocol.Error`
//
// Each String MUST include full interface location like above example.
tp Capsule_Implement_Implement mt (self Capsule_Implement) () (d Array_Dynamic)
