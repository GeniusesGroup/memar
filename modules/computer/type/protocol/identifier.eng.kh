tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type_Identifier in "modules/computer/type/protocol/identifier.kh"

tp Domain mt (self Type_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Type_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identity of a declared Type")(s, VoidError)
}

tp Overview mt (self Type_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("The complete identity belongs to the authoritative Type declaration and is retained across organizations, SDK languages, builds and deployments. Shared service and error contracts retain that identity when the destination changes. Its value follows the common identifier protocol. Bundle admission checks the complete SDK dependency closure for conflicting declarations before execution; generated bindings refer to the same declaration. An incompatible successor follows the module replacement contract.")(s, VoidError)
}

tp UserActionNote mt (self Type_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
