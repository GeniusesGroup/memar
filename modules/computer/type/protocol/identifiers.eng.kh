tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifiers in "modules/computer/type/protocol/identifiers.kh"

tp Domain mt (self Identifiers) () (s String) {
    CharacterRun_From.FromCharacterRun("Type")(s, VoidError)
}

tp Summary mt (self Identifiers) () (s String) {
    CharacterRun_From.FromCharacterRun("Type identity observations")(s, VoidError)
}

tp Overview mt (self Identifiers) () (s String) {
    CharacterRun_From.FromCharacterRun("Requires the retained complete Type Identifier observation. Presentation conversions are supplied independently by codecs or concrete realizations and do not determine the Type identity.")(s, VoidError)
}

tp UserActionNote mt (self Identifiers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Identifiers) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
