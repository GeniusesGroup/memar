tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_PreAlpha in "modules/computer/type/primitive/life-cycle-pre-alpha.kh"

tp Domain mt (self Type_LifeCycle_PreAlpha) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_PreAlpha) () (s String) {
    CharacterRun_From.FromCharacterRun("Pre-Alpha")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_PreAlpha) () (s String) {
    CharacterRun_From.FromCharacterRun("The type is being developed before formal testing begins. Its contract and behavior can still change substantially.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_PreAlpha) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_PreAlpha) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

