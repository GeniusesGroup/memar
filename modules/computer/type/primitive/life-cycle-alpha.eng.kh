tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_Alpha in "modules/computer/type/primitive/life-cycle-alpha.kh"

tp Domain mt (self Type_LifeCycle_Alpha) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_Alpha) () (s String) {
    CharacterRun_From.FromCharacterRun("Alpha")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_Alpha) () (s String) {
    CharacterRun_From.FromCharacterRun("The type has entered an early testing phase. Its design and behavior may change as defects and missing capabilities are found.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_Alpha) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_Alpha) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

