tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_EndOfLife in "modules/computer/type/primitive/life-cycle-end-of-life.kh"

tp Domain mt (self Type_LifeCycle_EndOfLife) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_EndOfLife) () (s String) {
    CharacterRun_From.FromCharacterRun("End of Life")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_EndOfLife) () (s String) {
    CharacterRun_From.FromCharacterRun("The type is no longer supported. Existing instances may continue to exist, but support should not be assumed.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_EndOfLife) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_EndOfLife) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

