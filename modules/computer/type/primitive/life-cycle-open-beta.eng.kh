tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_OpenBeta in "modules/computer/type/primitive/life-cycle-open-beta.kh"

tp Domain mt (self Type_LifeCycle_OpenBeta) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_OpenBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("Open Beta")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_OpenBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("The beta is available to a broad audience so that use and feedback can reveal problems before a stable release.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_OpenBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_OpenBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

