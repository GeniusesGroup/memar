tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_Beta in "modules/computer/type/primitive/life-cycle-beta.kh"

tp Domain mt (self Type_LifeCycle_Beta) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_Beta) () (s String) {
    CharacterRun_From.FromCharacterRun("بتا")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_Beta) () (s String) {
    CharacterRun_From.FromCharacterRun("نوع تا حد زیادی کامل شده و در حال آزمون گسترده‌تر است؛ پیش از انتشار پایدار ممکن است نقص‌های شناخته‌شده یا کشف‌نشده باقی باشند.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_Beta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_Beta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

