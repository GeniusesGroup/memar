tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_ClosedBeta in "modules/computer/type/primitive/life-cycle-closed-beta.kh"

tp Domain mt (self Type_LifeCycle_ClosedBeta) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_ClosedBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("Closed Beta")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_ClosedBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("The beta is available to a restricted group of testers, such as invited participants, before wider availability.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_ClosedBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_ClosedBeta) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

