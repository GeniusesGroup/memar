tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_LifeCycle_ReleaseCandidate in "modules/computer/type/primitive/life-cycle-release-candidate.kh"

tp Domain mt (self Type_LifeCycle_ReleaseCandidate) () (s String) {
    Type.Domain()(s)
}

tp Summary mt (self Type_LifeCycle_ReleaseCandidate) () (s String) {
    CharacterRun_From.FromCharacterRun("Release Candidate")(s, VoidError)
}

tp Overview mt (self Type_LifeCycle_ReleaseCandidate) () (s String) {
    CharacterRun_From.FromCharacterRun("The type is a candidate for stable release after testing; significant defects found before release can require another candidate.")(s, VoidError)
}

tp UserActionNote mt (self Type_LifeCycle_ReleaseCandidate) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Type_LifeCycle_ReleaseCandidate) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

