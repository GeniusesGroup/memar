tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conformance_Adapter in "modules/computer/memory/conformance/conformance-adapter.kh"

tp Domain mt (self Conformance_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Conformance")(s, VoidError)
}

tp Summary mt (self Conformance_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("What the suite takes as input")(s, VoidError)
}

tp Overview mt (self Conformance_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("What the suite takes as input.")(s, VoidError)
}

tp UserActionNote mt (self Conformance_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conformance_Adapter) () (s String) {
    CharacterRun_From.FromCharacterRun("Each Open is a new handle on one store; the opener is given when the adapter can be opened again in another process.")(s, VoidError)
}
