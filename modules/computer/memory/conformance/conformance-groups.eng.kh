tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conformance_Groups in "modules/computer/memory/conformance/conformance-groups.kh"

tp Domain mt (self Conformance_Groups) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Conformance")(s, VoidError)
}

tp Summary mt (self Conformance_Groups) () (s String) {
    CharacterRun_From.FromCharacterRun("A list of groups")(s, VoidError)
}

tp Overview mt (self Conformance_Groups) () (s String) {
    CharacterRun_From.FromCharacterRun("A list of groups.")(s, VoidError)
}

tp UserActionNote mt (self Conformance_Groups) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conformance_Groups) () (s String) {
    CharacterRun_From.FromCharacterRun("The groups an adapter passes to the runner beside those of the suite, such as the group the lockable module owes.")(s, VoidError)
}
