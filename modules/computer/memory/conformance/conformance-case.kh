tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"
tp Duration in "modules/time/duration/protocol/duration.kh"
tp Store in "modules/computer/memory/store/protocol/store.kh"
tp Conformance_Adapter in "modules/computer/memory/conformance/conformance-adapter.kh"
tp Conformance_Cost in "modules/computer/memory/conformance/conformance-cost.kh"
tp Conformance_Group in "modules/computer/memory/conformance/conformance-group.kh"
tp Conformance_Verdict in "modules/computer/memory/conformance/conformance-verdict.kh"

tp Conformance_Case ab

tp GetName mt (self Conformance_Case) () (name String)

tp GetGroup mt (self Conformance_Case) () (group Conformance_Group)

tp GetTimeBudget mt (self Conformance_Case) () (budget Duration)

tp GetCost mt (self Conformance_Case) () (cost Conformance_Cost)

tp GetOwed mt (self Conformance_Case) () (owed Boolean)

tp Applies mt (self Conformance_Case) (store Store) (applies Boolean)

tp Check mt (self Conformance_Case) (adapter Conformance_Adapter) (verdict Conformance_Verdict)
