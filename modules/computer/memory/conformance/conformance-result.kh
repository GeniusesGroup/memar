tp String in "modules/computer/codec/string/protocol/string.kh"
tp Duration in "modules/time/duration/protocol/duration.kh"
tp Conformance_Case in "modules/computer/memory/conformance/conformance-case.kh"
tp Conformance_Verdict in "modules/computer/memory/conformance/conformance-verdict.kh"

tp Conformance_Result ab

tp GetCase mt (self Conformance_Result) () (c Conformance_Case)

tp GetVerdict mt (self Conformance_Result) () (verdict Conformance_Verdict)

tp GetMessage mt (self Conformance_Result) () (message String)

tp GetSpent mt (self Conformance_Result) () (spent Duration)
