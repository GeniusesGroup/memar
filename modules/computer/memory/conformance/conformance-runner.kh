tp Service in "modules/process/service/protocol/service.kh"
tp Store in "modules/computer/memory/store/protocol/store.kh"
tp Conformance_Adapter in "modules/computer/memory/conformance/conformance-adapter.kh"
tp Conformance_Groups in "modules/computer/memory/conformance/conformance-groups.kh"
tp Conformance_Cases in "modules/computer/memory/conformance/conformance-cases.kh"
tp Conformance_Results in "modules/computer/memory/conformance/conformance-results.kh"

tp Conformance_Runner ab {
    Service
}

tp Run mt (self Conformance_Runner) (adapter Conformance_Adapter, extra Conformance_Groups) (results Conformance_Results)

tp Applied mt (self Conformance_Runner) (store Store, extra Conformance_Groups) (cases Conformance_Cases)
