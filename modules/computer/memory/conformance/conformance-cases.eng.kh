tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conformance_Cases in "modules/computer/memory/conformance/conformance-cases.kh"

tp Domain mt (self Conformance_Cases) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Conformance")(s, VoidError)
}

tp Summary mt (self Conformance_Cases) () (s String) {
    CharacterRun_From.FromCharacterRun("A list of cases")(s, VoidError)
}

tp Overview mt (self Conformance_Cases) () (s String) {
    CharacterRun_From.FromCharacterRun("A list of cases.")(s, VoidError)
}

tp UserActionNote mt (self Conformance_Cases) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conformance_Cases) () (s String) {
    CharacterRun_From.FromCharacterRun("Listed in the order the group states them, so a Test can name a case by its name.")(s, VoidError)
}
