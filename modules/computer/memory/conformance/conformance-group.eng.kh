tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conformance_Group in "modules/computer/memory/conformance/conformance-group.kh"

tp Domain mt (self Conformance_Group) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Conformance")(s, VoidError)
}

tp Summary mt (self Conformance_Group) () (s String) {
    CharacterRun_From.FromCharacterRun("The cases one capability or parameter calls for")(s, VoidError)
}

tp Overview mt (self Conformance_Group) () (s String) {
    CharacterRun_From.FromCharacterRun("The cases one capability or parameter calls for.")(s, VoidError)
}

tp UserActionNote mt (self Conformance_Group) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conformance_Group) () (s String) {
    CharacterRun_From.FromCharacterRun("Named by what calls for it; the cases of a group run on an adapter only when the group applies to the store it opens.")(s, VoidError)
}
