tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Conformance_Results in "modules/computer/memory/conformance/conformance-results.kh"

tp Domain mt (self Conformance_Results) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Conformance")(s, VoidError)
}

tp Summary mt (self Conformance_Results) () (s String) {
    CharacterRun_From.FromCharacterRun("The results of one run")(s, VoidError)
}

tp Overview mt (self Conformance_Results) () (s String) {
    CharacterRun_From.FromCharacterRun("The results of one run.")(s, VoidError)
}

tp UserActionNote mt (self Conformance_Results) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Conformance_Results) () (s String) {
    CharacterRun_From.FromCharacterRun("One for each case the groups of the run hold.")(s, VoidError)
}
