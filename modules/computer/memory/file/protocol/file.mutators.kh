tp Error in "modules/process/error/protocol/error.kh"
tp Mutator_Rename in "modules/memory/file/protocol/name.mutators.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Mutator_File ab {
    Mutator_Rename
}
// Depend on OS, file data can be cache on ram until `Save()` or `Flush()` called.
tp Mutator_File_Save mt (self Mutator_File) () (err Error)
// Just delete file from NVM device not from any directory that point to it.
tp Mutator_File_Delete mt (self Mutator_File) () (err Error)
// Make invisible by write zero data to prevent any recovery process.
tp Mutator_File_Erase mt (self Mutator_File) (uriPath String) (err Error)
