tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Limits in "modules/computer/memory/store/protocol/store-limits.kh"

tp Domain mt (self Store_Limits) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Limits) () (s String) {
    CharacterRun_From.FromCharacterRun("The limits an adapter declares")(s, VoidError)
}

tp Overview mt (self Store_Limits) () (s String) {
    CharacterRun_From.FromCharacterRun("The limits an adapter declares.")(s, VoidError)
}

tp UserActionNote mt (self Store_Limits) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Limits) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes per batch, bytes per batch as the sum of the lengths of the values written, and bytes per value; a limit not given is no limit.")(s, VoidError)
}
