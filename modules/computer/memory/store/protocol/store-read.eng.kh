tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Read in "modules/computer/memory/store/protocol/store-read.kh"

tp Domain mt (self Store_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer to one address of a get: found, absent or unavailable")(s, VoidError)
}

tp Overview mt (self Store_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer to one address of a get: found, absent or unavailable.")(s, VoidError)
}

tp UserActionNote mt (self Store_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("One of Store_Found, Store_Absent, Store_Unavailable.")(s, VoidError)
}
