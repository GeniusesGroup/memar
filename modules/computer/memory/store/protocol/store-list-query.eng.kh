tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_ListQuery in "modules/computer/memory/store/protocol/store-list-query.kh"

tp Domain mt (self Store_ListQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_ListQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("What a list asks: a range, a page and a direction")(s, VoidError)
}

tp Overview mt (self Store_ListQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("What a list asks: a range, a page and a direction.")(s, VoidError)
}

tp UserActionNote mt (self Store_ListQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_ListQuery) () (s String) {
    CharacterRun_From.FromCharacterRun("From is included and to excluded; after is the last address of the page before; with no bound it answers every held address, which for a dense store is the capacity range. A limit below one, or a from after a to, is refused.")(s, VoidError)
}
