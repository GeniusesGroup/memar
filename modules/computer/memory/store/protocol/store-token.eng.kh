tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Token in "modules/computer/memory/store/protocol/store-token.kh"

tp Domain mt (self Store_Token) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Token) () (s String) {
    CharacterRun_From.FromCharacterRun("The SHA-256 of the bytes of a value")(s, VoidError)
}

tp Overview mt (self Store_Token) () (s String) {
    CharacterRun_From.FromCharacterRun("The SHA-256 of the bytes of a value.")(s, VoidError)
}

tp UserActionNote mt (self Store_Token) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Token) () (s String) {
    CharacterRun_From.FromCharacterRun("The algorithm is the subject and not a choice: a token recorded outside the store must be equal in every adapter. Of computes the token of a value.")(s, VoidError)
}
