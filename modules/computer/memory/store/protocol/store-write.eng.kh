tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Write in "modules/computer/memory/store/protocol/store-write.kh"

tp Domain mt (self Store_Write) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Write) () (s String) {
    CharacterRun_From.FromCharacterRun("One write of a batch: a value put at an address")(s, VoidError)
}

tp Overview mt (self Store_Write) () (s String) {
    CharacterRun_From.FromCharacterRun("One write of a batch: a value put at an address.")(s, VoidError)
}

tp UserActionNote mt (self Store_Write) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Write) () (s String) {
    CharacterRun_From.FromCharacterRun("A write replaces whatever the address held; an address is written once in a batch.")(s, VoidError)
}
