tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Capability in "modules/computer/memory/store/protocol/store-capability.kh"

tp Domain mt (self Store_Capability) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Capability) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter declares of what it is")(s, VoidError)
}

tp Overview mt (self Store_Capability) () (s String) {
    CharacterRun_From.FromCharacterRun("What an adapter declares of what it is.")(s, VoidError)
}

tp UserActionNote mt (self Store_Capability) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Capability) () (s String) {
    CharacterRun_From.FromCharacterRun("Declared once by the adapter; the suite runs the group each capability calls for.")(s, VoidError)
}
