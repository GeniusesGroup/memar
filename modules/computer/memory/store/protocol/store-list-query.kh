tp MemoryAddress in "modules/computer/memory/address/protocol/address.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp W32 in "modules/math/integer/unsigned-32.kh"

tp Store_ListQuery ab

tp GetFrom mt (self Store_ListQuery) () (from MemoryAddress, given Boolean)

tp GetTo mt (self Store_ListQuery) () (to MemoryAddress, given Boolean)

tp GetAfter mt (self Store_ListQuery) () (after MemoryAddress, given Boolean)

tp GetLimit mt (self Store_ListQuery) () (limit W32, given Boolean)

tp GetDescending mt (self Store_ListQuery) () (descending Boolean)
