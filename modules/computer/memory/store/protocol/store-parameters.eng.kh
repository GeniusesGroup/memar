tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Parameters in "modules/computer/memory/store/protocol/store-parameters.kh"

tp Domain mt (self Store_Parameters) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Parameters) () (s String) {
    CharacterRun_From.FromCharacterRun("The kind of address and the properties a store is instantiated with")(s, VoidError)
}

tp Overview mt (self Store_Parameters) () (s String) {
    CharacterRun_From.FromCharacterRun("The kind of address and the properties a store is instantiated with.")(s, VoidError)
}

tp UserActionNote mt (self Store_Parameters) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Parameters) () (s String) {
    CharacterRun_From.FromCharacterRun("Address length and value length are fixed or any; a dense store holds a value at every address of its capacity, a sparse store holds what was written; compare and write says whether the medium can compare and write one address atomically, which an expectation needs.")(s, VoidError)
}
