tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Addresses in "modules/computer/memory/store/protocol/store-addresses.kh"

tp Domain mt (self Store_Addresses) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Addresses) () (s String) {
    CharacterRun_From.FromCharacterRun("A run of addresses")(s, VoidError)
}

tp Overview mt (self Store_Addresses) () (s String) {
    CharacterRun_From.FromCharacterRun("A run of addresses.")(s, VoidError)
}

tp UserActionNote mt (self Store_Addresses) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Addresses) () (s String) {
    CharacterRun_From.FromCharacterRun("Asked of a get, or answered by a list or changes: ascending, or descending where a list asked for it, each once.")(s, VoidError)
}
