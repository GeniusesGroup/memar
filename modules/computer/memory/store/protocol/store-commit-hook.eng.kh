tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_CommitHook in "modules/computer/memory/store/protocol/store-commit-hook.kh"

tp Domain mt (self Store_CommitHook) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_CommitHook) () (s String) {
    CharacterRun_From.FromCharacterRun("What runs at the commit point of a batch")(s, VoidError)
}

tp Overview mt (self Store_CommitHook) () (s String) {
    CharacterRun_From.FromCharacterRun("What runs at the commit point of a batch.")(s, VoidError)
}

tp UserActionNote mt (self Store_CommitHook) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_CommitHook) () (s String) {
    CharacterRun_From.FromCharacterRun("Run returning lets the batch commit; Run failing makes the batch answer unavailable with the reason failed, applied nowhere.")(s, VoidError)
}
