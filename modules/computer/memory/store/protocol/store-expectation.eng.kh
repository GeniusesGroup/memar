tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Expectation in "modules/computer/memory/store/protocol/store-expectation.kh"

tp Domain mt (self Store_Expectation) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Expectation) () (s String) {
    CharacterRun_From.FromCharacterRun("What a batch expects of an address: a token, or that nothing is held")(s, VoidError)
}

tp Overview mt (self Store_Expectation) () (s String) {
    CharacterRun_From.FromCharacterRun("What a batch expects of an address: a token, or that nothing is held.")(s, VoidError)
}

tp UserActionNote mt (self Store_Expectation) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Expectation) () (s String) {
    CharacterRun_From.FromCharacterRun("A token or Store_Absent.")(s, VoidError)
}
