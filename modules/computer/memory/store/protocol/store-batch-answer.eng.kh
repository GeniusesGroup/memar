tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_BatchAnswer in "modules/computer/memory/store/protocol/store-batch-answer.kh"

tp Domain mt (self Store_BatchAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_BatchAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of a batch")(s, VoidError)
}

tp Overview mt (self Store_BatchAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of a batch.")(s, VoidError)
}

tp UserActionNote mt (self Store_BatchAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_BatchAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The first of these that applies, in the order Store_Refused, Store_Unavailable, Store_Conflict, Store_Committed.")(s, VoidError)
}
