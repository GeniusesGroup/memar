tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Stats in "modules/computer/memory/store/protocol/store-stats.kh"

tp Domain mt (self Store_Stats) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Stats) () (s String) {
    CharacterRun_From.FromCharacterRun("What the medium has cost since the store was opened")(s, VoidError)
}

tp Overview mt (self Store_Stats) () (s String) {
    CharacterRun_From.FromCharacterRun("What the medium has cost since the store was opened.")(s, VoidError)
}

tp UserActionNote mt (self Store_Stats) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Stats) () (s String) {
    CharacterRun_From.FromCharacterRun("The processes started and the files opened, for an adapter whose medium costs either.")(s, VoidError)
}
