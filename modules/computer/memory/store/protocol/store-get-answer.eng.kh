tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_GetAnswer in "modules/computer/memory/store/protocol/store-get-answer.kh"

tp Domain mt (self Store_GetAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_GetAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of a get: one read for each address, or a refusal")(s, VoidError)
}

tp Overview mt (self Store_GetAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of a get: one read for each address, or a refusal.")(s, VoidError)
}

tp UserActionNote mt (self Store_GetAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_GetAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Store_Reads or Store_Refused.")(s, VoidError)
}
