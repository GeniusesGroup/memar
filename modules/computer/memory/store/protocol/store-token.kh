tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp Logic_Equivalence in "modules/math/logic/protocol/equivalence.kh"
tp Crypto_Hash256 in "modules/computer/crypto/hash.kh"
tp Store_Expectation in "modules/computer/memory/store/protocol/store-expectation.kh"

tp Store_Token ab {
    Crypto_Hash256
    Logic_Equivalence
    Store_Expectation
}

tp Of mt (self Store_Token) (value Computer_Buffer) (token Store_Token)
