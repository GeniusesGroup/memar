tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Found in "modules/computer/memory/store/protocol/store-found.kh"

tp Domain mt (self Store_Found) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Found) () (s String) {
    CharacterRun_From.FromCharacterRun("A value held at an address, with its token")(s, VoidError)
}

tp Overview mt (self Store_Found) () (s String) {
    CharacterRun_From.FromCharacterRun("A value held at an address, with its token.")(s, VoidError)
}

tp UserActionNote mt (self Store_Found) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Found) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
