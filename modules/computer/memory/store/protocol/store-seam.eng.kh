tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Seam in "modules/computer/memory/store/protocol/store-seam.kh"

tp Domain mt (self Store_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("What every adapter exposes for tests")(s, VoidError)
}

tp Overview mt (self Store_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("What every adapter exposes for tests.")(s, VoidError)
}

tp UserActionNote mt (self Store_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Seam) () (s String) {
    CharacterRun_From.FromCharacterRun("AtCommitPoint sets the hook run after a batch has its expectations checked and before it commits, or clears it when none is given; the suite pauses a writer with a hook that waits. DropDerivedStructures deletes every structure the adapter derives from the store and changes no answer.")(s, VoidError)
}
