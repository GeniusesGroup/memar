tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_Capabilities in "modules/computer/memory/store/protocol/store-capabilities.kh"

tp Domain mt (self Store_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("The set of capabilities an adapter declares")(s, VoidError)
}

tp Overview mt (self Store_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("The set of capabilities an adapter declares.")(s, VoidError)
}

tp UserActionNote mt (self Store_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("Asking Has of a capability the adapter did not declare answers false.")(s, VoidError)
}
