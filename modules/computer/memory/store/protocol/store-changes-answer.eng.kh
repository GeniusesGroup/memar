tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Store_ChangesAnswer in "modules/computer/memory/store/protocol/store-changes-answer.kh"

tp Domain mt (self Store_ChangesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Store")(s, VoidError)
}

tp Summary mt (self Store_ChangesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of changes: addresses, or a refusal")(s, VoidError)
}

tp Overview mt (self Store_ChangesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("The answer of changes: addresses, or a refusal.")(s, VoidError)
}

tp UserActionNote mt (self Store_ChangesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Store_ChangesAnswer) () (s String) {
    CharacterRun_From.FromCharacterRun("Store_Addresses or Store_Refused.")(s, VoidError)
}
