tp ADT in "modules/computer/adt/protocol/adt.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp Container_Clear in "modules/computer/adt/container/protocol/clear.kh"
tp Container_Delete in "modules/computer/adt/container/protocol/delete.kh"
tp Observer_Container_AvailableLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_Capacity in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_OccupiedLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Container_Limit in "modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "modules/computer/adt/container/protocol/pagination.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Clone_Storage_Page in "modules/computer/adt/marker/protocol/clone.kh"
tp Move_Storage_Page in "modules/computer/adt/marker/protocol/move.kh"
tp NonVolatile in "modules/memory/protocol/nonvolatile.kh"
tp Locker in "modules/process/sync/protocol/locker.kh"

// Page or sector is the smallest unit, which is composed of several memory cells,
// and is usually 4 KB in size as advanced format of physical 4KB sectors.
// https://en.wikipedia.org/wiki/Advanced_Format
// In the modern SSD with 25 or 20 nm elements, the page size is 8KB (8192B), 16kB (16384B), 32KB(32768B) or even 64KB(65536B).
// e.g. on SSDs block sizes are 256*page-size like 256*4(page-size)=1024(B)=1(MB)
//
// The minimum physical storage unit of a hard disk drive (HDD) is a sector. The solid state drive (SSD) equivalent is a page.
//
// A page can't be rewritten without read first due to change in checksum know as ECC(Error Correction Code) and need to recalculation.
tp Storage_Page ab {
    ADT
    Clone_Storage_Page
    Move_Storage_Page
    Locker
// Flash memory written in pages and erased in blocks, so once a page is written, a rewrite require the whole block to be erased first.
    NonVolatile
// container_p.Accessor[Byte]
// container_p.Assignment[Byte]
    Observer_Container_Capacity
    Observer_Container_OccupiedLength
    Observer_Container_AvailableLength
    Container_Delete
    Container_Clear
}
tp Storage_Page_Copy mt (self Storage_Page) (desOffset Container_Offset, srcOffset Container_Offset, limit Container_Limit) (err Error)

tp Storage_Page_Move mt (self Storage_Page) (desOffset Container_Offset, srcOffset Container_Offset, limit Container_Limit) (err Error)

// Change the return data not flush to any non-volatile storages. Use Write() to change data.
tp Storage_Page_Read mt (self Storage_Page) (offset Container_Offset, limit Container_Limit, buf Computer_Buffer) (err Error)

// Write at more than block capacity cause block extend. extend capacity isn't equal to write length.
tp Storage_Page_Write mt (self Storage_Page) (offset Container_Offset, buf Computer_Buffer) (err Error)

tp PageNumber ab

tp PageIndex ab

