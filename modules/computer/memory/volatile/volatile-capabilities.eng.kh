tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Volatile_Capabilities in "modules/computer/memory/volatile/volatile-capabilities.kh"

tp Domain mt (self Volatile_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Volatile")(s, VoidError)
}

tp Summary mt (self Volatile_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("What the reference store declares of what it is")(s, VoidError)
}

tp Overview mt (self Volatile_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("What the reference store declares of what it is.")(s, VoidError)
}

tp UserActionNote mt (self Volatile_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Volatile_Capabilities) () (s String) {
    CharacterRun_From.FromCharacterRun("Atomic batch when built with it, and none of durable, shared between processes, fallback, working tree, lockable or replicated.")(s, VoidError)
}
