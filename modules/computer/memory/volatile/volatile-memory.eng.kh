tp Domain mt (self Volatile_Memory) () (s String) {
    CharacterRun_From.FromCharacterRun("Memory Volatile")(s, VoidError)
}

tp Summary mt (self Volatile_Memory) () (s String) {
    CharacterRun_From.FromCharacterRun("What the handles of one reference store share")(s, VoidError)
}

tp Overview mt (self Volatile_Memory) () (s String) {
    CharacterRun_From.FromCharacterRun("What the handles of one reference store share.")(s, VoidError)
}

tp UserActionNote mt (self Volatile_Memory) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Volatile_Memory) () (s String) {
