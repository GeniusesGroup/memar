tp BlockIndex in "modules/memory/block/protocol/block.kh"
tp BlockNumber in "modules/memory/block/protocol/block.kh"
tp Observer_BlockNumber in "modules/memory/block/protocol/block.observers.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp PageIndex in "modules/memory/page/protocol/page.kh"
tp Observer_PageNumber in "modules/memory/page/protocol/page.observers.kh"
tp Storage_Block in "modules/memory/block/protocol/block.kh"
tp Storage_Page in "modules/memory/page/protocol/page.kh"

// Model is storage memory interface that show how an app access to volatile storage devices.
// It can use as volatile and nonvolatile storage.
// Usually dev must not use this interface due to it can damage any data written by upper abstractions such as objects, files, records, k/v, ...
tp Block_Model ab {
// return volume capacity
// these methods have eventual consistency behavior due to extend and other methods.
    Observer_BlockNumber
    Observer_PageNumber
}
// Extended length may vary of requested cap, Due to Extend() is base on storage device block size not bytes,
tp Block_Model_Extend mt (self Block_Model) (cap BlockNumber) (extended BlockNumber, err Error)

tp GetPage mt (self Block_Model) (pi PageIndex) (p Storage_Page, err Error)

tp GetBlock mt (self Block_Model) (bi BlockIndex) (b Storage_Block, err Error)

