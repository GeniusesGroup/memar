type combine struct {
	guiDir      storage_p.Directory
	dlDir       storage_p.Directory
	pagesDir    storage_p.Directory
	widgetsDir  storage_p.Directory
	landingsDir storage_p.Directory
	mainHTMLDir storage_p.Directory // files name is just language in iso format e.g. "en", "fa",

	inlined       map[string]storage_p.File // map key is file path
	mainHTMLFiles map[string]storage_p.File // map key is language in iso format e.g. "en", "fa", ...
	mainJSFiles   map[string]storage_p.File // map key is language in iso format e.g. "en", "fa", ...

	contentEncodings []string
}

//memar:impl memar/computer/language/object/protocol.LifeCycle
func (c *combine) Init(gui storage_p.Directory, contentEncodings []string) (err error_p.Error) {
	c.guiDir = gui
	c.contentEncodings = contentEncodings
	return
}

// Update use to add needed repo files that get from disk or network to the assets!!
func (c *combine) update() {
	c.inlined = make(map[string]storage_p.File)
	c.mainHTMLFiles = make(map[string]storage_p.File)
	c.mainJSFiles = make(map[string]storage_p.File)

	c.dlDir, _ = c.guiDir.Directory("design-languages")
	c.pagesDir, _ = c.guiDir.Directory("pages")
	c.widgetsDir, _ = c.guiDir.Directory("widgets")
	c.landingsDir, _ = c.guiDir.Directory("landings")
	c.mainHTMLDir, _ = c.guiDir.Directory(mainHTMLDirectoryName)

	c.readyLandingsFiles()
	switch "js" {
	case "go":
		c.readyAppGoToJSFile()
	case "js":
		c.readyAppJSFiles()
	}
	c.readySWFile()
	c.readyDesignLanguagesFiles()
}

func (c *combine) readyAppGoToJSFile() {
	var mainGOFile, _ = c.guiDir.File("main.go")
	if mainGOFile == nil {
		log.Warn(&domain, "No main.go file exist to ready UI apps to serve!")
		return
	}

	// TODO:: compile to JS by https://github.com/gopherjs/gopherjs
}

func (c *combine) readyAppJSFiles() {
	var mainHTMLFile, _ = c.landingsDir.File("main.html")
	if mainHTMLFile == nil {
		log.Warn(&domain, "No main.html file exist to ready UI apps to serve!")
		return
	}

	var mainJSFile, _ = c.guiDir.File("main.js")
	if mainJSFile == nil {
		log.Warn(&domain, "No main.js file exist to ready UI apps to serve!")
		return
	}

	var lj = make(localize, 8)
	var jsonFile, _ = c.guiDir.File("main.json")
	if jsonFile == nil {
		log.Warn(&domain, "Can't find json localize file for /main.js")
		return
	}
	var jsonFileData, _ = jsonFile.Data().Marshal()
	lj.jsonDecoder(jsonFileData)
	if len(lj) == 0 {
		log.Warn(&domain, "Founded json not meet standards to localize for main.js")
		return
	}

	var mainJSCreator = JS{
		imports: make([]storage_p.File, 1, 100),
		inlined: c.inlined,
	}
	mainJSCreator.imports[0] = mainJSFile
	_ = mainJSCreator.extractJSImportsRecursively(mainJSFile)
	if log.CNF_DevelopingMode {
		var name strings.Builder
		for _, imp := range mainJSCreator.imports {
			name.WriteString(imp.Metadata().FileName())
			name.WriteByte(',')
		}
		log.Warn(&domain, "main.js imports recursively:"+name.String())
	}

	for lang := range lj {
		var localeJSFileName = "main-" + lang + ".js"
		var localeJSFile, _ = c.guiDir.File(localeJSFileName)
		// write some data if file exist before
		localeJSFile.Data().Unmarshal([]byte("\n"))
		c.mainJSFiles[lang] = localeJSFile
	}

	for i := len(mainJSCreator.imports) - 1; i >= 0; i-- {
		c.addLocalized(mainJSCreator.imports[i])
	}

	for lang, localeMainJSFile := range c.mainJSFiles {
		// Complete main JS file making process
		file.AddHashToFileName(localeMainJSFile)
		file.Compress(localeMainJSFile, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})

		// make main.html
		var localeJSFileName = localeMainJSFile.Metadata().FileName()
		var localeMainHTMLFileName = "main-" + lang + ".html"
		var localeMainHTMLFile, _ = c.guiDir.File(localeMainHTMLFileName)
		var err = file.Minify(localeMainHTMLFile)
		if err != nil && log.CNF_DevelopingMode {
			log.Warn(&domain, "Minify -"+localeMainHTMLFileName+"occur this error:"+err.Error())
		}
		localeMainHTMLFile.Data().Replace([]byte("/main.js"), []byte(localeJSFileName), 1)
		file.AddHashToFileName(localeMainHTMLFile)
		file.Compress(localeMainHTMLFile, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})
		c.mainHTMLFiles[lang] = localeMainHTMLFile

		// Add localized main html files without any compression to specific serve directory
		var localeMainHTMLFileLangName, _ = c.mainHTMLDir.File(lang)
		localeMainHTMLFileLangName.Data().Decode(localeMainHTMLFile.Data())
	}
}

func (c *combine) addLocalized(file storage_p.File) {
	if c.isInlined(file.Metadata().Path()) {
		return
	}
	c.inlined[file.Metadata().Path()] = file

	var mixedData = localeAndMixJSFile(file)
	for lang, mainFile := range c.mainJSFiles {
		var localeData = mixedData[lang]
		if localeData != nil {
			mainFile.Data().Append(localeData)
		} else {
			if log.CNF_DevelopingMode {
				log.Warn(&domain, file.Metadata().FileName()+"don't have locale files in '"+lang+"' language that main.js support this language. WWW Use pure file in combine process.")
			}
		}
	}

	// reset file to storage state to undo extract import from file
	file.Data().Unmarshal(nil)
}

func (c *combine) isInlined(uriPath string) (ok bool) {
	_, ok = c.inlined[uriPath]
	return
}

// readyDesignLanguagesFiles read needed files from given repo folder and do some logic and return files.
func (c *combine) readyDesignLanguagesFiles() {
	var err error_p.Error
	for _, dlFile := range c.dlDir.Files(0, 0) {
		if dlFile.Metadata().FileExtension() == "css" {
			var cssName = dlFile.Metadata().FileName()
			var cssFile, _ = c.dlDir.File("h-" + cssName)
			cssFile.Data().Decode(dlFile.Data())
			err = file.Minify(cssFile)
			if err != nil && log.CNF_DevelopingMode {
				log.Warn(&domain, "Minify -"+cssName+"occur this error:"+err.Error())
			}
			file.AddHashToFileName(cssFile)
			file.Compress(cssFile, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})

			for _, mainFile := range c.mainJSFiles {
				var fileNameWithoutHashAdded = convert.UnsafeStringToByteSlice(cssName)
				var fileNameWithHashAdded = convert.UnsafeStringToByteSlice(cssFile.Metadata().FileName())
				mainFile.Data().Replace(fileNameWithoutHashAdded, fileNameWithHashAdded, -1)
			}
		}
	}
	for _, dir := range c.dlDir.Directories(0, 0) {
		var combinedFileName = dir.Metadata().FileName() + ".css"
		var combinedFile, _ = c.dlDir.File(combinedFileName)
		var combinedFileData []byte
		for _, file := range dir.Files(0, 0) {
			if file.Metadata().FileExtension() == "css" {
				var fileData, _ = file.Data().Marshal()
				combinedFileData = append(combinedFileData, fileData...)
			}
		}
		combinedFile.Data().Unmarshal(combinedFileData)
		err = file.Minify(combinedFile)
		if err != nil && log.CNF_DevelopingMode {
			log.Warn(&domain, "Minify -"+combinedFileName+"occur this error:"+err.Error())
		}
		file.AddHashToFileName(combinedFile)
		file.Compress(combinedFile, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})

		for _, mainFile := range c.mainJSFiles {
			var fileNameWithoutHashAdded = convert.UnsafeStringToByteSlice(combinedFileName)
			var fileNameWithHashAdded = convert.UnsafeStringToByteSlice(combinedFile.Metadata().FileName())
			mainFile.Data().Replace(fileNameWithoutHashAdded, fileNameWithHashAdded, -1)
		}
	}
}

// readyLandingsFiles read needed files from given repo folder and do some logic and return files.
func (c *combine) readyLandingsFiles() {
	var err error_p.Error
	// TODO::: Need to change landings file name to hash of data??
	for _, landing := range c.landingsDir.Files(0, 0) {
		var fe = landing.Metadata().FileExtension()
		switch fe {
		case "html":
			var landingName = landing.Metadata().FileNameWithoutExtension()
			var landingJsonFile, _ = c.landingsDir.File(landingName + ".json")
			if landingJsonFile == nil {
				log.Warn(&domain, "Can't find json localize json file for "+landing.Metadata().FileName())
				continue
			}
			var lj = make(localize)
			var ljfd, _ = landingJsonFile.Data().Marshal()
			lj.jsonDecoder(ljfd)
			if len(lj) == 0 {
				log.Warn(&domain, "Founded json not meet standards to localize for "+landing.Metadata().FileName())
				continue
			}

			var landingCssFile, _ = c.landingsDir.File(landingName + ".css")
			var ld, _ = landing.Data().Marshal()
			var lcd, _ = landingCssFile.Data().Marshal()
			var mixedHTMLFile = mixCSSToHTML(ld, lcd)

			var localized map[string][]byte
			localized, err = localizeHTMLFile(mixedHTMLFile, lj)
			if err != nil {
				log.Warn(&domain, "Can't localize "+landing.Metadata().FileName()+" landing page due to "+err.Error())
			}
			for lang, data := range localized {
				var localizedFileName = landingName + "-" + lang + ".html"
				var localizedLanding, _ = c.landingsDir.File(localizedFileName)
				localizedLanding.Data().Unmarshal(data)
				err = file.Minify(localizedLanding)
				if err != nil && log.CNF_DevelopingMode {
					log.Warn(&domain, "Minify -"+localizedFileName+"occur this error:"+err.Error())
				}
				file.Compress(localizedLanding, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})
			}
		}
	}
}

// readySWFile read needed files from given repo folder and do some logic to make main.html.
func (c *combine) readySWFile() {
	var libJSDir, _ = c.guiDir.Directory("libjs")
	var osDir, _ = libJSDir.Directory("os")
	var swFile, _ = osDir.File("sw.js")
	if swFile == nil {
		log.Warn(&domain, "Service-Worker(sw.js) not exist in /gui/libjs/os/sw.js to make locales sw-{{lang}}.js files")
		return
	}

	for lang, mainHTMLFile := range c.mainHTMLFiles {
		var localeSWFileName = "sw-" + lang + ".js"
		var localeSWFile, _ = c.guiDir.File(localeSWFileName)
		localeSWFile.Data().Decode(swFile.Data())
		localeSWFile.Data().Replace([]byte("main.html"), []byte(mainHTMLFile.Metadata().FileName()), -1)
		var err = file.Minify(localeSWFile)
		if err != nil && log.CNF_DevelopingMode {
			log.Warn(&domain, "Minify -"+localeSWFileName+"occur this error:"+err.Error())
		}
		file.Compress(localeSWFile, c.contentEncodings, compress.Options{protocol.CompressLevel_BestCompression})
	}
}
*/
