tp Observer_Buffer_Indexes in "modules/computer/buffer/protocol/index.observers.kh"
tp Observer_Buffer_Lengths in "modules/computer/buffer/protocol/length.observers.kh"
tp Mutator_Indexes in "modules/computer/buffer/protocol/index.mutators.kh"
tp Capsule_LifeCycle in "modules/computer/capsule/protocol/life_cycle_contract.kh"
tp Compare in "modules/computer/adt/container/protocol/compare.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Concat_Computer_Buffer in "modules/computer/adt/container/protocol/concat.kh"
tp Replace_Elements_Computer_Buffer in "modules/computer/adt/container/protocol/replace-elements.kh"
tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Clone_Computer_Buffer in "modules/computer/adt/marker/protocol/clone.kh"
tp Copy_Computer_Buffer in "modules/computer/adt/marker/protocol/copy.kh"

// In computer science, a data buffer (or just buffer) is a region of a memory used to store data temporarily
// while it is being moved from one place to another.
//
// https://en.wikipedia.org/wiki/Data_buffer
//
// Other frameworks:
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/ArrayBuffer
tp Compare mt (self Computer_Buffer) (with Computer_Buffer) (n NumberOfElement)

tp Computer_Buffer ab {
    DataType
    Capsule_LifeCycle
    Observer_Buffer_Indexes
    Mutator_Indexes
    Observer_Buffer_Lengths
    Compare
    Concat_Computer_Buffer
    Replace_Elements_Computer_Buffer
// If source is a `Split` result, no copy action need and just increase buffer write index.
    Clone_Computer_Buffer
    Copy_Computer_Buffer
}

