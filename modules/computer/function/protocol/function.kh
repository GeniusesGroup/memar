tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Function_Access in "modules/computer/function/protocol/access.kh"

// Function
tp Computer_Function ab {
    DataType
}
// We believe fields MUST always access from inside the object,
// So we MUST have this method just in methods not fields.
tp Computer_Function_Access mt (self Computer_Function) () (a Function_Access)

// runtime, compile time
tp WhenToExecuted mt (self Computer_Function) () ()

tp Computer_Function_Blocking mt (self Computer_Function) () (b Boolean)
