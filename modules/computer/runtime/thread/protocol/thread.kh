tp Duration in "modules/time/duration/protocol/duration.kh"
tp Computer_Runtime in "modules/computer/runtime/protocol/runtime.kh"
tp Scheduler_Waiting in "modules/computer/runtime/thread/protocol/scheduler-waiting.kh"

tp Runtime_Thread ab {
// Execution_Exception
    Scheduler_Waiting
    Computer_Runtime
}
tp Sleep mt (self Runtime_Thread) (d Duration) ()

