tp Array_Key in "modules/computer/adt/array/protocol/key.kh"
tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp Container_ElementIndex in "modules/computer/adt/container/protocol/index.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Iterate_KV ab
// Iterate or traverse
// In each iteration if err != nil, iteration will be stopped
tp Iterate mt (self Iterate_KV) (index Container_ElementIndex, key Array_Key, value Container_Element) (err Error)

tp Iterate_KV_String_String ab
// Iterate or traverse
// In each iteration if err != nil, iteration will be stopped
tp Array_Iterate_KV_String_String_Iterate mt (self Iterate_KV_String_String) (index Container_ElementIndex, key String, value String) (err Error)
