tp Computer_Container in "modules/computer/adt/container/protocol/container.kh"
tp String_Character in "modules/computer/adt/container/protocol/container.kh"

// Slice is dynamically size array
// https://en.wikipedia.org/wiki/Dynamic_array
// It is the raw host of an ordered, resizable run of `Container_Element`s.
// Only raw ADT protocols take or return it. A domain value that holds such a run
// (a Go `[]T` field or result) is its own named type whose methods take and return `T`;
// its realization may keep an `Array_Dynamic` as a field.
tp Array_Dynamic ab {
    Computer_Container
}

tp Dynamic_String_Character ab {
    String_Character
}

