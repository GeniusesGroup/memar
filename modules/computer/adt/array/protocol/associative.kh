tp Array_Iteration_KV in "modules/computer/adt/array/protocol/iteration-kv.kh"
tp Array_Keys in "modules/computer/adt/array/protocol/keys.kh"
tp Array_Lookup in "modules/computer/adt/array/protocol/lookup.kh"
tp Array_Put in "modules/computer/adt/array/protocol/put.kh"
tp Array_Remove in "modules/computer/adt/array/protocol/remove.kh"
tp Array_Values in "modules/computer/adt/array/protocol/values.kh"
tp Observer_Container_Capacity in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_OccupiedLength in "modules/computer/adt/container/protocol/length.observers.kh"

// In computer science, an associative array, map, symbol table, or dictionary is an abstract data type that
// stores a collection of (key, value) pairs, such that each possible key appears at most once in the collection.
// In mathematical terms, an associative array is a function with finite domain.
// https://en.wikipedia.org/wiki/Associative_array
// It is the raw host: keys are `Array_Key`s and values are `Container_Element`s.
// Only raw ADT protocols take or return it. A domain value that maps keys to values
// (a Go `map[K]V` field or result) is its own named type whose methods take `K` and return `V`
// (`UserRegistry`, not `Map<ID, User>`); its realization may keep an `Associative` as a field.
tp Associative ab {
    Array_Put
    Array_Lookup
    Array_Remove
    Array_Keys
    Array_Values

    Array_Iteration_KV

    Observer_Container_Capacity
    Observer_Container_OccupiedLength
}

