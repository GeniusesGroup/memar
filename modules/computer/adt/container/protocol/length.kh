tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Module_Path in "modules/modules/module/protocol/dt-path.kh"
tp Character in "modules/codec/string/protocol/character.kh"

// NumberOfElement or Length is a measure of distance.
// In the International System of Quantities, length is a quantity with dimension distance.
// In most systems of measurement a base unit for length is chosen, from which all other units are derived.
// https://en.wikipedia.org/wiki/Length
//
// Length can refer to any size of memory blocks in byte or 8bit number.
// It can present capacity, usage, buffer, ...
tp NumberOfElement ab

tp Container_Count ab
// Count return the NumberOfElement of given element that exist in the container.
tp Count mt (self Container_Count) (el Container_Element) (ne NumberOfElement, err Error)

tp Count_DataType ab
// Count return the NumberOfElement of given element that exist in the container.
tp Container_Count_DataType_Count mt (self Count_DataType) (el DataType) (ne NumberOfElement, err Error)

tp Count_Module_Path ab
// Count return the NumberOfElement of given element that exist in the container.
tp Container_Count_Module_Path_Count mt (self Count_Module_Path) (el Module_Path) (ne NumberOfElement, err Error)

tp Count_String_Character ab
// Count return the NumberOfElement of given element that exist in the container.
tp Container_Count_String_Character_Count mt (self Count_String_Character) (el Character) (ne NumberOfElement, err Error)

