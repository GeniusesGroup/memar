tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"
tp Character in "modules/codec/string/protocol/character.kh"

// Reversed is a container level operation.

tp Split_Element ab
// Split is an operation that MOVE the container elements after first given ELEMENT index to new container.
// Copy the CONTAINER if you need the original one.
tp SplitByElement mt (self Split_Element) (el Container_Element) (after Container_Element, err Error)

tp Split_Element_String_String_Character ab
// Split is an operation that MOVE the container elements after first given ELEMENT index to new container.
// Copy the CONTAINER if you need the original one.
tp Container_Split_Element_String_String_Character_SplitByElement mt (self Split_Element_String_String_Character) (el Character) (after String, err Error)
