tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Module_Path in "modules/computer/module/protocol/path.kh"
tp Character in "modules/codec/string/protocol/character.kh"

// Reversed is a container level operation.

tp Container_Peek ab
// Peek or `Top()` or `GetLast()` is an operation on certain abstract data types,
// specifically sequential collections such as stacks and queues,
// which returns the value of the top ("front") of the collection without removing the element from the collection.
tp Peek mt (self Container_Peek) () (el Container_Element, err Error)

tp Peek_Type ab
// Peek or `Top()` or `GetLast()` is an operation on certain abstract data types,
// specifically sequential collections such as stacks and queues,
// which returns the value of the top ("front") of the collection without removing the element from the collection.
tp Container_Peek_Type_Peek mt (self Peek_Type) () (el Type, err Error)

tp Peek_Module_Path ab
// Peek or `Top()` or `GetLast()` is an operation on certain abstract data types,
// specifically sequential collections such as stacks and queues,
// which returns the value of the top ("front") of the collection without removing the element from the collection.
tp Container_Peek_Module_Path_Peek mt (self Peek_Module_Path) () (el Module_Path, err Error)

tp Peek_String_Character ab
// Peek or `Top()` or `GetLast()` is an operation on certain abstract data types,
// specifically sequential collections such as stacks and queues,
// which returns the value of the top ("front") of the collection without removing the element from the collection.
tp Container_Peek_String_Character_Peek mt (self Peek_String_Character) () (el Character, err Error)

