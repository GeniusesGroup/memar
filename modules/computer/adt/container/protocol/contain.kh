tp Character in "modules/codec/string/protocol/character.kh"

// Reversed is a container level operation.

tp Container_Contain ab
// reports whether given element exist in the container.
// Implementation can easy just by call `Index()` and return true if > 0.
tp Contain mt (self Container_Contain) (el Container_Element) (b Boolean)

tp Contain_DataType ab
// reports whether given element exist in the container.
// Implementation can easy just by call `Index()` and return true if > 0.
tp Container_Contain_DataType_Contain mt (self Contain_DataType) (el DataType) (b Boolean)

tp Contain_Module_Path ab
// reports whether given element exist in the container.
// Implementation can easy just by call `Index()` and return true if > 0.
tp Container_Contain_Module_Path_Contain mt (self Contain_Module_Path) (el Module_Path) (b Boolean)

tp Contain_String_Character ab
// reports whether given element exist in the container.
// Implementation can easy just by call `Index()` and return true if > 0.
tp Container_Contain_String_Character_Contain mt (self Contain_String_Character) (el Character) (b Boolean)
