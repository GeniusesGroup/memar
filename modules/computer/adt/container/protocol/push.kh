tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Character in "modules/codec/string/protocol/character.kh"

// Reversed is a container level operation.

tp Container_Push ab
// Push adds an element to the end of the container
tp Push mt (self Container_Push) (el Container_Element) (err Error)

tp Push_String_Character ab
// Push adds an element to the end of the container
tp Container_Push_String_Character_Push mt (self Push_String_Character) (el Character) (err Error)

// Pop is an element operation
// https://en.wikipedia.org/wiki/Stack_(abstract_data_type)
// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/pop
