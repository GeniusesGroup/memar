tp Container_Element in "modules/computer/adt/container/protocol/element.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Character in "modules/codec/string/protocol/character.kh"

// Reversed is a container level operation.

tp Container_Append ab
// Append will adds the given elements to the end of the container.
tp Append mt (self Container_Append) (el Container_Element) (nAdd NumberOfElement, err Error)

tp Append_String_Character ab
// Append will adds the given elements to the end of the container.
tp Container_Append_String_Character_Append mt (self Append_String_Character) (el Character) (nAdd NumberOfElement, err Error)

// Prepend is an element operation
