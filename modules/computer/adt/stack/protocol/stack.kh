tp Container_Push in "modules/computer/adt/container/protocol/push.kh"
tp Container_Pop in "modules/computer/adt/container/protocol/pop.kh"

// Stack is stack data structure.
// https://en.wikipedia.org/wiki/Stack_(abstract_data_type)
tp Computer_Stack ab {
    Container_Push
    Container_Pop
}

