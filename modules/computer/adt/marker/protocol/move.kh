tp Error in "modules/process/error/protocol/error.kh"
tp Storage_Page in "modules/memory/page/protocol/page.kh"

// Move is `Clone`>>`Delete` operation
tp Marker_Move ab

tp Move_Storage_Page ab
// Performs move-assignment from source
tp MoveFrom mt (self Move_Storage_Page) (source Storage_Page) (err Error)

// Performs move-assignment to destination
tp MoveTo mt (self Move_Storage_Page) (destination Storage_Page) (err Error)

