tp Module_Path in "modules/modules/module/protocol/dt-path.kh"

tp HashTable_Accessor ab
// err return more than exist(bool)
tp Get mt (self HashTable_Accessor) (key HashTable_Key) (value Container_Element, err Error)

tp Put mt (self HashTable_Accessor) (key HashTable_Key, value Container_Element) (err Error)

tp Remove mt (self HashTable_Accessor) (key HashTable_Key) (err Error)

tp HashTable_Accessor_Module_Path ab
