tp Capsule_LifeCycle in "modules/computer/capsule/protocol/life_cycle_contract.kh"
tp ADT in "modules/computer/adt/protocol/adt.kh"
tp Container_Clear in "modules/computer/adt/container/protocol/clear.kh"
tp Observer_Container_Capacity in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_OccupiedLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp HashTable_Accessor in "modules/computer/adt/hash_table/protocol/accessor.kh"
tp HashTable_AtomicAccessor in "modules/computer/adt/hash_table/protocol/atomic.kh"
tp HashTable_Iteration in "modules/computer/adt/hash_table/protocol/iteration.kh"

tp ADT_HashTable ab {
    Capsule_LifeCycle
    HashTable_Accessor
    HashTable_AtomicAccessor
    HashTable_Iteration
    ADT
    Observer_Container_Capacity
    Observer_Container_OccupiedLength
    Container_Clear
}
tp ADT_HashTable_Init mt (self ADT_HashTable) (capacity NumberOfElement) (err Error)

