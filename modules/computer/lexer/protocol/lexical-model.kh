tp Error in "modules/process/error/protocol/error.kh"
tp Lexical_Model_Identifier in "modules/computer/lexer/protocol/identifier.kh"
tp CharacterRun in "modules/computer/codec/character/protocol/character-run.kh"
tp Lexical_Units in "modules/computer/lexer/protocol/lexical-units.kh"

// Immutable, identity-bearing set of recognition rules. Two models that differ in one rule are different models.
// UnitsFrom is the kernel-visible plug: Lex_Source calls it; cut rules live in the model's realization (e.g. IR-words), never imported from modules-plugable into Lexer.
tp Lexical_Model ab

tp GetID mt (self Lexical_Model) () (id Lexical_Model_Identifier)

tp UnitsFrom mt (self Lexical_Model) (source CharacterRun) (units Lexical_Units, err Error)
