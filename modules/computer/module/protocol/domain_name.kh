//memar:impl computer/capsule/protocol.Assignment
tp Module_DomainName_Set mt (self DomainName) (value String) ()

tp Module_DomainName_Access mt (self DomainName) () (a Function_Access)

tp Module_DomainName_Optional mt (self DomainName) () (b Boolean)

tp Validate mt (self DomainName) () (e Error)

tp SetDefault mt (self DomainName) () ()

//memar:impl memar/datatype/protocol.DataType_ExpectedLen
tp GetMinLength mt (self DomainName) () (n NumberOfElement)

tp GetMaxLength mt (self DomainName) () (n NumberOfElement)

//memar:impl memar/protocol.Len
tp Module_DomainName_Length mt (self DomainName) () (n NumberOfElement)

//memar:impl memar/codec/string/protocol.Stringer
tp ToString mt (self DomainName) () (s String, err Error)

tp FromString mt (self DomainName) (str String) (err Error)

//memar:impl DomainName memar/protocol.Details
tp Module_DomainName_Domain mt (self DomainName) () (s String)

tp Summary mt (self DomainName) () (s String)

tp Overview mt (self DomainName) () (s String)

tp UserActionNote mt (self DomainName) () (s String)

tp DevActionNote mt (self DomainName) () (s String)

//memar:impl DomainName memar/protocol.Quiddity
tp Module_DomainName_Name mt (self DomainName) () (s String)

tp Abbreviation mt (self DomainName) () (s String)

