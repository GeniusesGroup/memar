tp Array_Dynamic in "modules/computer/adt/array/protocol/dynamic.kh"
tp Capsule_LifeCycle in "modules/computer/capsule/protocol/life_cycle_contract.kh"
tp String in "modules/computer/codec/string/protocol/string.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Type_ID in "modules/computer/type/protocol/id.kh"
tp Identifier_MediaType in "modules/computer/mediatype/protocol/media-type.kh"
tp Page in "modules/gui/protocol/page.kh"
tp Service in "modules/process/service/protocol/service.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp Array_Module ab {
	Array_Dynamic
}

tp Array_Page ab {
	Array_Dynamic
}

tp Array_Service ab {
	Array_Dynamic
}

tp Module ab {
	Type
	Identifier_MediaType
	Capsule_LifeCycle
}

tp Source mt (self Module) () (s String)

tp DependOn mt (self Module) () (d Array_Module)

tp Pages mt (self Module) () (p Array_Page)

tp Services mt (self Module) () (s Array_Service)

tp Computer_Modules ab

tp RegisterModule mt (self Computer_Modules) (m Module) ()

tp Modules mt (self Computer_Modules) () (m Array_Module)

tp GetModuleByID mt (self Computer_Modules) (id Type_ID) (m Module, err Error)

tp GetModuleByMediaType mt (self Computer_Modules) (mediaType Identifier_MediaType) (m Module, err Error)

