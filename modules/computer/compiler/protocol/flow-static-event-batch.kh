tp Details in "modules/computer/type/protocol/detail.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Flow_Analysis_Snapshot in "modules/computer/compiler/protocol/flow-analysis-snapshot.kh"
tp Flow_Summary in "modules/computer/compiler/protocol/flow-summary.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp Flow_Static_Event_Batch ab { Details }

tp Generation mt (self Flow_Static_Event_Batch) () (generation Type)

tp Snapshot mt (self Flow_Static_Event_Batch) () (snapshot Flow_Analysis_Snapshot)

tp FirstSummary mt (self Flow_Static_Event_Batch) () (summary Flow_Summary, present Boolean, err Error)

tp NextSummary mt (self Flow_Static_Event_Batch) (after Flow_Summary) (summary Flow_Summary, present Boolean, err Error)
