tp Details in "modules/computer/type/protocol/detail.kh"
tp Pin_Identifier in "modules/computer/compiler/protocol/identifier.kh"
tp Unsigned in "modules/math/integer/protocol/unsigned.kh"
tp CharacterRun in "modules/computer/codec/character/protocol/character-run.kh"
tp CharacterRun_Extent in "modules/computer/codec/character/protocol/character-run-extent.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp Flow_Analysis_Snapshot ab { Details }

tp SnapshotPin mt (self Flow_Analysis_Snapshot) () (pin Pin_Identifier)

tp RegionSource mt (self Flow_Analysis_Snapshot) (region Pin_Identifier) (sourcePin Pin_Identifier, source CharacterRun, extent CharacterRun_Extent, err Error)

tp InvocationSource mt (self Flow_Analysis_Snapshot) (region Pin_Identifier, invocation Unsigned) (sourcePin Pin_Identifier, source CharacterRun, extent CharacterRun_Extent, err Error)

tp ArgumentSource mt (self Flow_Analysis_Snapshot) (region Pin_Identifier, invocation Unsigned, argument Unsigned) (sourcePin Pin_Identifier, source CharacterRun, extent CharacterRun_Extent, err Error)
