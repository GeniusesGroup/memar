tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Binary_ByteOrder in "modules/computer/codec/binary/protocol/byte-order.kh"

tp Domain mt (self Binary_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Binary_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("Conversion between unsigned magnitude and ordered octets")(s, VoidError)
}

tp Overview mt (self Binary_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("ReadUnsigned and WriteUnsigned convert a nonnegative integral magnitude using this order and the supplied positive encoded octet count. The count determines the encoded span, independently of a value capsule's storage width. BigEndian places the most significant octet first; LittleEndian places the least significant octet first. Reading consumes exactly octetCount octets from the current read position on success. Writing writes exactly octetCount octets at the current write position on success, padding the magnitude with zero octets as needed. A nonpositive count returns Binary_Error_InvalidOctetCount before accessing the buffer. A write whose magnitude is at least 256 raised to octetCount returns Binary_Error_UnsignedOutOfRange before writing. Underlying buffer failures propagate as Error. After a buffer failure positions or destination content may have partially changed; the failed numeric result is unusable and the affected buffer must be restored or discarded before reuse. Field layout belongs to the consuming format; CPU storage order does not change this declared conversion.")(s, VoidError)
}

tp UserActionNote mt (self Binary_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Binary_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
