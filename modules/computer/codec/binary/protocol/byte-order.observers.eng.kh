tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Observer_ByteOrder in "modules/computer/codec/binary/protocol/byte-order.observers.kh"

tp Domain mt (self Observer_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Observer_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("Observe the selected octet significance order")(s, VoidError)
}

tp Overview mt (self Observer_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("Returns the byte-order declaration selected for the binary format operation. A protocol may fix that declaration or activate a permitted shared choice before use. The observer reports the retained choice; the type's format codec performs value conversion through Codec.")(s, VoidError)
}

tp UserActionNote mt (self Observer_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Observer_ByteOrder) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
