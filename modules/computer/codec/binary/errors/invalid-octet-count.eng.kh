tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Binary_Error_InvalidOctetCount in "modules/computer/codec/binary/errors/invalid-octet-count.kh"

tp Domain mt (self Binary_Error_InvalidOctetCount) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Binary_Error_InvalidOctetCount) () (s String) {
    CharacterRun_From.FromCharacterRun("Encoded octet count must be positive")(s, VoidError)
}

tp Overview mt (self Binary_Error_InvalidOctetCount) () (s String) {
    CharacterRun_From.FromCharacterRun("The requested numeric conversion supplied a nonpositive encoded octet count.")(s, VoidError)
}

tp UserActionNote mt (self Binary_Error_InvalidOctetCount) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Binary_Error_InvalidOctetCount) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
