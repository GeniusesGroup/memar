tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Binary_Error_ByteOrderNotShared in "modules/computer/codec/binary/errors/not-shared.kh"

tp Domain mt (self Binary_Error_ByteOrderNotShared) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Binary_Error_ByteOrderNotShared) () (s String) {
    CharacterRun_From.FromCharacterRun("Proposed byte order is not shared")(s, VoidError)
}

tp Overview mt (self Binary_Error_ByteOrderNotShared) () (s String) {
    CharacterRun_From.FromCharacterRun("At least one participant's supplied capability snapshot does not permit the proposed complete byte-order declaration UUID.")(s, VoidError)
}

tp UserActionNote mt (self Binary_Error_ByteOrderNotShared) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Binary_Error_ByteOrderNotShared) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
