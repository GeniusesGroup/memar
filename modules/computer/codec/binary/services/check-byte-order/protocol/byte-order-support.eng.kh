tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Binary_ByteOrderSupport in "modules/computer/codec/binary/services/check-byte-order/protocol/byte-order-support.kh"

tp Domain mt (self Binary_ByteOrderSupport) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Binary_ByteOrderSupport) () (s String) {
    CharacterRun_From.FromCharacterRun("Advertised byte-order capabilities")(s, VoidError)
}

tp Overview mt (self Binary_ByteOrderSupport) () (s String) {
    CharacterRun_From.FromCharacterRun("Reports whether the complete proposed byte-order declaration UUID is among the orders permitted by this participant for the exchange. Unknown UUIDs return false. The capability snapshot can be read without resolving a codec object.")(s, VoidError)
}

tp UserActionNote mt (self Binary_ByteOrderSupport) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Binary_ByteOrderSupport) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
