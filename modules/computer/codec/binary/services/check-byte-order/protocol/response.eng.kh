tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Binary_CheckByteOrder_Response in "modules/computer/codec/binary/services/check-byte-order/protocol/response.kh"

tp Domain mt (self Binary_CheckByteOrder_Response) () (s String) {
    CharacterRun_From.FromCharacterRun("Binary")(s, VoidError)
}

tp Summary mt (self Binary_CheckByteOrder_Response) () (s String) {
    CharacterRun_From.FromCharacterRun("Result of checking a proposed byte order")(s, VoidError)
}

tp Overview mt (self Binary_CheckByteOrder_Response) () (s String) {
    CharacterRun_From.FromCharacterRun("A successful response reports compatibility of the supplied capability snapshots. A refusal is returned through the separate Error result of the service's Handler; the communication protocol confirms and activates the agreement.")(s, VoidError)
}

tp UserActionNote mt (self Binary_CheckByteOrder_Response) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Binary_CheckByteOrder_Response) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
