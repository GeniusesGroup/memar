tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Stringer code the data to/from human readable format. It can be any other format like JSON(not recommended).
tp Stringer ab {
    Stringer_To
    Stringer_From
}

tp Stringer_To ab
tp ToString mt (self Stringer_To) () (str String, err Error)

tp Stringer_From ab
tp FromString mt (self Stringer_From) (str String) (err Error)
