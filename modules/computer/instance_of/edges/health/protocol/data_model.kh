tp Duration in "modules/time/duration/protocol/duration.kh"
tp Instance_Identifier in "modules/computer/instance_of/protocol/identifier.kh"
tp Observer_Instance_Identifier in "modules/computer/instance_of/protocol/identifier.observers.kh"
tp Observer_Request_Identifier in "modules/process/request/protocol/identifier.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"
tp Observer_Health_SideNodeID ab

tp GetSideNodeID mt (self Observer_Health_SideNodeID) () (i Instance_Identifier)

tp Observer_Health_PingTime ab

tp GetPingTime mt (self Observer_Health_PingTime) () (d Duration)

tp Observer_Health_JitterTime ab

tp GetJitterTime mt (self Observer_Health_JitterTime) () (d Duration)

tp NodeHealthDataModel ab {
	Observer_Instance_Identifier
	Observer_Health_SideNodeID
	Observer_Health_PingTime
	Observer_Health_JitterTime
	Observer_Request_Identifier
	Observer_Time_Request
}

