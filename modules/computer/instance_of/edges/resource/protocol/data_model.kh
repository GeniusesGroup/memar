tp Array_Dynamic in "memar/modules/computer/adt/array/protocol/dynamic.kh"
tp Field_InstanceUUID in "modules/computer/instance_of/protocol/dt-uuid.kh"
tp Field_LabelType in "modules/knowledge/label/protocol/dt-uuid.kh"
tp Observer_RequestID in "memar/modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "memar/modules/process/time/protocol/request.observers.kh"
tp ResourceType in "modules/computer/instance_of/edges/resource/protocol/dt-resource_type.kh"

tp Array_ResourceType ab {
	Array_Dynamic
}

tp Array_ResourceAmount ab {
	Array_Dynamic
}

tp Observer_Resource_Type ab

tp GetResourceTypes mt (self Observer_Resource_Type) () (r Array_ResourceType)

tp Observer_Resource_Amount ab

tp GetResourceAmounts mt (self Observer_Resource_Amount) () (a Array_ResourceAmount)

tp NodeResourceDataModel ab {
	Field_InstanceUUID
	Field_LabelType
	Observer_Resource_Type
	Observer_Resource_Amount
	Observer_RequestID
	Observer_Time_Request
}

