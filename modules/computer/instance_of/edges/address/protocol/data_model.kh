tp Array_Dynamic in "modules/computer/adt/array/protocol/dynamic.kh"
tp Address in "modules/computer/instance_of/edges/address/protocol/dt-address.kh"
tp Field_InstanceUUID in "modules/computer/instance_of/protocol/dt-uuid.kh"
tp Field_LabelType in "modules/knowledge/label/protocol/dt-uuid.kh"
tp Observer_RequestID in "modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"

tp AddressBinary ab {
	Array_Dynamic
}

tp Observer_Node_Address ab

tp GetAddress mt (self Observer_Node_Address) () (a Address)

tp Observer_Node_AddressBinary ab

tp GetAddressBinary mt (self Observer_Node_AddressBinary) () (b AddressBinary)

tp NodeAddressDataModel ab {
	Field_InstanceUUID
	Field_LabelType
	Observer_Node_Address
	Observer_Node_AddressBinary
	Observer_RequestID
	Observer_Time_Request
}

