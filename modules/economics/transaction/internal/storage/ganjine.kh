// methods to implements protocol.Codec interface
func (ft *FinancialTransaction) MediaType() protocol.MediaType {
	return &society.FinancialTransactionMediaType
}
func (ft *FinancialTransaction) CompressType() protocol.CompressType { return nil }
func (ft *FinancialTransaction) Decode(source protocol.Codec) (err protocol.Error) {
	var buf bytes.Buffer
	var _, goErr = io.Copy(&buf, reader)
	if goErr != nil {
		// err =
		return
	}
	var payload = buf.Bytes()
	err = ft.Unmarshal(payload)
	return
}
func (ft *FinancialTransaction) Encode(writer protocol.Writer) (err protocol.Error) {
	_, err = ft.WriteTo(writer)
	return
}
func (ft *FinancialTransaction) Len() int { return int(ft.LenAsSyllab()) }
func (ft *FinancialTransaction) Unmarshal(data []byte) (err protocol.Error) {
	err = ft.CheckSyllab(data)
	if err != nil {
		return
	}
	*ft = data
	return
}
func (ft *FinancialTransaction) Marshal() (data []byte) { return *ft }
func (ft *FinancialTransaction) MarshalTo(data []byte) []byte {
	var ln = len(data)
	data = data[:ln+ft.Len()]
	copy(data[ln:], ft)
	return data
}

// methods to implements protocol.Syllab interface
func (ft *FinancialTransaction) CheckSyllab(payload []byte) (err protocol.Error) {
	if uint32(len(payload)) < ft.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}
}
func (ft *FinancialTransaction) FromSyllab(payload []byte, stackIndex uint32) {
	*ft = payload[stackIndex : uint64(stackIndex)+ft.LenAsSyllab()]
}
func (ft *FinancialTransaction) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(payload[stackIndex:], ft)
	return heapIndex
}
func (ft *FinancialTransaction) LenAsSyllab() (ln uint64)      { return 177 }
func (ft *FinancialTransaction) LenOfSyllabStack() (ln uint32) { return 177 }
func (ft *FinancialTransaction) LenOfSyllabHeap() (ln uint32)  { return }
