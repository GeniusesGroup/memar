var getProductPriceService = service.Service{
	URN:                "urn:giti:sabz.city:service:get-product-price",
	Domain:             DomainName,
	ID:                 3620614406374689542,
	IssueDate:          1608092738,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
