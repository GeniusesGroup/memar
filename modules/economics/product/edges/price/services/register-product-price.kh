var registerProductPriceService = service.Service{
	URN:                "urn:giti:sabz.city:service:register-product-price",
	Domain:             DomainName,
	ID:                 14708872079942773549,
	IssueDate:          1608092756,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDCreate,
		UserType: protocol.UserType_Org,
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Register Product Price",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"ProductPrice",
	},

	SRPCHandler: RegisterProductPriceSRPC,
	ServeHTTP:   RegisterProductPriceHTTP,
}

// RegisterProductPriceSRPC is sRPC handler of RegisterProductPrice service.
func RegisterProductPriceSRPC(st protocol.Stream) {
	var req = &registerProductPriceReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}
	err = registerProductPrice(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength)
}

// RegisterProductPriceHTTP is HTTP handler of RegisterProductPrice service.
func RegisterProductPriceHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &registerProductPriceReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	err = registerProductPrice(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
}

type registerProductPriceReq struct {
	QuiddityID [32]byte          `json:",string"`
	Language   protocol.Language // Just use to check quiddity exist and belong to requested org

	MaterialsPercent   math.PerMyriad
	LaborPercent       math.PerMyriad
	InvestmentsPercent math.PerMyriad

	Markup math.PerMyriad
	Margin math.PerMyriad

	TaxPercent math.PerMyriad

	Price price.Amount
}

func registerProductPrice(st protocol.Stream, req *registerProductPriceReq) (err protocol.Error) {
	err = st.Authorize()
	if err != nil {
		return
	}

	// Check quiddity exits and belong to this Org
	var getQuiddityReq = getQuiddityReq{
		ID:       req.QuiddityID,
		Language: req.Language,
	}
	var getQuiddityRes *getQuiddityRes
	getQuiddityRes, err = getQuiddity(st, &getQuiddityReq)
	if err != nil {
		return
	}
	if getQuiddityRes.OrgID != st.Connection.UserID {
		err = authorization.ErrUserNotAllow
		return
	}
	if getQuiddityRes.Status == data.QuiddityStatusBlocked {
		err = ErrBlockedByJustice
		return
	}

	var pp = data.ProductPrice{
		AppInstanceID:    achaemenid.App.Nodes.LocalNode.InstanceID,
		UserConnectionID: st.Connection.ID,
		OrgID:            st.Connection.UserID,
		QuiddityID:       req.QuiddityID,

		MaterialsPercent:   req.MaterialsPercent,
		MaterialsCost:      req.Price.PerMyriad(req.MaterialsPercent),
		LaborPercent:       req.LaborPercent,
		LaborCost:          req.Price.PerMyriad(req.LaborPercent),
		InvestmentsPercent: req.InvestmentsPercent,
		InvestmentsCost:    req.Price.PerMyriad(req.InvestmentsPercent),

		Markup:          req.Markup,
		WholesaleProfit: req.Price.PerMyriad(req.Markup),
		Margin:          req.Margin,
		RetailProfit:    req.Price.PerMyriad(req.Margin),

		TaxPercent: req.TaxPercent,
		Tax:        req.Price.PerMyriad(req.TaxPercent),

		Price: req.Price,
	}
	pp.TotalCost = pp.MaterialsCost + pp.LaborCost + pp.InvestmentsCost
	err = pp.SaveNew()
	if err != nil {
		return
	}
	return
}

/*
	Request Encoders & Decoders
* /

func (req *registerProductPriceReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.QuiddityID[:], buf[0:])
	req.Language = protocol.Language(syllab.GetUInt32(buf, 32))

	req.MaterialsPercent = math.PerMyriad(syllab.GetUInt16(buf, 36))
	req.LaborPercent = math.PerMyriad(syllab.GetUInt16(buf, 38))
	req.InvestmentsPercent = math.PerMyriad(syllab.GetUInt16(buf, 40))

	req.Markup = math.PerMyriad(syllab.GetUInt16(buf, 42))
	req.Margin = math.PerMyriad(syllab.GetUInt16(buf, 44))

	req.TaxPercent = math.PerMyriad(syllab.GetUInt16(buf, 46))

	req.Price = price.Amount(syllab.GetInt64(buf, 48))
	return
}

func (req *registerProductPriceReq) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[0:], req.QuiddityID[:])
	syllab.SetUInt32(buf, 32, uint32(req.Language))

	syllab.SetUInt16(buf, 36, uint16(req.MaterialsPercent))
	syllab.SetUInt16(buf, 38, uint16(req.LaborPercent))
	syllab.SetUInt16(buf, 40, uint16(req.InvestmentsPercent))

	syllab.SetUInt16(buf, 42, uint16(req.Markup))
	syllab.SetUInt16(buf, 44, uint16(req.Margin))

	syllab.SetUInt16(buf, 46, uint16(req.TaxPercent))

	syllab.SetInt64(buf, 48, int64(req.Price))
	return
}

func (req *registerProductPriceReq) LenOfSyllabStack() uint32 {
	return 56
}

func (req *registerProductPriceReq) LenOfSyllabHeap() (ln uint32) {
	return
}

func (req *registerProductPriceReq) LenAsSyllab() uint64 {
	return uint64(req.LenOfSyllabStack() + req.LenOfSyllabHeap())
}

func (req *registerProductPriceReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "QuiddityID":
			err = decoder.DecodeByteArrayAsBase64(req.QuiddityID[:])
		case "Language":
			var num uint32
			num, err = decoder.DecodeUInt32()
			req.Language = protocol.Language(num)

		case "MaterialsPercent":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.MaterialsPercent = math.PerMyriad(num)
		case "LaborPercent":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.LaborPercent = math.PerMyriad(num)
		case "InvestmentsPercent":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.InvestmentsPercent = math.PerMyriad(num)

		case "Markup":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.Markup = math.PerMyriad(num)
		case "Margin":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.Margin = math.PerMyriad(num)

		case "TaxPercent":
			var num uint16
			num, err = decoder.DecodeUInt16()
			req.TaxPercent = math.PerMyriad(num)

		case "Price":
			var num int64
			num, err = decoder.DecodeInt64()
			req.Price = price.Amount(num)
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (req *registerProductPriceReq) ToJSON(payload []byte) (added []byte, err protocol.Error) {
