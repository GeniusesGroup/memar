tp Arguments in "modules/lib/process/command/protocol/arguments.kh"
tp Error in "modules/process/error/protocol/error.kh"

// Handler introduce CLI (command-line interface) service handler.
tp Command_Handler ab
// ServeCLA or serve by command-line arguments might block the caller
// Arguments list not include the command name.
tp ServeCLA mt (self Command_Handler) (args Arguments) (err Error)

