tp Error in "modules/process/error/protocol/error.kh"
tp HTTP_Request in "modules/lib/net/http/protocol/http.kh"
tp HTTP_Response in "modules/lib/net/http/protocol/http.kh"
tp Net_Socket_2 in "modules/net/protocol/socket.kh"
tp Observer_URI_Path in "modules/net/uri/protocol/path.observers.kh"

// Handler is any object to be HTTP service handler.
// Some other protocol like gRPC, SOAP, ... must implement inside HTTP, If they are use HTTP as a transfer protocol.
tp HTTP_Handler ab {
// Fill just if any http handler need route by path instead of ServiceID().
//
// **ATTENTION**
// - Just use `URI.GetPath` since other part of URI not fit in `memar` rules. e.g.
// 		- If add `URI.GetHost`, means application will serve for multiple domains. In TLS world, it MUST handle in upper layers.
// 		- If add `URI.GetPort`, means we lock to old protocols like `tcp`.
// - As describe here https://www.rfc-editor.org/rfc/rfc6570
// 	JUST use simple immutable path and DO NOT variable data included in path.
// 	e.g. "/product?id=1" instead of "/product/1/"
    Observer_URI_Path
}
// ** NOTE: Due to reuse underling buffer If caller need to keep any data from httpReq or httpRes it must make a copy and
// ** prevent from keep a reference to any data get from these two interface after return.
// **
tp HTTP_Handler_ServeHTTP mt (self HTTP_Handler) (sk Net_Socket_2, req HTTP_Request, res HTTP_Response) (err Error)

