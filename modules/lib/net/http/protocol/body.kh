tp Codec in "modules/codec/protocol/codec.kh"

// HTTP Body Semantic that USUALLY use in responses.
// In requests ALMOST ALWAYS each service HTTPHandler use [SK Socket] Buffer to decode to desire data type.
tp HTTP_Body ab {
    Codec
}

