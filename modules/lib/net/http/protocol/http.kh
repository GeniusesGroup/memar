tp Observer_HTTP_Body in "modules/lib/net/http/protocol/body.observers.kh"
tp Mutator_Body in "modules/lib/net/http/protocol/body.mutators.kh"
tp Net_Header in "modules/lib/net/http/protocol/header.kh"
tp PseudoHeader_Request in "modules/lib/net/http/protocol/pseudo_header.kh"
tp PseudoHeader_Response in "modules/lib/net/http/protocol/pseudo_header.kh"

// Request indicate HTTP request semantic.
//
// Other frameworks:
// https://developer.mozilla.org/en-US/docs/Web/API/Request
tp HTTP_Request ab {
    PseudoHeader_Request
    Net_Header
    Observer_HTTP_Body
    Mutator_Body
}

// Response indicate HTTP response semantic.
//
// Other frameworks:
// https://developer.mozilla.org/en-US/docs/Web/API/Response
tp HTTP_Response ab {
    PseudoHeader_Response
    Net_Header
    Observer_HTTP_Body
    Mutator_Body
}

