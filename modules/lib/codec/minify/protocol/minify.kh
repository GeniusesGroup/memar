tp Codec in "modules/codec/protocol/codec.kh"
tp Computer_Buffer in "modules/computer/buffer/protocol/buffer.kh"
tp Error in "modules/process/error/protocol/error.kh"

// Minify replace given data with minify of them if possible.
tp Minifier ab
tp Minify mt (self Minifier) (data Codec) (err Error)

tp Minifier_ByteSlice ab
tp MinifyBytes mt (self Minifier_ByteSlice) (data Computer_Buffer) (minified Computer_Buffer, err Error)
