tp Array_Dynamic in "memar/modules/computer/adt/array/protocol/dynamic.kh"
tp Container_Limit in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Container_Offset in "memar/modules/computer/adt/container/protocol/pagination.kh"
tp Error in "memar/modules/process/error/protocol/error.kh"
tp NumberOfVersion in "memar/modules/memory/protocol/version.kh"
tp QuiddityURI in "org/modules/identity/uri/widgets/quiddity-uri/protocol/dt-uri.kh"
tp QuiddityURIDataModel in "org/modules/identity/uri/widgets/quiddity-uri/protocol/data_model.kh"
tp ThingUUID in "org/modules/identity/thing/protocol/dt-uuid.kh"

tp QuiddityURIStorage ab

tp Save mt (self QuiddityURIStorage) (dm QuiddityURIDataModel) (err Error)

tp Get mt (self QuiddityURIStorage) (uri QuiddityURI) (dm QuiddityURIDataModel, err Error)

tp FindByQuiddity mt (self QuiddityURIStorage) (quiddityID ThingUUID, offset Container_Offset, limit Container_Limit) (uris Array_Dynamic, nv NumberOfVersion, err Error)

