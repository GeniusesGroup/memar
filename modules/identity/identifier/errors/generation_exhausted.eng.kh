tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifier_Error_GenerationExhausted in "modules/identity/identifier/errors/generation_exhausted.kh"

tp Domain mt (self Identifier_Error_GenerationExhausted) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Identifier_Error_GenerationExhausted) () (s String) {
    CharacterRun_From.FromCharacterRun("The current creation count is exhausted")(s, VoidError)
}

tp Overview mt (self Identifier_Error_GenerationExhausted) () (s String) {
    CharacterRun_From.FromCharacterRun("The configured cap for successful reservations at the retained timestamp is reached, or the discriminator cannot increment without 64-bit overflow. No reservation is consumed. A strictly later valid creation count restarts from the same lifetime anchor with the same cap and anchor runway. Artificial time advance, wrapping and silent reseeding are forbidden.")(s, VoidError)
}

tp UserActionNote mt (self Identifier_Error_GenerationExhausted) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Identifier_Error_GenerationExhausted) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
