tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifier_Error_NotInitialized in "modules/identity/identifier/errors/not_initialized.kh"

tp Domain mt (self Identifier_Error_NotInitialized) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Identifier_Error_NotInitialized) () (s String) {
    CharacterRun_From.FromCharacterRun("Identity is not initialized")(s, VoidError)
}

tp Overview mt (self Identifier_Error_NotInitialized) () (s String) {
    CharacterRun_From.FromCharacterRun("The receiver or an equality operand has no published identity value. Value or issuance-time observation and equality refuse rather than presenting an artificial zero value or timestamp.")(s, VoidError)
}

tp UserActionNote mt (self Identifier_Error_NotInitialized) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Identifier_Error_NotInitialized) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
