tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifier_BinaryCodec in "modules/identity/identifier/protocol/identifier.codec.binary.kh"

tp Domain mt (self Identifier_BinaryCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Identifier_BinaryCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("Complete reversible binary identity")(s, VoidError)
}

tp Overview mt (self Identifier_BinaryCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("The self codec preserves the complete value; decoding loads an existing identity without minting or applying freshness admission.")(s, VoidError)
}

tp UserActionNote mt (self Identifier_BinaryCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Identifier_BinaryCodec) () (s String) {
    CharacterRun_From.FromCharacterRun("The canonical encoding is exactly sixteen octets: the unsigned64 issuance nanosecond coordinate followed by the unsigned64 discriminator, both most-significant octet first. Binary owns numeric octet conversion. GetSerializationLength returns sixteen, including on an empty receiver; GetMediaType denotes application/octet-stream. Encode on empty refuses NotInitialized before touching the destination. Decode on a filled receiver refuses AlreadyInitialized before reading. Decode consumes precisely sixteen octets from the current source position and leaves following framed data unread; an incomplete or malformed native read returns NotDecodable. Failed decoding leaves the receiver empty; source consumption on refusal is not rolled back. Buffer failures propagate through Error; malformed native write progress returns BufferFailure. Successful encode writes all sixteen octets, handling short writes without repetition of acknowledged bytes. Partial destination effects on failure are not rolled back. Successful decode publishes the entire retained value and delegated Time view atomically. No clock sampling, generation, byte truncation, padding, text detection, authorization or domain admission occurs. The native source.read(size) and destination.write(bytes) bindings are trusted and nonreentrant when used under receiver initialization; each read requests at most the remaining octets and accumulates positive short immutable-byte results until sixteen; empty, overlong or non-byte results refuse NotDecodable. Each write retries only its unacknowledged suffix; progress must be an exact positive native integer, excluding booleans, no greater than the suffix length. Missing, zero, negative, noninteger or excessive progress refuses BufferFailure. Native BytesIO-style bindings are reference tests of these effects, not a full Computer_Buffer or Type ABI realization. Transport byte-order negotiation concerns other codecs, never silently reinterprets this named canonical encoding.")(s, VoidError)
}
