tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Empty in "modules/computer/adt/protocol/empty.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Time in "modules/time/protocol/time.kh"
tp Unsigned in "modules/math/integer/protocol/unsigned.kh"
tp Codec in "modules/computer/codec/protocol/codec.kh"
tp Stringer in "modules/computer/codec/string/protocol/stringer.kh"

tp Identifier ab {
    Codec
    Stringer
    Type
    Empty
}

tp Generate mt (self Identifier) () (err Error)

tp GetIssuanceTime mt (self Identifier) () (time Time, err Error)
tp GetDiscriminator mt (self Identifier) () (value Unsigned, err Error)
tp Equivalence mt (self Identifier) (with Identifier) (equal Boolean, err Error)

tp Precedes mt (self Identifier) (than Identifier) (precedes Boolean, err Error)
