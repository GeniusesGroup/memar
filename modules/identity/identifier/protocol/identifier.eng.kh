tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifier in "modules/identity/identifier/protocol/identifier.kh"

tp Domain mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Shared identity value and one-shot generation")(s, VoidError)
}

tp Overview mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Every domain uses the complete shared identity and equality. A fresh value is initialized once and then retained by its subject. Its encoded issuance coordinate is an effective clock coordinate, possibly retained under bounded rollback, rather than an unconditional statement of actual subject creation time. Type metadata remains the metadata of the declaration or realizing capsule. Process Time owns actual creation and receiving-node admission; domains bind those observations under their trusted timing policies.")(s, VoidError)
}

tp UserActionNote mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Generation placement is a module decision over the same shared method. An SDK may mint locally when avoiding a server round trip and exposing linkage to its application-node generator are acceptable. A module may instead delegate minting to its server node so public identifiers reflect the server generator rather than the client generator. A server generator appropriately shared across clients can avoid encoding a separate client association; a dedicated per-user generator can recreate that association. An application-node instance identity does not inherently identify a natural person, while association with accounts, timestamps, logs or other data can make it identifying in a deployment. Server placement addresses the client-anchor exposure; privacy of request metadata, surrounding data and access remains subject to the deployment controls. Both placements use the same complete identity and generation safeguards, without organization-specific ID allocation or a second Identifier format. Existing identities are retained when transported; placement is chosen for fresh creation rather than reminting a received identity. Concrete capsules may implement independent conversion contracts; the semantic Identifier protocol chooses no string spelling.")(s, VoidError)
}

tp DevActionNote mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier composes Type for declaration metadata, Empty for initialization state, Identifier_BinaryCodec for retained binary conversion and direct error-aware observations of issuance time and discriminator. GetIssuanceTime returns the existing Time concept directly on Identifier; no undeclared Issuance_Time concept is introduced through an observer. GetDiscriminator returns the exact unsigned integer represented by the low 64 identity bits, including zero and the maximum value. It is an opaque component, not a recoverable generator or module identity, and alone is insufficient for equality, routing, authenticity or access. The same low value may occur at different high coordinates. Both observations refuse an empty receiver with Identifier_Error_NotInitialized and neither changes the retained identity. Together the exact epoch-normalized nanosecond count and discriminator reconstruct the complete numeric identity; the binary codec companion states canonical serialization and the readable companion supplies an optional reversible technical spelling. Metadata identifies the declaration or realizing capsule type, never the varying retained Identifier value, and lookup never generates another identity. Generate is the receiver's atomic one-shot fresh initializer. A filled receiver returns Identifier_Error_AlreadyInitialized before calling the private issuer. Failure publishes no partial value or time view and leaves the receiver empty; an already reserved private issuance may be burned and must not be rolled back or reused. Realizations retain an explicit initialized state so all zero bits remain a valid initialized identity. Loading an already decoded retained identity fills an empty receiver once without minting, overwriting or changing its coordinate. Empty value/time observation and equality with either empty operand return Identifier_Error_NotInitialized. Successful equality compares all 128 identity bits independently of metadata. Precedes is a strict total order on initialized identifiers: compare the effective unsigned time coordinate first, then the unsigned discriminator. Equal values precede neither way. An empty operand returns Identifier_Error_NotInitialized; observation changes neither operand nor issuance state. This order is for deterministic comparison, indexing and cursors, not a claim of actual creation chronology, causal order or cross-generator issuance order. Cursor absence is represented separately from the identifier because the all-zero initialized value is valid. The reference value helper obtains its candidate through a trusted composition binding and captures an immutable Time view of the candidate's high coordinate before publication. Such bindings must not reenter the receiver while its initialization lock is held. Invalid internal candidates outside the exact unsigned128-bit range return Identifier_Error_InvalidValue. No mandatory Capsule_LifeCycle is imposed on this pure value; concrete resource owners may implement Deinit separately, preserving published identity and shared issuance state. The internal host-byte adapter admits only an immutable bytes value of exactly sixteen octets and returns that same complete value. Identifier_Error_InvalidBytes refuses every other shape, including text, integer, mutable buffer and incomplete or overlong byte spans. No truncation, padding, parsing, allocation or time interpretation occurs. This owner boundary is reused by catalogs before hashing or mutation; it is not a wire codec, origin check, declaration conflict check or creation-time admission policy. All sixteen-octet bit patterns pass structural admission, including zero; domain policy determines whether an admitted identity may be used. The private issuance state uses a fixed lifetime discriminator anchor. Its internal numeric value is (timeCount << 64) | discriminator. timeCount is an unsigned 64-bit nanosecond count supplied by the common Time adapter on the selected shared wall-clock coordinate. Normalize a known source epoch and leap-smear mapping before conversion; unknown mappings are refused. Convert whole elapsed seconds and nanosecond remainder exactly, refusing pre-epoch values, precision loss or unsigned 64-bit overflow without wrap, clamp or silent rounding. Epoch selection remains at the Time owner; this representation does not redefine general Time or imply that observed clocks have nanosecond accuracy. The internal time-coordinate adapter requests Time.PartsInEpoch with the trusted composition-supplied shared reference, never an epoch selected by request data. Its host binding returns exact integer seconds, canonical integer nanosecond remainder and Error. It propagates a returned owner refusal before issuing an identity, rejects malformed parts as InvalidGeneratorInput and rejects a total outside the unsigned 64-bit range. A generate-from-time helper converts before entering the generator so conversion failure consumes no reservation; its result remains the internal integer rather than claiming full SDK conformance. Constructor configuration supplies max_rollback_ticks as an unsigned 64-bit count and max_per_tick as a positive unsigned 64-bit cap. Both are immutable for one lifetime and have no policy default. The cap counts all successful reservations at one retained emitted timestamp, including equal and bounded-backward observations. A lifetime obtains exactly 32 fresh secret bytes from trusted entropy. Optional source context is absent or one complete immutable 16-byte identity, permitting bootstrap; it adds context rather than guaranteed entropy. Derive the anchor once: the transcript is ASCII memar/identifier/session-seed, one zero octet, one source-length octet (0 or 16), then the source octets. Interpret the first eight octets of HMAC-SHA256(secret, transcript) as an unsigned big-endian integer. This internal canonical transcript chooses no wire byte order. A first or strictly later observed count emits that count with the same lifetime anchor and reservation count one. Equal or bounded-backward observations retain the last emitted count and increment its discriminator and reservation count. Excessive rollback refuses. At max_per_tick reservations or 64-bit discriminator exhaustion refuse without consuming a reservation, wrapping, reseeding, or advancing time artificially. A later valid timestamp resets the reservation count and reuses the original anchor; an anchor near the upper bound has the same limited runway at every timestamp. Raw counts and configuration must be exact integers in their stated ranges; booleans and malformed source context are refused. Concurrent calls reserve under one lock, committing timestamp, discriminator and bucket count together before return. Monotonicity and reservation order cover one lifetime, not thread completion or restart continuity. The trusted session adapter is callable without the reservation lock and returns a positive integer token. Check it before acquiring a potentially copied lock, under that lock, and immediately before commit. A changed or unreadable session permanently invalidates the lifetime; ordinary refusals preserve the last reservation. A new lifetime requires fresh independent entropy. Entropy failure or malformed length establishes no lifetime and has no fallback. The reference session adapter observes process identity and cannot detect every full machine clone. Identical copied anchor, state and timestamp can duplicate output. Anchor reuse exposes linkage and predictable counter offsets; the identifier is neither a secret nor proof of origin. Cross-lifetime collision analysis counts all sampling opportunities and externally justified caps. Under independent uniform-anchor idealization, intervals [anchor_i, min(2^64-1, anchor_i+cap_i-1)] bound all discriminator values for lifetime i; a seed-independent superset of pairs that can emit a shared timestamp gives a union bound of the sum (cap_i+cap_j-1)/2^64, clipped at one. Count restart lifetimes, rollback and adversarial selection; uptime overlap alone is insufficient. HMAC supplies a computational PRF assumption rather than exact uniformity or global uniqueness. The internal reference value slot verifies one-shot publication, equality and delegated time views; complete Type metadata and the public Khayyam ABI remain the realizing SDK binding's duties. It does not invent per-value Type identities. The private kernel returns an internal integer. Its shared lifetime is retained across independently initialized Identifier values; metadata lookup and value observation never create another lifetime.")(s, VoidError)
}
