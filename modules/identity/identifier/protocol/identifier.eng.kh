tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Identifier in "modules/identity/identifier/protocol/identifier.kh"

tp Domain mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier")(s, VoidError)
}

tp Summary mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Shared identity value and one-shot generation")(s, VoidError)
}

tp Overview mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Every domain uses the complete shared identity and equality. A fresh value is initialized once and then retained by its subject. Its encoded issuance coordinate is an effective clock coordinate, possibly retained under bounded rollback, rather than an unconditional statement of actual subject creation time. Type metadata remains the metadata of the declaration or realizing capsule. Process Time owns actual creation and receiving-node admission; domains bind those observations under their trusted timing policies.")(s, VoidError)
}

tp UserActionNote mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Generation placement is a module decision over the same shared method. An SDK may mint locally when avoiding a server round trip and exposing linkage to its application-node generator are acceptable. A module may instead delegate minting to its server node so public identifiers reflect the server generator rather than the client generator. A server generator appropriately shared across clients can avoid encoding a separate client association; a dedicated per-user generator can recreate that association. An application-node instance identity does not inherently identify a natural person, while association with accounts, timestamps, logs or other data can make it identifying in a deployment. Server placement addresses the client-anchor exposure; privacy of request metadata, surrounding data and access remains subject to the deployment controls. Both placements use the same complete identity and generation safeguards, without organization-specific ID allocation or a second Identifier format. Existing identities are retained when transported; placement is chosen for fresh creation rather than reminting a received identity. Identifier composes the shared conversion contracts directly; concrete bindings select supported formats and calendars through the same identity abstraction.")(s, VoidError)
}

tp DevActionNote mt (self Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identifier composes Type for declaration metadata, Empty for initialization state, Codec and Stringer directly for retained conversion and direct error-aware observations of issuance time and discriminator. GetIssuanceTime returns the existing Time concept directly on Identifier; no undeclared Issuance_Time concept is introduced through an observer. GetDiscriminator returns the exact unsigned integer represented by the low 64 identity bits, including zero and the maximum value. It is an opaque component, not a recoverable generator or module identity, and alone is insufficient for equality, routing, authenticity or access. The same low value may occur at different high coordinates. Both observations refuse an empty receiver with Identifier_Error_NotInitialized and neither changes the retained identity. Together the exact epoch-normalized nanosecond count and discriminator reconstruct the complete numeric identity; the realization binds conversion profiles. Unsupported string conversion returns Stringer_Error_NotSupported. The reference binding supports the canonical binary and readable profiles; either string direction may be disabled or use a trusted conversion binding without another identity abstraction. Metadata identifies the declaration or realizing capsule type, never the varying retained Identifier value, and lookup never generates another identity. Generate is the receiver's atomic one-shot fresh initializer. A filled receiver returns Identifier_Error_AlreadyInitialized before calling the private issuer. Failure publishes no partial value or time view and leaves the receiver empty; an already reserved private issuance may be burned and must not be rolled back or reused. Realizations retain an explicit initialized state so all zero bits remain a valid initialized identity. Loading an already decoded retained identity fills an empty receiver once without minting, overwriting or changing its coordinate. Empty value/time observation and equality with either empty operand return Identifier_Error_NotInitialized. Successful equality compares all 128 identity bits independently of metadata. Precedes is a strict total order on initialized identifiers: compare the effective unsigned time coordinate first, then the unsigned discriminator. Equal values precede neither way. An empty operand returns Identifier_Error_NotInitialized; observation changes neither operand nor issuance state. This order is for deterministic comparison, indexing and cursors, not a claim of actual creation chronology, causal order or cross-generator issuance order. Cursor absence is represented separately from the identifier because the all-zero initialized value is valid. The reference value helper obtains its candidate through a trusted composition binding and captures an immutable Time view of the candidate's high coordinate before publication. Such bindings must not reenter the receiver while its initialization lock is held. Invalid internal candidates outside the exact unsigned128-bit range return Identifier_Error_InvalidValue. No mandatory Capsule_LifeCycle is imposed on this pure value; concrete resource owners may implement Deinit separately, preserving published identity and shared issuance state. The internal host-byte adapter admits only an immutable bytes value of exactly sixteen octets and returns that same complete value. Identifier_Error_InvalidBytes refuses every other shape, including text, integer, mutable buffer and incomplete or overlong byte spans. No truncation, padding, parsing, allocation or time interpretation occurs. This owner boundary is reused by catalogs before hashing or mutation; it is not a wire codec, origin check, declaration conflict check or creation-time admission policy. All sixteen-octet bit patterns pass structural admission, including zero; domain policy determines whether an admitted identity may be used. The private issuance state uses a fixed lifetime discriminator anchor. Its internal numeric value is (timeCount << 64) | discriminator. timeCount is an unsigned 64-bit nanosecond count supplied by the common Time adapter on the selected shared wall-clock coordinate. Normalize a known source epoch and leap-smear mapping before conversion; unknown mappings are refused. Convert whole elapsed seconds and nanosecond remainder exactly, refusing pre-epoch values, precision loss or unsigned 64-bit overflow without wrap, clamp or silent rounding. Epoch selection remains at the Time owner; this representation does not redefine general Time or imply that observed clocks have nanosecond accuracy. The internal time-coordinate adapter requests Time.PartsInEpoch with the trusted composition-supplied shared reference, never an epoch selected by request data. Its host binding returns exact integer seconds, canonical integer nanosecond remainder and Error. It propagates a returned owner refusal before issuing an identity, rejects malformed parts as InvalidGeneratorInput and rejects a total outside the unsigned 64-bit range. A generate-from-time helper converts before entering the generator so conversion failure consumes no reservation; its result remains the internal integer rather than claiming full SDK conformance. Constructor configuration supplies max_rollback_ticks as an unsigned 64-bit count and max_per_tick as a positive unsigned 64-bit cap. Both are immutable for one lifetime and have no policy default. The cap counts all successful reservations at one retained emitted timestamp, including equal and bounded-backward observations. A lifetime obtains exactly 32 fresh secret bytes from trusted entropy. Optional source context is absent or one complete immutable 16-byte identity, permitting bootstrap; it adds context rather than guaranteed entropy. Derive the anchor once: the transcript is ASCII memar/identifier/session-seed, one zero octet, one source-length octet (0 or 16), then the source octets. Interpret the first eight octets of HMAC-SHA256(secret, transcript) as an unsigned big-endian integer. This internal canonical transcript chooses no wire byte order. A first or strictly later observed count emits that count with the same lifetime anchor and reservation count one. Equal or bounded-backward observations retain the last emitted count and increment its discriminator and reservation count. Excessive rollback refuses. At max_per_tick reservations or 64-bit discriminator exhaustion refuse without consuming a reservation, wrapping, reseeding, or advancing time artificially. A later valid timestamp resets the reservation count and reuses the original anchor; an anchor near the upper bound has the same limited runway at every timestamp. Raw counts and configuration must be exact integers in their stated ranges; booleans and malformed source context are refused. Concurrent calls reserve under one lock, committing timestamp, discriminator and bucket count together before return. Monotonicity and reservation order cover one lifetime, not thread completion or restart continuity. The trusted session adapter is callable without the reservation lock and returns a positive integer token. Check it before acquiring a potentially copied lock, under that lock, and immediately before commit. A changed or unreadable session permanently invalidates the lifetime; ordinary refusals preserve the last reservation. A new lifetime requires fresh independent entropy. Entropy failure or malformed length establishes no lifetime and has no fallback. The reference session adapter observes process identity and cannot detect every full machine clone. Identical copied anchor, state and timestamp can duplicate output. Anchor reuse exposes linkage and predictable counter offsets; the identifier is neither a secret nor proof of origin. Cross-lifetime collision analysis counts all sampling opportunities and externally justified caps. Under independent uniform-anchor idealization, intervals [anchor_i, min(2^64-1, anchor_i+cap_i-1)] bound all discriminator values for lifetime i; a seed-independent superset of pairs that can emit a shared timestamp gives a union bound of the sum (cap_i+cap_j-1)/2^64, clipped at one. Count restart lifetimes, rollback and adversarial selection; uptime overlap alone is insufficient. HMAC supplies a computational PRF assumption rather than exact uniformity or global uniqueness. The internal reference value slot verifies one-shot publication, equality and delegated time views; complete Type metadata and the public Khayyam ABI remain the realizing SDK binding's duties. It does not invent per-value Type identities. The private kernel returns an internal integer. Its shared lifetime is retained across independently initialized Identifier values; metadata lookup and value observation never create another lifetime. Reference binary binding: The canonical encoding is exactly sixteen octets: the unsigned64 issuance nanosecond coordinate followed by the unsigned64 discriminator, both most-significant octet first. Binary owns numeric octet conversion. GetSerializationLength returns sixteen, including on an empty receiver; GetMediaType denotes application/octet-stream. Encode on empty refuses NotInitialized before touching the destination. Decode on a filled receiver refuses AlreadyInitialized before reading. Decode consumes precisely sixteen octets from the current source position and leaves following framed data unread; an incomplete or malformed native read returns NotDecodable. Failed decoding leaves the receiver empty; source consumption on refusal is not rolled back. Buffer failures propagate through Error; malformed native write progress returns BufferFailure. Successful encode writes all sixteen octets, handling short writes without repetition of acknowledged bytes. Partial destination effects on failure are not rolled back. Successful decode publishes the entire retained value and delegated Time view atomically. No clock sampling, generation, byte truncation, padding, text detection, authorization or domain admission occurs. The native source.read(size) and destination.write(bytes) bindings are trusted and nonreentrant when used under receiver initialization; each read requests at most the remaining octets and accumulates positive short immutable-byte results until sixteen; empty, overlong or non-byte results refuse NotDecodable. Each write retries only its unacknowledged suffix; progress must be an exact positive native integer, excluding booleans, no greater than the suffix length. Missing, zero, negative, noninteger or excessive progress refuses BufferFailure. Native BytesIO-style bindings are reference tests of these effects, not a full Computer_Buffer or Type ABI realization. Transport byte-order negotiation concerns other codecs, never silently reinterprets this named canonical encoding. Reference readable binding: The default native readable profile writes exactly YYYYMMDD-T followed by HHMMSS, a dot, nine nanosecond digits, Z, a hyphen and sixteen uppercase hexadecimal discriminator digits. Calendar is proleptic Gregorian, timezone UTC, digits ASCII, and the epoch is the shared Unix/POSIX coordinate. An example is 20261117-T124949.123456789Z-17BA988ED5072891. Every unsigned128 value, including zero, has one spelling; all unsigned64 time coordinates fit the four-digit-year profile. FromString accepts only that canonical forty-four-character spelling with a valid Gregorian date and time, no leap-second label, whitespace, offsets, lowercase hex, shortened fraction or overflow beyond unsigned64 nanoseconds. It refuses with Identifier_Error_NotDecodable without publishing. A filled receiver refuses AlreadyInitialized before parsing; an empty ToString refuses NotInitialized. Successful parsing fills once without minting and retains every bit; it never applies current-time admission. Locale-specific or Persian-calendar spelling is selected through a conversion binding on the same Identifier and does not alter binary epoch or this durable spelling. The Python Gregorian conversion delegates to the standard-library calendar binding and claims no general calendar realization owned by Identifier; general civil/calendar conversion remains Time's concern. Pure host encode_readable and decode_readable use complete immutable sixteen-octet identities; bytes length alone never establishes that an arbitrary memory address represents Identifier.  Native string bindings are immutable constructor options string_encoder and string_decoder, independently callable or None. Callbacks map complete immutable sixteen-octet identity bytes to a native string, and a native string to complete immutable sixteen-octet identity bytes. The constructor defaults to this owner's encode_readable/decode_readable; a different calendar/format may be bound as a trusted owner conversion pair. An empty ToString still refuses NotInitialized; a filled FromString refuses AlreadyInitialized before support checks or parsing. An unsupported direction returns Stringer_Error_NotSupported without invoking a converter, issuing or changing the value. A supported FromString requires an exact native string before invoking a custom decoder; malformed native input returns Identifier_Error_NotDecodable. Invalid noncallable bindings and malformed callback return shapes return Identifier_Error_InvalidValue. Decoder output is admitted through the owner's complete_bytes validator before publication, mapping its InvalidBytes refusal to InvalidValue for this broken callback contract. Other callback refusals propagate unchanged and preserve the retained value. Bindings invoked under initialization must not reenter the receiver. Supported custom pairs owe reversible identity preservation; method presence alone does not establish that a chosen persistence profile is supported. Public Stringer signatures remain unchanged.")(s, VoidError)
}
