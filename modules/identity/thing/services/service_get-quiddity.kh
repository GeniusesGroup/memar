var getQuiddityService = service.Service{
	URN:                "urn:giti:sabz.city:service:get-quiddity",
	Domain:             DomainName,
	ID:                 5401677341698019394,
	IssueDate:          1605026701,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDRead,
		UserType: protocol.UserType_All,
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Get Quiddity",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"Quiddity",
	},

	SRPCHandler: GetQuidditySRPC,
	ServeHTTP:   GetByHTTP,
}

// GetQuidditySRPC is sRPC handler of GetQuiddity service.
func GetQuidditySRPC(st protocol.Stream) {
	var req = &getQuiddityReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}

	var res *getQuiddityRes
	res, err = getQuiddity(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength+res.LenAsSyllab())
	res.ToSyllab(srpc.GetPayload(st.OutcomePayload))
}

// GetHTTP is HTTP handler of GetQuiddity service.
func GetByHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &getQuiddityReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	var res *getQuiddityRes
	res, err = getQuiddity(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
	httpRes.SetBody(json.NewCodec(res))
}

type getQuiddityReq struct {
	id       [32]byte          `json:",string"`
	language protocol.Language `json:",string"`
}

type getQuiddityRes struct {
	WriteTime time.Time

	AppInstanceID    [32]byte `json:",string"`
	UserConnectionID [32]byte `json:",string"`
	OrgID            [32]byte `json:",string"`

	URI    string
	Title  string
	Status data.QuiddityStatus
}

func getQuiddity(st protocol.Stream, req *getQuiddityReq) (res *getQuiddityRes, err protocol.Error) {
	var w = data.Quiddity{
		ID:       req.ID,
		Language: req.Language,
	}
	err = w.GetLastByIDLang()
	if err != nil {
		return
	}

	res = &getQuiddityRes{
		WriteTime: w.WriteTime,

		AppInstanceID:    w.AppInstanceID,
		UserConnectionID: w.UserConnectionID,
		OrgID:            w.OrgID,

		URI:    w.URI,
		Title:  w.Title,
		Status: w.Status,
	}

	return
}

/*
	Request Encoders & Decoders
* /

func (req *getQuiddityReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.ID[:], buf[0:])
	req.Language = protocol.Language(syllab.GetUInt32(buf, 32))
	return
}

func (req *getQuiddityReq) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[0:], req.ID[:])
	syllab.SetUInt32(buf, 32, uint32(req.Language))
	return
}

func (req *getQuiddityReq) LenOfSyllabStack() uint32 {
	return 36
}

func (req *getQuiddityReq) LenOfSyllabHeap() (ln uint32) {
	return
}

func (req *getQuiddityReq) LenAsSyllab() uint64 {
	return uint64(req.LenOfSyllabStack() + req.LenOfSyllabHeap())
}

func (req *getQuiddityReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "ID":
			err = decoder.DecodeByteArrayAsBase64(req.ID[:])
		case "Language":
			var num uint32
			num, err = decoder.DecodeUInt32()
			req.Language = protocol.Language(num)
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (req *getQuiddityReq) ToJSON(payload []byte) (added []byte, err protocol.Error) {
	var encoder = json.Encoder{Buf: payload}
	encoder.EncodeString(`{"ID":"`)
	encoder.EncodeByteSliceAsBase64(req.ID[:])
	encoder.EncodeString(`","Language":`)
	encoder.EncodeUInt32(uint32(req.Language))
	encoder.EncodeByte('}')
	return encoder.Buf
}

func (req *getQuiddityReq) LenAsJSON() (ln int) {
	ln = 74
	return
}

/*
	Response Encoders & Decoders
* /

func (res *getQuiddityRes) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < res.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	res.WriteTime = time.Time(syllab.GetInt64(buf, 0))
	copy(res.AppInstanceID[:], buf[8:])
	copy(res.UserConnectionID[:], buf[40:])
	copy(res.OrgID[:], buf[72:])

	res.URI = syllab.UnsafeGetString(buf, 104)
	res.Title = syllab.UnsafeGetString(buf, 112)
	res.Status = data.QuiddityStatus(syllab.GetUInt8(buf, 120))
	return
}

func (res *getQuiddityRes) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	syllab.SetInt64(buf, 0, int64(res.WriteTime))
	copy(buf[8:], res.AppInstanceID[:])
	copy(buf[40:], res.UserConnectionID[:])
	copy(buf[72:], res.OrgID[:])
	heapIndex = syllab.SetString(buf, res.URI, 104, heapIndex)
	heapIndex = syllab.SetString(buf, res.Title, 112, heapIndex)
	syllab.SetUInt8(buf, 120, uint8(res.Status))
	return
}

func (res *getQuiddityRes) LenOfSyllabStack() uint32 {
	return 121
}

func (res *getQuiddityRes) LenOfSyllabHeap() (ln uint32) {
	ln += uint32(len(res.URI))
	ln += uint32(len(res.Title))
	return
}

func (res *getQuiddityRes) LenAsSyllab() uint64 {
	return uint64(res.LenOfSyllabStack() + res.LenOfSyllabHeap())
}

func (res *getQuiddityRes) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "WriteTime":
			var num int64
			num, err = decoder.DecodeInt64()
			res.WriteTime = time.Time(num)
		case "AppInstanceID":
			err = decoder.DecodeByteArrayAsBase64(res.AppInstanceID[:])
		case "UserConnectionID":
			err = decoder.DecodeByteArrayAsBase64(res.UserConnectionID[:])
		case "OrgID":
			err = decoder.DecodeByteArrayAsBase64(res.OrgID[:])
		case "URI":
			res.URI, err = decoder.DecodeString()
		case "Title":
			res.Title, err = decoder.DecodeString()
		case "Status":
			var num uint8
			num, err = decoder.DecodeUInt8()
			res.Status = data.QuiddityStatus(num)
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (res *getQuiddityRes) ToJSON(payload []byte) (added []byte, err protocol.Error) {
