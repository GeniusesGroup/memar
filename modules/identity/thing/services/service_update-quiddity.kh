/*
package quiddity

import (
	"libgo/achaemenid"
	"libgo/authorization"
	"libgo/http"
	"libgo/json"
	"libgo/protocol"
	"libgo/service"
	"libgo/srpc"
	"libgo/syllab"
	"libgo/validators"
)

var updateQuiddityService = service.Service{
	URN:                "urn:giti:sabz.city:service:update-quiddity",
	Domain:             DomainName,
	ID:                 5304885371010064427,
	IssueDate:          1605102728,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDUpdate,
		UserType: protocol.UserType_Org,
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Update Quiddity",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"Quiddity",
	},

	SRPCHandler: UpdateQuidditySRPC,
	ServeHTTP:   UpdateQuiddityHTTP,
}

// UpdateQuidditySRPC is sRPC handler of UpdateQuiddity service.
func UpdateQuidditySRPC(st protocol.Stream) {
	var req = &updateQuiddityReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}

	err = updateQuiddity(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength)
}

// UpdateQuiddityHTTP is HTTP handler of UpdateQuiddity service.
func UpdateQuiddityHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &updateQuiddityReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	err = updateQuiddity(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
}

type updateQuiddityReq struct {
	ID       [32]byte `json:",string"`
	Language protocol.Language
	URI      string `valid:"text[0:100]"`
	Title    string `valid:"text[0:100]"`
}

func updateQuiddity(st protocol.Stream, req *updateQuiddityReq) (err protocol.Error) {
	err = st.Authorize()
	if err != nil {
		return
	}
	// Validate data here due to service use internally by other services!
	err = req.validator()
	if err != nil {
		return
	}

	var q = data.Quiddity{
		ID:       req.ID,
		Language: req.Language,
	}
	err = q.GetLastByIDLang()
	if err != nil {
		return
	}

	if q.OrgID != st.Connection.UserID {
		err = authorization.ErrUserNotAllow
		return
	}
	if q.Status == data.QuiddityStatusBlocked {
		err = ErrBlockedByJustice
		return
	}

	var oldTitle = q.Title
	var oldURI = q.URI

	if req.URI != oldURI && req.URI != "" {
		err = checkQuiddityURI(st, req.URI)
		if err != nil {
			return
		}
	}

	q = data.Quiddity{
		AppInstanceID:    achaemenid.App.Nodes.LocalNode.InstanceID,
		UserConnectionID: st.Connection.ID,
		ID:               req.ID,
		OrgID:            st.Connection.UserID,

		Language: req.Language,
		URI:      req.URI,
		Title:    req.Title,
		Status:   data.QuiddityStatusRegister,
	}
	err = q.Set()
	if err != nil {
		return
	}
	q.IndexRecordIDForIDLanguage()
	if req.Title != oldTitle && req.Title != "" {
		q.IndexIDForTitle()
	}
	if req.URI != oldURI && req.URI != "" {
		q.IndexIDForURI()
	}

	return
}

func (req *updateQuiddityReq) validator() (err protocol.Error) {
	// Title must not include ':'(use in URI)
	err = validators.ValidateText(req.Title, 0, 100)
	err = validators.ValidateText(req.URI, 0, 100)
	return
}

/*
	Request Encoders & Decoders
* /

func (req *updateQuiddityReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.ID[:], buf[0:])
	req.Language = protocol.Language(syllab.GetUInt32(buf, 32))
	req.URI = syllab.UnsafeGetString(buf, 36)
	req.Title = syllab.UnsafeGetString(buf, 44)
	return
}

func (req *updateQuiddityReq) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[0:], req.ID[:])
	syllab.SetUInt32(buf, 32, uint32(req.Language))
	heapIndex = syllab.SetString(buf, req.URI, 36, heapIndex)
	heapIndex = syllab.SetString(buf, req.Title, 44, heapIndex)
	return
}

func (req *updateQuiddityReq) LenOfSyllabStack() uint32 {
	return 52
}

func (req *updateQuiddityReq) LenOfSyllabHeap() (ln uint32) {
	ln += uint32(len(req.URI))
	ln += uint32(len(req.Title))
	return
}

func (req *updateQuiddityReq) LenAsSyllab() uint64 {
	return uint64(req.LenOfSyllabStack() + req.LenOfSyllabHeap())
}

func (req *updateQuiddityReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "ID":
			err = decoder.DecodeByteArrayAsBase64(req.ID[:])
		case "Language":
			var num uint32
			num, err = decoder.DecodeUInt32()
			req.Language = protocol.Language(num)
		case "URI":
			req.URI, err = decoder.DecodeString()
		case "Title":
			req.Title, err = decoder.DecodeString()
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (req *updateQuiddityReq) ToJSON(payload []byte) (added []byte, err protocol.Error) {
	var encoder = json.Encoder{Buf: payload}

	encoder.EncodeString(`{"ID":"`)
	encoder.EncodeByteSliceAsBase64(req.ID[:])

	encoder.EncodeString(`","Language":`)
	encoder.EncodeUInt8(uint8(req.Language))

	encoder.EncodeString(`,"URI":"`)
	encoder.EncodeString(req.URI)

	encoder.EncodeString(`","Title":"`)
	encoder.EncodeString(req.Title)

	encoder.EncodeString(`"}`)
	return encoder.Buf
}

func (req *updateQuiddityReq) LenAsJSON() (ln int) {
	ln = len(req.URI) + len(req.Title)
	ln += 85
	return
}
*/
