tp Field_OrganizationUUID ab

tp OrganizationID mt (self Field_OrganizationUUID) () (u UserUUID)

tp Field_OrganizationOwnerID ab

tp OrganizationOwnerID mt (self Field_OrganizationOwnerID) () (u UserUUID)

