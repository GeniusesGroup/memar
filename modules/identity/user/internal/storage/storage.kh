/*
package storage

import (
	"golang.org/x/crypto/sha3"

	"libgo/ganjine"
	"libgo/pehrest"
	"libgo/syllab"
	org "../../protocol"
)


var PersonNumberMediaType = mediatype.New("application/vnd.sabz.city.person-number+syllab", "").
	SetInfo(protocol.Software_PreAlpha, 1599048951, "").
	SetDetail(protocol.LanguageEnglish, "Person Number",
		"Store person user number that act for some process like exiting phone, mobile, ...",
		[]string{}).
	Expired(0, nil)

const (
	personNumberStructureID uint64 = 12997682275679060581
)

// PersonNumber ---Read locale description in personNumberStructure---
type PersonNumber struct {
	RequestID [16]byte // Request RecordID to prove how this object created in the chain of other objects.
	PersonID  [16]byte
	Number    uint64 // must start with country code e.g. (00)98-912-345-6789
	Status    org.PersonNumberStatus
}

// SaveNew method set some data and write entire Quiddity record with all indexes!
func (pn *PersonNumber) SaveNew() (err protocol.Error) {
	err = pn.Set()
	if err != nil {
		return
	}
	pn.IndexRecordIDForPersonID()
	pn.IndexPersonIDForNumber()
	return
}

// Set method set some data and write entire PersonNumber record!
func (pn *PersonNumber) Save() (err protocol.Error) {
	metadata, err = protocol.App.ObjectDirectory().Save(pn)
	return
}

// GetByRecordID method read all existing record data by given RecordID!
func (pn *PersonNumber) GetByRecordID() (err protocol.Error) {
	var req = ganjine.GetRecordReq{
		RecordID:          pn.RecordID,
		RecordStructureID: personNumberStructureID,
	}
	var res *ganjine.GetRecordRes
	res, err = gsdk.GetRecord(&req)
	if err != nil {
		return
	}

	err = pn.FromSyllab(res.Record)
	if err != nil {
		return
	}

	if pn.RecordStructureID != personNumberStructureID {
		err = ganjine.ErrMisMatchedStructureID
	}
	return
}

// GetLastByPersonID method find and read last version of record by given PersonID
func (pn *PersonNumber) GetLastByPersonID() (err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: pn.hashPersonIDForRecordID(),
		Offset:   18446744073709551615,
		Limit:    1,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	if err != nil {
		return
	}

	pn.RecordID = indexRes.IndexValues[0]
	err = pn.GetByRecordID()
	if err.Equal(ganjine.ErrMisMatchedStructureID) {
		protocol.App.Log(log.WarnEvent(domainEnglish, "Platform collapsed!! HASH Collision Occurred on", personNumberStructureID)
	}
	return
}

// GetLastByNumber method find and read last version of record by given Number
func (pn *PersonNumber) GetLastByNumber() (err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: pn.hashNumberForPersonID(),
		Offset:   18446744073709551615,
		Limit:    1,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	if err != nil {
		return
	}

	pn.PersonID = indexRes.IndexValues[0]
	err = pn.GetLastByPersonID()
	if err.Equal(ganjine.ErrMisMatchedStructureID) {
		protocol.App.Log(log.WarnEvent(domainEnglish, "Platform collapsed!! HASH Collision Occurred on", personNumberStructureID)
	}
	return
}

/*
	-- PRIMARY INDEXES --
* /

// IndexRecordIDForPersonID save RecordID chain for PersonID
func (pn *PersonNumber) IndexRecordIDForPersonID() {
	var indexRequest = pehrest.HashSetValueReq{
		Type:       ganjine.RequestTypeBroadcast,
		IndexKey:   pn.hashPersonIDForRecordID(),
		IndexValue: pn.RecordID,
	}
	var err = psdk.HashSetValue(&indexRequest)
	if err != nil {
		if protocol.LogMode_Debug {
			protocol.App.Log(log.DebugEvent(domainEnglish, "Ganjine - Set Index:", err)
		}
		// TODO::: we must retry more due to record wrote successfully!
	}
}

func (pn *PersonNumber) hashPersonIDForRecordID() (hash [32]byte) {
	var buf = make([]byte, 40) // 8+32
	syllab.SetUInt64(buf, 0, personNumberStructureID)
	copy(buf[8:], pn.PersonID[:])
	return sha3.Sum256(buf)
}

/*
	-- SECONDARY INDEXES --
* /

// IndexPersonIDForNumber save PersonID chain for Number
func (pn *PersonNumber) IndexPersonIDForNumber() {
	var indexRequest = pehrest.HashSetValueReq{
		Type:       ganjine.RequestTypeBroadcast,
		IndexKey:   pn.hashNumberForPersonID(),
		IndexValue: pn.PersonID,
	}
	var err = psdk.HashSetValue(&indexRequest)
	if err != nil {
		if protocol.LogMode_Debug {
			protocol.App.Log(log.DebugEvent(domainEnglish, "Ganjine - Set Index:", err)
		}
		// TODO::: we must retry more due to record wrote successfully!
	}
}

func (pn *PersonNumber) hashNumberForPersonID() (hash [32]byte) {
	var buf = make([]byte, 16) // 8+8
	syllab.SetUInt64(buf, 0, personNumberStructureID)
	syllab.SetUInt64(buf, 8, pn.Number)
	return sha3.Sum256(buf)
}

/*
	-- Syllab Encoder & Decoder --
* /

func (pn *PersonNumber) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(payload)) < pn.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(pn.AppInstanceID[:], payload[88:])
	copy(pn.UserConnectionID[:], payload[120:])
	copy(pn.PersonID[:], payload[152:])
	pn.Number = syllab.GetUInt64(payload, 184)
	pn.Status = PersonNumberStatus(syllab.GetUInt8(payload, 192))
}

func (pn *PersonNumber) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(payload[88:], pn.AppInstanceID[:])
	copy(payload[120:], pn.UserConnectionID[:])
	copy(payload[152:], pn.PersonID[:])
	syllab.SetUInt64(payload, 184, pn.Number)
	syllab.SetUInt8(payload, 192, uint8(pn.Status))
	return heapIndex
}

func (pn *PersonNumber) LenAsSyllab() uint64 {
	return uint64(pn.LenOfSyllabStack() + pn.LenOfSyllabHeap())
}
func (pn *PersonNumber) LenOfSyllabStack() uint32     { return 193 }
func (pn *PersonNumber) LenOfSyllabHeap() (ln uint32) { return }
*/
