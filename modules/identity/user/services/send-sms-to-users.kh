var sendSMStoUsersService = service.Service{
	URN:                "urn:giti:sabz.city:service:send-sms-to-users",
	Domain:             DomainName,
	ID:                 15328375795250060855,
	IssueDate:          1608092756,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDCreate,
		UserType: protocol.UserTypeRegistered,
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Send SMS to Users",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"sendSMS",
	},

	SRPCHandler: SendSMStoUsersSRPC,
	ServeHTTP: SendSMStoUsersHTTP,
}

// SendSMStoUsersSRPC is sRPC handler of SendSMStoUsers service.
func SendSMStoUsersSRPC(st protocol.Stream) {
	var req = &sendSMStoUsersReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}
	err = sendSMStoUsers(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength)
}

// SendSMStoUsersHTTP is HTTP handler of SendSMStoUsers service.
func SendSMStoUsersHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &sendSMStoUsersReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	err = sendSMStoUsers(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
}

type sendSMStoUsersReq struct {
	// Numbers []uint64
	Message string
}

func sendSMStoUsers(st protocol.Stream, req *sendSMStoUsersReq) (err protocol.Error) {
	// err = st.Authorize()
	// if err != nil {
	// 	return
	// }

	// TODO::: given numbers

	var fileInfos []os.FileInfo
	var goErr error
	fileInfos, goErr = ioutil.ReadDir("D:/SabzCity/platform/sabz.city/datastore-files/12997682275679060581/")
	if goErr != nil {
		return
	}
	var des = make([]string, 0, 100)
	for _, fi := range fileInfos {
		var fileName, _ = base64.RawURLEncoding.DecodeString(fi.Name())
		var pn data.PersonNumber
		copy(pn.RecordID[:], fileName)
		err = pn.GetByRecordID()
		if err != nil {
			return
		}
		des = append(des, strconv.FormatUint(pn.Number, 10))

		if len(des) == 99 {
			var SendSMSReq = asanak.SendSMSReq{
				Destination: des,
				Message:     []byte(req.Message),
			}
			smsProvider.SendSMS(&SendSMSReq)

			// des = des[:0]
			return
		}
	}
	return
}

func GetUsersNumber() {
	protocol.App.Log(log.InfoEvent(domainEnglish, "Save users numbers ...")
	var fileInfos []os.FileInfo
	var goErr error
	fileInfos, goErr = ioutil.ReadDir("D:/SabzCity/platform/sabz.city/datastore-files/12997682275679060581/")
	if goErr != nil {
		protocol.App.Log(log.WarnEvent(domainEnglish, "GetUsersNumber:", goErr)
		return
	}
	var err protocol.Error
	var des = make([]byte, 0, 100000)
	for _, fi := range fileInfos {
		var fileName, _ = base64.RawURLEncoding.DecodeString(fi.Name())
		var pn data.PersonNumber
		copy(pn.RecordID[:], fileName)
		err = pn.GetByRecordID()
		if err != nil {
			continue
		}
		des = append(des, strconv.FormatUint(pn.Number, 10)...)
		des = append(des, '\n')
	}
	ioutil.WriteFile("D:/SabzCity/platform/sabz.city/datastore-files/numbers.txt", des, os.FileMode(os.O_RDWR))
	protocol.App.Log(log.InfoEvent(domainEnglish, "Save users numbers had been successfully")
}

