/*
package data

import (
	"golang.org/x/crypto/sha3"

	org "../../protocol"
	"libgo/ganjine"
	"libgo/pehrest"
	"libgo/syllab"
)

const (
	userNameStructureID uint64 = 8813670099917390348
)

var userNameStructure = ds.DataStructure{
	URN:             "urn:giti:sabz.city:data-structure:user-name",
	ID:              8813670099917390348,
	IssueDate:       1599020151,
	ExpiryDate:      0,
	ExpireInFavorOf: "",
	Status:          protocol.Software_PreAlpha,
	Structure:       UserName{},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "User Name",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "store user name that translate it to UserID for any purpose like login, send message, ...!",
	},
	TAGS: []string{
		"",
	},
}

// UserName ---Read locale description in userNameStructure---
type UserName struct {
	RequestID [16]byte // user-request domain
	UserID    [16]byte `index-hash:"ObjectID"`
	Name      string   `index-hash:"UserID"` // It is not replace of user ID! It usually use to find user by their friends!
	Status    org.UserNameStatus
}

// SaveNew method set some data and write entire UserName record with all indexes!
func (un *UserName) SaveNew() (err protocol.Error) {
	err = un.Set()
	if err != nil {
		return
	}

	un.IndexRecordIDForUserID()
	un.IndexUserIDForUserName()
	return
}

// Set method set some data and write entire UserName record!
func (un *UserName) Set() (err protocol.Error) {
	un.RecordStructureID = userNameStructureID
	un.RecordSize = un.LenAsSyllab()
	un.WriteTime = time.Now()
	un.OwnerAppID = protocol.OS.AppManifest().AppUUID()

	var req = ganjine.SetRecordReq{
		Type:   ganjine.RequestTypeBroadcast,
		Record: un.ToSyllab(),
	}
	un.RecordID = sha3.Sum256(req.Record[32:])
	copy(req.Record[0:], un.RecordID[:])

	err = gsdk.SetRecord(&req)
	if err != nil {
		// TODO::: Handle error situation
	}

	return
}

// GetByRecordID method read all existing record data by given RecordID!
func (un *UserName) GetByRecordID() (err protocol.Error) {
	var req = ganjine.GetRecordReq{
		RecordID:          un.RecordID,
		RecordStructureID: userNameStructureID,
	}
	var res *ganjine.GetRecordRes
	res, err = gsdk.GetRecord(&req)
	if err != nil {
		return
	}

	err = un.FromSyllab(res.Record)
	if err != nil {
		return
	}

	if un.RecordStructureID != userNameStructureID {
		err = ganjine.ErrMisMatchedStructureID
	}
	return
}

// GetLastByUserID method find and read last version of record by given UserID
func (un *UserName) GetLastByUserID() (err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: un.hashUserIDfoRecordID(),
		Offset:   18446744073709551615,
		Limit:    1,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	if err != nil {
		return
	}

	un.RecordID = indexRes.IndexValues[0]
	err = un.GetByRecordID()
	if err.Equal(ganjine.ErrMisMatchedStructureID) {
		protocol.App.Log(log.WarnEvent(domainEnglish, "Platform collapsed!! HASH Collision Occurred on", userNameStructureID)
	}
	return
}

// GetLastByUserName method find and read last version of record by given UserName
func (un *UserName) GetLastByUserName() (err protocol.Error) {
	var indexReq = &pehrest.HashGetValuesReq{
		IndexKey: un.hashUserNameforUserID(),
		Offset:   18446744073709551615,
		Limit:    1,
	}
	var indexRes *pehrest.HashGetValuesRes
	indexRes, err = psdk.HashGetValues(indexReq)
	if err != nil {
		return
	}

	un.UserID = indexRes.IndexValues[0]
	err = un.GetLastByUserID()
	if err.Equal(ganjine.ErrMisMatchedStructureID) {
		protocol.App.Log(log.WarnEvent(domainEnglish, "Platform collapsed!! HASH Collision Occurred on", userNameStructureID)
	}
	return
}

/*
	-- Search Methods --
* /

/*
	-- PRIMARY INDEXES --
* /

// IndexRecordIDForUserID  save RecordID chain for UserID
// Call in each update to the exiting record!
func (un *UserName) IndexRecordIDForUserID() {
	var indexRequest = pehrest.HashSetValueReq{
		Type:       ganjine.RequestTypeBroadcast,
		IndexKey:   un.hashUserIDfoRecordID(),
		IndexValue: un.RecordID,
	}
	var err = psdk.HashSetValue(&indexRequest)
	if err != nil {
		// TODO::: we must retry more due to record wrote successfully!
	}
}

func (un *UserName) hashUserIDfoRecordID() (hash [32]byte) {
	var buf = make([]byte, 40) // 8+32
	syllab.SetUInt64(buf, 0, userNameStructureID)
	copy(buf[8:], un.UserID[:])
	return sha3.Sum256(buf)
}

/*
	-- SECONDARY INDEXES --
* /

// IndexUserIDForUserName save UserID chain for Name
// Don't call in update to an exiting record!
func (un *UserName) IndexUserIDForName() {
	var indexRequest = pehrest.HashSetValueReq{
		Type:       ganjine.RequestTypeBroadcast,
		IndexKey:   un.hashNameforUserID(),
		IndexValue: un.UserID,
	}
	var err = psdk.HashSetValue(&indexRequest)
	if err != nil {
		// TODO::: we must retry more due to record wrote successfully!
	}
}

func (un *UserName) hashNameforUserID() (hash [32]byte) {
	var buf = make([]byte, 8+len(un.Name))
	syllab.SetUInt64(buf, 0, userNameStructureID)
	copy(buf[8:], un.Name)
	return sha3.Sum256(buf)
}

/*
	-- Syllab Encoder & Decoder --
* /

func (un *UserName) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < un.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(un.RecordID[:], buf[0:])
	un.RecordStructureID = syllab.GetUInt64(buf, 32)
	un.RecordSize = syllab.GetUInt64(buf, 40)
	un.WriteTime = time.Time(syllab.GetInt64(buf, 48))
	copy(un.OwnerAppID[:], buf[56:])

	copy(un.AppInstanceID[:], buf[88:])
	copy(un.UserConnectionID[:], buf[120:])
	copy(un.UserID[:], buf[152:])
	un.Name = syllab.UnsafeGetString(buf, 184)
	un.Status = UserNameStatus(syllab.GetUInt8(buf, 192))
	return
}

func (un *UserName) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	buf = make([]byte, un.LenAsSyllab())
	var heapIndex uint32 = un.LenOfSyllabStack() // Heap start index || Stack size!

	// copy(buf[0:], un.RecordID[:])
	syllab.SetUInt64(buf, 32, un.RecordStructureID)
	syllab.SetUInt64(buf, 40, un.RecordSize)
	syllab.SetInt64(buf, 48, int64(un.WriteTime))
	copy(buf[56:], un.OwnerAppID[:])

	copy(buf[88:], un.AppInstanceID[:])
	copy(buf[120:], un.UserConnectionID[:])
	copy(buf[152:], un.UserID[:])
	heapIndex = syllab.SetString(buf, un.Name, 184, heapIndex)
	syllab.SetUInt8(buf, 192, uint8(un.Status))
	return
}

func (un *UserName) LenOfSyllabStack() uint32 {
	return 193
}

func (un *UserName) LenOfSyllabHeap() (ln uint32) {
	ln += uint32(len(un.Name))
	return
}

func (un *UserName) LenAsSyllab() uint64 {
	return uint64(un.LenOfSyllabStack() + un.LenOfSyllabHeap())
}
*/
