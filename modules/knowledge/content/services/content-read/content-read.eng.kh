tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Content_Read in "modules/knowledge/content/services/content-read/content-read.kh"

tp Domain mt (self Content_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Content")(s, VoidError)
}

tp Summary mt (self Content_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads a content by its UUID")(s, VoidError)
}

tp Overview mt (self Content_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Answers the kind and the text of the content of the given UUID, found being false when no content of that UUID is kept. It reads no timeline and changes nothing.")(s, VoidError)
}

tp UserActionNote mt (self Content_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Content_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
