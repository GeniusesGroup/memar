tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Label in "modules/knowledge/label/protocol/label.kh"

tp Domain mt (self Label) () (s String) {
    CharacterRun_From.FromCharacterRun("Label")(s, VoidError)
}

tp Summary mt (self Label) () (s String) {
    CharacterRun_From.FromCharacterRun("A title and the identity of the concept it names")(s, VoidError)
}

tp Overview mt (self Label) () (s String) {
    CharacterRun_From.FromCharacterRun("A title that links a record to others outside the structure of their ids. The title alone is no identity: a topic and a task kind may be titled alike, and the identifier tells them apart. A label is declared as code in the labels folder of the module whose it is, and what it means is what its own detail methods say, when it expires and which label replaces it are those of the type. A label takes another label, its kind, by composing it.")(s, VoidError)
}

tp UserActionNote mt (self Label) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Label) () (s String) {
    CharacterRun_From.FromCharacterRun("Compare labels by identifier, never by title.")(s, VoidError)
}
