tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Label_Detach in "modules/knowledge/label/services/detach-label/protocol/detach-label.kh"

tp Domain mt (self Label_Detach) () (s String) {
	CharacterRun_From.FromCharacterRun("Label")(s, VoidError)
}

tp Summary mt (self Label_Detach) () (s String) {
	CharacterRun_From.FromCharacterRun("Takes a label off a thing")(s, VoidError)
}

tp Overview mt (self Label_Detach) () (s String) {
	CharacterRun_From.FromCharacterRun("The thing keeps every other label. A thing that does not carry the label is left as it is and nothing is written.")(s, VoidError)
}

tp UserActionNote mt (self Label_Detach) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Label_Detach) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
