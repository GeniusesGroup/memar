tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Labels in "modules/knowledge/label/services/get-labels/protocol/get-labels.kh"

tp Domain mt (self Get_Labels) () (s String) {
	CharacterRun_From.FromCharacterRun("Label")(s, VoidError)
}

tp Summary mt (self Get_Labels) () (s String) {
	CharacterRun_From.FromCharacterRun("Answers the labels a thing carries")(s, VoidError)
}

tp Overview mt (self Get_Labels) () (s String) {
	CharacterRun_From.FromCharacterRun("The answer is the labels the thing carries. It knows no kind of thing and changes nothing.")(s, VoidError)
}

tp UserActionNote mt (self Get_Labels) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Labels) () (s String) {
	CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
