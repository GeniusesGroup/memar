tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Text_Edit in "modules/knowledge/text/services/edit-text/edit-text.kh"

tp Domain mt (self Text_Edit) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Edit) () (s String) {
    CharacterRun_From.FromCharacterRun("Replaces exact text in a held text, or writes a whole text into one, without damaging it")(s, VoidError)
}

tp Overview mt (self Text_Edit) () (s String) {
    CharacterRun_From.FromCharacterRun("Replaces exact text in a held text, or writes a whole text into one, without damaging it.")(s, VoidError)
}

tp UserActionNote mt (self Text_Edit) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Edit) () (s String) {
    CharacterRun_From.FromCharacterRun("Both methods read, match and write under the lock of the held text, so the text matched is the text written. The held text is decoded with the codec port and written without a byte-order mark, with the line ending of the choice or the held text, and a final newline; a mark found is removed and hadMark reports it. Replace refuses with Text_Error_Edit_TextAbsent, Text_Error_Edit_OldEmpty, Text_Error_Edit_NotUtf8, Text_Error_Edit_MatchAbsent or Text_Error_Edit_MatchAmbiguous (more than one match and every not asked); the answer is the number of replacements and an empty replacement is allowed. The named texts an edit takes as the text to replace or the replacement are read and decoded by the caller with DecodeNamed, ending in Text_Error_Edit_NamedTextNotUtf8. Write refuses with Text_Error_Edit_CreateNotAsked (the held text is absent and create was not asked), Text_Error_Edit_EmptyText (empty or only whitespace) or Text_Error_Edit_NotUtf8; its answer is the size written. WriteFrom writes the text of the source, a held text decoded with DecodeBare so that a leading mark stays as U+FEFF; bytes that are not valid end in Text_Error_Edit_NotUtf8, a refusal, as the Python raises for a source. Failures: Text_Error_Edit_ReadFailed, Text_Error_Edit_WriteFailed, Text_Error_Edit_Locked, Text_Error_Edit_LockUnwritable, Text_Error_Edit_ChangedWhileWaiting. Nothing is written on a refusal.")(s, VoidError)
}
