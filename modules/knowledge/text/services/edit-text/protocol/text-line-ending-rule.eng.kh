tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Text_LineEnding_Rule in "modules/knowledge/text/services/edit-text/protocol/text-line-ending-rule.kh"

tp Domain mt (self Text_LineEnding_Rule) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_LineEnding_Rule) () (s String) {
    CharacterRun_From.FromCharacterRun("Which line ending a text has, which one to write, and a text brought to it")(s, VoidError)
}

tp Overview mt (self Text_LineEnding_Rule) () (s String) {
    CharacterRun_From.FromCharacterRun("Which line ending a text has, which one to write, and a text brought to it.")(s, VoidError)
}

tp UserActionNote mt (self Text_LineEnding_Rule) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_LineEnding_Rule) () (s String) {
    CharacterRun_From.FromCharacterRun("Detect answers crlf when a crlf occurs and no bare lf does, and lf otherwise, an empty text included; a lone carriage return is ignored by Detect. Choose answers the given choice, else Detect of the held text. Normalize turns every line ending of the text, lf, crlf or a lone carriage return, into the line ending, and ends a non-empty text with it.")(s, VoidError)
}
