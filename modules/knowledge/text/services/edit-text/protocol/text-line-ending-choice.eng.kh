tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Text_LineEnding_Choice in "modules/knowledge/text/services/edit-text/protocol/text-line-ending-choice.kh"

tp Domain mt (self Text_LineEnding_Choice) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_LineEnding_Choice) () (s String) {
    CharacterRun_From.FromCharacterRun("The line ending a caller asked for, or none")(s, VoidError)
}

tp Overview mt (self Text_LineEnding_Choice) () (s String) {
    CharacterRun_From.FromCharacterRun("The line ending a caller asked for, or none.")(s, VoidError)
}

tp UserActionNote mt (self Text_LineEnding_Choice) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_LineEnding_Choice) () (s String) {
    CharacterRun_From.FromCharacterRun("When none is given the line ending the held text already has is kept, and lf is used for a text that holds none yet.")(s, VoidError)
}
