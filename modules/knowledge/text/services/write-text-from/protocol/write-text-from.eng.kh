tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Write_Text_From in "modules/knowledge/text/services/write-text-from/protocol/write-text-from.kh"

tp Domain mt (self Write_Text_From) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Write_Text_From) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes one held text into another without damaging it")(s, VoidError)
}

tp Overview mt (self Write_Text_From) () (s String) {
    CharacterRun_From.FromCharacterRun("Writes the source text, decoded so a leading mark stays, under the lock of the held text. Bytes that are not valid end in Text_Error_Edit_NotUtf8. The answer is the size written. Nothing is written on a refusal.")(s, VoidError)
}

tp UserActionNote mt (self Write_Text_From) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Write_Text_From) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
