tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Text_Edit_Store in "modules/knowledge/text/protocol/text-edit-store.kh"

tp Domain mt (self Text_Edit_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Edit_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The port through which a held text is read and replaced")(s, VoidError)
}

tp Overview mt (self Text_Edit_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The port through which a held text is read and replaced.")(s, VoidError)
}

tp UserActionNote mt (self Text_Edit_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Edit_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The text edit service reaches a held text only through this port. An adapter realizes it. Exists is false for what is not a held text. GetBytes and ReplaceBytes answer Text_Error_Edit_ReadFailed and Text_Error_Edit_WriteFailed; ReplaceBytes makes what the held text needs to exist. GetStamp is what the edit lock compares. GetKey is an opaque key of the held text, the same for every way of naming it, from which the edit lock takes the identity of what it locks.")(s, VoidError)
}
