tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Text_LineEnding in "modules/knowledge/text/protocol/text-line-ending.kh"

tp Domain mt (self Text_LineEnding) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_LineEnding) () (s String) {
    CharacterRun_From.FromCharacterRun("The line ending of a text, one of two: lf or crlf")(s, VoidError)
}

tp Overview mt (self Text_LineEnding) () (s String) {
    CharacterRun_From.FromCharacterRun("The line ending of a text, one of two: lf or crlf.")(s, VoidError)
}

tp UserActionNote mt (self Text_LineEnding) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_LineEnding) () (s String) {
    CharacterRun_From.FromCharacterRun("GetSequence answers the characters that end a line. A new text has lf.")(s, VoidError)
}
