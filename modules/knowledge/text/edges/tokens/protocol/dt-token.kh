tp Field_TextID in "org/modules/knowledge/text/protocol/dt-uuid.kh"
tp U64 in "memar/modules/math/integer/unsigned-64.kh"

tp Token ab {
	Field_TextID
}

tp GetTokenOffsetInSentence mt (self Token) () (o U64)

tp GetTokenOffsetInText mt (self Token) () (o U64)

tp GetOffsetInSentence mt (self Token) () (o U64)

tp GetOffsetInText mt (self Token) () (o U64)

tp GetWeight mt (self Token) () (w U64)

tp GetScoreInSentence mt (self Token) () (s U64)

tp GetScoreInText mt (self Token) () (s U64)

tp GetRankingScore mt (self Token) () (s U64)

