    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Error_Edit_Locked) () (s String) {
    CharacterRun_From.FromCharacterRun("Another cooperating process holds the lock on the text past the wait")(s, VoidError)
}

tp Overview mt (self Text_Error_Edit_Locked) () (s String) {
    CharacterRun_From.FromCharacterRun("Another cooperating process holds the lock on the text past the wait.")(s, VoidError)
