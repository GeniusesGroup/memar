    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Error_Edit_Locked) () (s String) {
    CharacterRun_From.FromCharacterRun("A lock older than the stale limit is a dead holder and is taken over, so only a live holder is waited out.")(s, VoidError)
}

tp Domain mt (self Text_Error_Edit_LockUnwritable) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Error_Edit_LockUnwritable) () (s String) {
    CharacterRun_From.FromCharacterRun("The lock or the intent note of the lock could not be made or written")(s, VoidError)
}

tp Overview mt (self Text_Error_Edit_LockUnwritable) () (s String) {
    CharacterRun_From.FromCharacterRun("The lock or the intent note of the lock could not be made or written.")(s, VoidError)
}

tp UserActionNote mt (self Text_Error_Edit_LockUnwritable) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Error_Edit_LockUnwritable) () (s String) {
    CharacterRun_From.FromCharacterRun("A failure of the realization that an earlier realization let escape as an unhandled operating-system error, before anything is written to the text; a realization catches it into this error.")(s, VoidError)
}

tp Domain mt (self Text_Error_Edit_ChangedWhileWaiting) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Error_Edit_ChangedWhileWaiting) () (s String) {
    CharacterRun_From.FromCharacterRun("The text changed between the moment its state was taken and the moment the lock was held")(s, VoidError)
}

tp Overview mt (self Text_Error_Edit_ChangedWhileWaiting) () (s String) {
    CharacterRun_From.FromCharacterRun("The text changed between the moment its state was taken and the moment the lock was held.")(s, VoidError)
}

