    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Error_Edit_NotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("A text that must be read, the held text or the source of a write, is not valid for the codec")(s, VoidError)
}

tp Overview mt (self Text_Error_Edit_NotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("A text that must be read, the held text or the source of a write, is not valid for the codec.")(s, VoidError)
}

tp UserActionNote mt (self Text_Error_Edit_NotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Error_Edit_NotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("The held text is not written to, because writing a decoded-with-replacement copy is how damage spreads. The source of a write is decoded bare.")(s, VoidError)
}

