    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Text_Error_Edit_ChangedWhileWaiting) () (s String) {
    CharacterRun_From.FromCharacterRun("The lock is released and nothing is written; the call must be made again against the current content. The detail names what differed.")(s, VoidError)
}

tp Domain mt (self Text_Error_Edit_NamedTextNotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("Text")(s, VoidError)
}

tp Summary mt (self Text_Error_Edit_NamedTextNotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("A named text taken as the text to replace or the replacement is not valid for the codec")(s, VoidError)
}

tp Overview mt (self Text_Error_Edit_NamedTextNotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("A named text taken as the text to replace or the replacement is not valid for the codec.")(s, VoidError)
