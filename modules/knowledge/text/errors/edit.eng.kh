}

tp DevActionNote mt (self Text_Error_Edit_NamedTextNotUtf8) () (s String) {
    CharacterRun_From.FromCharacterRun("A failure, not a refusal. The decode is bare: a leading byte-order mark stays as the character U+FEFF.")(s, VoidError)
