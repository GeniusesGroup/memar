tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Log_Record in "modules/process/log/services/record-event/record-event.kh"

tp Domain mt (self Log_Record) () (s String) {
    CharacterRun_From.FromCharacterRun("Log")(s, VoidError)
}

tp Summary mt (self Log_Record) () (s String) {
    CharacterRun_From.FromCharacterRun("Records an event in a log")(s, VoidError)
}

tp Overview mt (self Log_Record) () (s String) {
    CharacterRun_From.FromCharacterRun("Keeps the event in the log it is given, after every record already there, which a dispatch to the logger does not promise: a dispatch only tells the listeners. The event carries its time, type, level, message and stack; whatever else a raiser wants kept, such as an id, rides in the message. It knows no event.")(s, VoidError)
}

tp UserActionNote mt (self Log_Record) () (s String) {
    CharacterRun_From.FromCharacterRun("Nothing to do; a caller that must not lose the event checks the error.")(s, VoidError)
}

tp DevActionNote mt (self Log_Record) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
