tp Error in "modules/process/error/protocol/error.kh"
tp Rule_Decision in "modules/process/rule/protocol/decision.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Rule_Engine ab
tp Rule_Engine_GetDecision mt (self Rule_Engine) (key String) (d Rule_Decision, e Error)

tp Dispose mt (self Rule_Engine) () ()

// https://www.ibm.com/docs/en/imdmcdhsa/10.1.0?topic=rules-understanding-rule-engine-methods
// https://www.ibm.com/docs/en/imdmcdhsa/11.6.0?topic=features-external-business-rules
tp loadRules mt (self Rule_Engine) () ()

tp assertFact mt (self Rule_Engine) () ()

tp fireRules mt (self Rule_Engine) () ()

tp clearFacts mt (self Rule_Engine) () ()

