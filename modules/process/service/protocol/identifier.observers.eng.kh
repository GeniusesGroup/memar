tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Observer_Service_Identifier in "modules/process/service/protocol/identifier.observers.kh"

tp Domain mt (self Observer_Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Service")(s, VoidError)
}

tp Summary mt (self Observer_Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Observe a service identity")(s, VoidError)
}

tp Overview mt (self Observer_Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Returns the complete service UUID carried by the value. Observing this identity requires no local service declaration or instance. Resolution, availability and execution are separate operations.")(s, VoidError)
}

tp UserActionNote mt (self Observer_Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Observer_Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
