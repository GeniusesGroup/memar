tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Service_Identifier in "modules/process/service/protocol/identifier.kh"

tp Domain mt (self Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Service")(s, VoidError)
}

tp Summary mt (self Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identity of a service declaration")(s, VoidError)
}

tp Overview mt (self Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("The complete Identifier is the Type identity of the published service declaration, expressed in its domain role. It retains the common identifier value and generation contract across SDKs, builds and destinations.")(s, VoidError)
}

tp UserActionNote mt (self Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Service_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
