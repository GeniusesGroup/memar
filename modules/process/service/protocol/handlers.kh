tp Error in "modules/process/error/protocol/error.kh"
tp Net_Socket_2 in "modules/net/protocol/socket.kh"
tp Process_Request in "modules/process/request/protocol/request.kh"
tp Process_Response in "modules/process/response/protocol/response.kh"

// Handlers is just test (approver) interface and MUST NOT use directly in any signature.
tp Handlers ab

// Call service remotely by preferred(SDK generator choose) protocol.
tp Do mt (self Handlers) (req Process_Request) (res Process_Response, err Error)

// Call service locally by import service package to other one
tp Process mt (self Handlers) (sk Net_Socket_2, req Process_Request) (res Process_Response, err Error)
