tp Capsule_LifeCycle in "modules/computer/capsule/protocol/life_cycle_contract.kh"
tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Observer_MediaType in "modules/identifier/mediatype/protocol/media-type.observers.kh"
tp Observer_Request in "modules/process/request/protocol/request.observers.kh"
tp Observer_Response in "modules/process/response/protocol/response.observers.kh"
tp Observer_ActionType in "modules/process/operation/protocol/action.observers.kh"
tp Observer_OperationID in "modules/process/operation/protocol/id.observers.kh"
tp Importance in "modules/process/operation/protocol/importance.kh"

// Service is the interface that must implement by any struct to be a service.
tp Service ab {
    Capsule_LifeCycle
    Observer_OperationID
    Observer_ActionType
    Importance
    Observer_Request
    Observer_Response
    DataType
    Observer_MediaType
}

