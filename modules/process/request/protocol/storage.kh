tp Pagination_Offset_Request in "modules/computer/adt/container/protocol/pagination.kh"
tp Pagination_Response in "modules/computer/adt/container/protocol/pagination.kh"

tp Request_Storage_Key_Primary ab {
	Observer_RequestID
}

tp Request_Storage_Key_Cluster ab {
	Observer_RequestID
}

tp Service_ListRequestIDsByUserID_Request ab {
	Field_UserUUID
	Pagination_Offset_Request
}

tp Service_ListRequestIDsByUserID_Response ab {
	Observer_RequestIDs
	Pagination_Response
}

