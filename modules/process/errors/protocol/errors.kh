tp Datatype_ID in "modules/computer/datatype/protocol/id.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Errors use to register errors to get them in a desire way e.g. ErrorID in http headers.
tp Process_Errors ab
tp Process_Errors_Register mt (self Process_Errors) (errorToRegister Error) (err Error)

tp Process_Errors_GetByID mt (self Process_Errors) (id Datatype_ID) (err Error)

tp Process_Errors_GetByMediaType mt (self Process_Errors) (mt_ String) (err Error)
