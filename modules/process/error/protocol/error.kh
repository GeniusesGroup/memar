tp Nil in "modules/computer/adt/protocol/nil.kh"
tp Type in "modules/computer/type/protocol/type.kh"
tp Observer_MediaType in "modules/computer/mediatype/protocol/media-type.observers.kh"

// Trade-off vs Go realization: this composition keeps Nil only. A Go pointer-nil check can stand in for
// the fuller ADT family; Khayyam variables are references, so a realization that needs IsNull/IsEmpty
// must compose that family explicitly (RFC 495442). Equality remains DataTypeID-based; see error.md.
tp Error ab {
    Type
    Observer_MediaType
    Nil
}
