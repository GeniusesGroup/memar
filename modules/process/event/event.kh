tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Time in "modules/time/protocol/time.kh"

// An Event is a runtime occurrence and not a stored record: it carries the identity its DataType
// supplies and the time it occurred, and nothing else the protocol requires. Where the contract is
// stated: `docs/protocols/process/event.md` -> What an Event Is.
//
//memar:impl memar/process/event/protocol.Event
tp Event cp {
    dt DataType
    time Time
}

//memar:impl memar/computer/datatype/protocol.Observer_DataType
tp GetDataType mt (self Event) () (d DataType)

//memar:impl memar/time/protocol.Observer_Time
tp GetTime mt (self Event) () (t Time)

// Initialization is the capsule's own behavior carrying its own domain arguments, which is what
// `CapsuleLifeCycle` states when it declines to name an `Init` of its own.
tp Init mt (self Event) (dt DataType, time Time) ()

