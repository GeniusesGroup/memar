tp Error in "modules/process/error/protocol/error.kh"
tp Target_Race_Event in "modules/process/event/protocol/target-race-event.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Detector ab {
    Target_Race_Event
}

// Static means when something is done not at Runtime but could be done anytime e.g. commit, PR, pre-compile, compile, ...
//
// https://en.wikipedia.org/wiki/Static_program_analysis
tp Detector_Static ab {
    Detector
}
tp AnalyzeVariable mt (self Detector_Static) (ast String, varName String) (err Error)

// Dynamic means when something is done at Runtime
//
// https://en.wikipedia.org/wiki/Dynamic_program_analysis
tp Detector_Dynamic ab {
    Detector
}
// Enable re-enables(Start) handling(Monitoring) of race events in the current thread.
tp Enable mt (self Detector_Dynamic) () (err Error)

// Disable disables handling of race synchronization events in the current thread.
tp Disable mt (self Detector_Dynamic) () (err Error)

