tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp String in "modules/codec/string/protocol/string.kh"

// ActionType indicate all ActionType.
// Famous action types are CRUD(Create, Read, Update, Delete)
// https://en.wikipedia.org/wiki/Create,_read,_update_and_delete
// It will usually use in authorization process to authorize operations.
tp Operation_ActionType ab
// Set given ActionType to the AT.
// e.g. c.Set(ActionType_Create|ActionType_Delete)
tp Operation_ActionType_Set mt (self Operation_ActionType) (with Operation_ActionType) ()

// Check check given ActionType exist in the AT!
tp Operation_ActionType_Check mt (self Operation_ActionType) (with Operation_ActionType) (exist Boolean)

// String return name of crud in app language.
tp Operation_ActionType_String mt (self Operation_ActionType) () (s String)

