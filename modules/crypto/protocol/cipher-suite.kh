tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp String in "modules/codec/string/protocol/string.kh"

// https://en.wikipedia.org/wiki/Cipher_suite
tp Crypto_CipherSuite ab {
    DataType
}
tp Crypto_CipherSuite_CipherSuite mt (self Crypto_CipherSuite) () (s String)

