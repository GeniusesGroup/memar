tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Element_Status in "modules/gui/protocol/element-status.kh"
tp Element_Type in "modules/gui/protocol/element-type.kh"
tp Scroll in "modules/gui/protocol/scroll.kh"
tp Signed in "modules/math/integer/protocol/signed.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Element
tp GUI_Element ab {
    // event_p.Target[Element]
    // https://developer.mozilla.org/en-US/docs/Web/API/Element/clientHeight
    Scroll
}

// It must be unique e.g. product
tp GUI_Element_Name mt (self GUI_Element) () (s String)

tp GUI_Element_Type_2 mt (self GUI_Element) () (t Element_Type)

tp GUI_Element_Status_2 mt (self GUI_Element) () (s Element_Status)

tp HTML mt (self GUI_Element) (outer Boolean) (s String)

tp GUI_Element_Text mt (self GUI_Element) () (s String)

// Create new element as copy of existing element, new element is a full (deep) copy of the element and
// is disconnected initially from the DOM.
tp GUI_Element_Clone mt (self GUI_Element) () (e GUI_Element)

tp GUI_Element_CloneTo mt (self GUI_Element) (dom GUI_Element) ()

tp GUI_Element_GetElementById mt (self GUI_Element) (id String) (e GUI_Element)

tp GUI_Element_GetElementsByName mt (self GUI_Element) (name String) (e GUI_Element)

tp GUI_Element_GetElementsByClassName mt (self GUI_Element) (class String) (e GUI_Element)

tp GUI_Element_GetElementsByTagName mt (self GUI_Element) (tag String) (e GUI_Element)

tp GUI_Element_GetElementsByTagNameNS mt (self GUI_Element) (tag String) (e GUI_Element)

tp HasFocus mt (self GUI_Element) () (b Boolean)

tp GUI_Element_Append mt (self GUI_Element) (e GUI_Element) ()

tp GUI_Element_Prepend mt (self GUI_Element) (e GUI_Element) ()

tp GUI_Element_ParentElement mt (self GUI_Element) () (e GUI_Element)

tp GUI_Element_NthChild mt (self GUI_Element) (n Signed) (e GUI_Element)
// NextSibling()
// PreviousSibling()
// RemoveChild()
// ReplaceChild()

