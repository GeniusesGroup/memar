tp ScreenMode in "modules/gui/protocol/screen-mode.kh"
tp ScreenOrientation in "modules/gui/protocol/screen-orientation.kh"
tp ScreenType in "modules/gui/protocol/screen-type.kh"
tp Signed in "modules/math/integer/protocol/signed.kh"

// Screen indicate some information about screen that a page-state(window) can render to it.
// https://developer.mozilla.org/en-US/docs/Web/API/Screen
tp Screen ab
tp GUI_Screen_ID mt (self Screen) () (s Signed)

tp GUI_Screen_Type mt (self Screen) () (s ScreenType)

tp Mode mt (self Screen) () (s ScreenMode)

tp Height mt (self Screen) () (s Signed)

tp Width mt (self Screen) () (s Signed)

tp AvailHeight mt (self Screen) () (s Signed)

tp AvailWidth mt (self Screen) () (s Signed)

// The rate where screen updates are performed (per seconds).
tp UpdateRate mt (self Screen) () (s Signed)

tp PixelDepth mt (self Screen) () (s Signed)

tp ColorDepth mt (self Screen) () (s Signed)

tp Orientation mt (self Screen) () (s ScreenOrientation)

// event_p.Target[GUIScreen]
