tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Signed in "modules/math/integer/protocol/signed.kh"
tp Scroll_Behavior in "modules/gui/protocol/scroll-behavior.kh"
tp String in "modules/codec/string/protocol/string.kh"

// Scroll indicate scroll behavior in any elements.
// If the element's direction is rtl (right-to-left), then scrollLeft is 0 when the scrollbar is at its rightmost position
// (at the start of the scrolled content), and then increasingly negative as you scroll towards the end of the content.
tp Scroll ab
// https://developer.mozilla.org/en-US/docs/Web/API/Window/scroll
// Scrolls to the HTML element with the given id.
tp ScrollToID mt (self Scroll) (id String) ()

// https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollWidth
tp ScrollWidth mt (self Scroll) () (s Signed)

// https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollHeight
tp ScrollHeight mt (self Scroll) () (s Signed)

// https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollTop
tp ScrollTop mt (self Scroll) () (s Signed)

// https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollLeft
tp ScrollLeft mt (self Scroll) () (s Signed)

// Returns true if the scrollbars are visible; otherwise, returns false.
// To hide/diasable/force-show scrollbars use CSS >>
// 		::-webkit-scrollbar { display: none; }	/* Hide - Chrome/Safari/Webkit */
// 		scrollbar-width: none;	/* Hide - W3C Candidate Recommendation (Just FireFox) */
// 		overflow: hidden;		/* Hide and disable scrollbars */
//		overflow-y: hidden; 	/* Hide and disable vertical scrollbar */
//		overflow-x: hidden; 	/* Hide and disable horizontal scrollbar */
// 		overflow: scroll;   	/* Show scrollbars */
// 		overflow-y: scroll; 	/* Show vertical scrollbar */
// 		overflow-x: scroll;		/* Show horizontal scrollbar */
tp Scrollbars mt (self Scroll) () (x Boolean, y Boolean)

// event_p.Target[Scroll]

tp Scroll_Options cp {
    Behavior Scroll_Behavior
}

// TODO(go-migrate): [tp ScrollToID] Scroll_Options is a Go struct (a cp here) and khayyam.md → Abstraction says an abstraction's methods use abstractions, not capsules, as arguments; decide whether Scroll_Options becomes an ab or the signature changes. Proposed `tp GUI_Scroll_Scroll mt (self Scroll) (x Signed, y Signed, options Scroll_Options) ()`.
