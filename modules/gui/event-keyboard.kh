tp Boolean in "modules/math/boolean/protocol/boolean.kh"

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent
tp KeyboardEvent ab {
}

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent#events
tp GUI_KeyboardEvent_Type mt (self KeyboardEvent) () (k KeyboardEventType)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/key
// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/key/Key_Values
tp GUI_KeyboardEvent_Key mt (self KeyboardEvent) () (k KeyboardEventKey)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/code
tp Code mt (self KeyboardEvent) () (k KeyboardEventCode)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/repeat
tp Repeat mt (self KeyboardEvent) () (b Boolean)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/altKey
tp AltKey mt (self KeyboardEvent) () (b Boolean)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/ctrlKey
tp CtrlKey mt (self KeyboardEvent) () (b Boolean)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/shiftKey
tp ShiftKey mt (self KeyboardEvent) () (b Boolean)

// https://developer.mozilla.org/en-US/docs/Web/API/KeyboardEvent/metaKey
tp MetaKey mt (self KeyboardEvent) () (b Boolean)

tp KeyboardEventType ab

tp KeyboardEventKey ab

tp KeyboardEventCode ab

