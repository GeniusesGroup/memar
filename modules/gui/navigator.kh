tp GUI_Page_2 in "modules/gui/page.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp GUI_Navigator_2 cp {
    switcherPage GUI_Page_2
    homePage GUI_Page_2
    activePage GUI_Page_2
}

// Active a page like alt+tab in windows to show Pages() and their states
tp SwitcherPage mt (self GUI_Navigator_2) () () {}

// It must reorder by recently active page be last item in the array

// Navigate(url string)
tp ActivatePage mt (self GUI_Navigator_2) (url String) () {}

