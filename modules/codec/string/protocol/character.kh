tp Logic_Equivalence in "modules/math/logic/protocol/equivalence.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Clone_String_Character in "modules/computer/adt/marker/protocol/clone.kh"
tp Copy_String_Character in "modules/computer/adt/marker/protocol/copy.kh"

tp Equivalence mt (self Character) (with Character) (b Boolean)

// Character is base of any character encoding
tp Character ab {
    Logic_Equivalence
    Clone_String_Character
    Copy_String_Character
}

