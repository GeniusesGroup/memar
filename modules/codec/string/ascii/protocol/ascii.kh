tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// ASCII abbreviated from American Standard Code for Information Interchange,
// is a character encoding standard for electronic communication.
// https://en.wikipedia.org/wiki/ASCII
tp String_ASCII ab {
    String
}

// Stringer code the data to/from human readable format.
tp ASCII_Stringer ab {
    ASCII_Stringer_To
    ASCII_Stringer_From
}

// Stringer code the data to human readable format.
tp ASCII_Stringer_To ab
tp ASCII_Stringer_To_ToASCII mt (self ASCII_Stringer_To) () (str String_ASCII, err Error)

// Stringer_From code the data from human readable format.
tp ASCII_Stringer_From ab
tp ASCII_Stringer_From_FromASCII mt (self ASCII_Stringer_From) (str String_ASCII) (err Error)

