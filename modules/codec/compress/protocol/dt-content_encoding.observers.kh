tp String in "modules/codec/string/protocol/string.kh"

// Observer_ContentEncoding is standard shape of http compress coding type string
tp Observer_ContentEncoding ab
// https://en.wikipedia.org/wiki/HTTP_compression
// https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Encoding
// https://www.iana.org/assignments/http-parameters/http-parameters.xml#content-coding
tp GetContentEncoding mt (self Observer_ContentEncoding) () (s String)
