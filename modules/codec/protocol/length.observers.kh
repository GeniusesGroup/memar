tp Codec_Length in "modules/codec/protocol/length.kh"

tp Observer_Codec_Length ab
// GetSerializationLength return value ln, that is the max number of bytes that will written as encode data by Encode()||Marshal()
// 0 means no data and -1 means can't tell until full write.
// Due to prevent performance penalty, Implementors can return max number instead of actual number of length.
tp GetSerializationLength mt (self Observer_Codec_Length) () (l Codec_Length)
