tp Observer_URI in "modules/net/uri/protocol/uri.observers.kh"
tp Observer_Scheme in "modules/net/uri/protocol/scheme.observers.kh"
tp Observer_URN_NID in "modules/net/uri/protocol/urn-nid.observers.kh"
tp Observer_URN_NSS in "modules/net/uri/protocol/urn-nss.observers.kh"

// URN is a division of URI
// e.g. "urn:isbn:0451450523"
// https://en.wikipedia.org/wiki/Uniform_Resource_Name
tp URN ab {
    Observer_URI
    // always return "urn"
    Observer_Scheme
    Observer_URN_NID
    Observer_URN_NSS
}
