tp Capsule_LifeCycle in "modules/computer/capsule/protocol/life_cycle_contract.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Observer_Error in "modules/process/error/protocol/error.observers.kh"
tp Observer_Request in "modules/process/request/protocol/request.observers.kh"
tp Observer_Response in "modules/process/response/protocol/response.observers.kh"
tp Observer_Service in "modules/process/service/protocol/service.observers.kh"
tp Importance in "modules/process/operation/protocol/importance.kh"
tp Observer_RequestID in "modules/process/request/protocol/dt-uuid.observers.kh"
tp OSI_Application_Handler in "modules/net/protocol/osi_7-application-handler.kh"
tp Process_Request in "modules/process/request/protocol/request.kh"
tp Process_Response in "modules/process/response/protocol/response.kh"
tp Service in "modules/process/service/protocol/service.kh"

// OSI_Application usually use to save state and release thread(goroutine) in waiting state
tp OSI_Application ab {
    Capsule_LifeCycle
    Observer_RequestID
    Observer_Service
    Observer_Request
    Observer_Response
// just indicate peer error that receive by response of the request.
    Observer_Error
    OSI_Application_LowLevelAPIs
}

// OSI_Application_LowLevelAPIs is low level APIs, don't use them in the services layer, if you don't know how it can be effect the application.
tp OSI_Application_LowLevelAPIs ab {
    Importance
    OSI_Application_Handler
}
// Below Set methods must call just once,
// But some protocol like http allow to change it after first set in a reusable socket like IP/TCP.
tp SetService mt (self OSI_Application_LowLevelAPIs) (ser Service) ()

tp SetRequest mt (self OSI_Application_LowLevelAPIs) (req Process_Request) ()

tp SetResponse mt (self OSI_Application_LowLevelAPIs) (res Process_Response) ()

tp SetError mt (self OSI_Application_LowLevelAPIs) (err Error) ()

