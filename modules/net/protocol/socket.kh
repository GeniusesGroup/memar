tp Observer_NetworkAddresses in "modules/net/protocol/address.observers.kh"
tp Observer_OSI_Application in "modules/net/protocol/osi_7-application.observers.kh"
tp Observer_OSI_DataLink in "modules/net/protocol/osi_2-data_link.observers.kh"
tp Observer_OSI_Network in "modules/net/protocol/osi_3-network.observers.kh"
tp Observer_OSI_Physical in "modules/net/protocol/osi_1-physical.observers.kh"
tp Observer_OSI_Presentation in "modules/net/protocol/osi_6-presentation.observers.kh"
tp Observer_OSI_Session in "modules/net/protocol/osi_5-session.observers.kh"
tp Observer_OSI_Transport in "modules/net/protocol/osi_4-transport.observers.kh"
tp Observer_SocketStatus in "modules/net/protocol/status.observers.kh"
tp Observer_Net_Socket_Buffers in "modules/net/protocol/socket-buffer.observers.kh"
tp Mutator_SocketStatus in "modules/net/protocol/status.mutators.kh"
tp Operation_Timeout in "modules/process/operation/protocol/timeout.kh"

// Socket term in many textbooks refers to an entity that is uniquely identified by the socket number.
// In the original definition of socket given in RFC 147,[2] as it was related to the ARPA network in 1971,
// "the socket is specified as a 32-bit number with even sockets identifying receiving sockets and odd sockets identifying sending sockets."
// Today, however, socket communications are bidirectional.
// Any stateful network need to be implement a socket.
// https://en.wikipedia.org/wiki/Network_socket
tp Net_Socket_2 ab {
// string form of full address of socket to dial any time later.
    Observer_NetworkAddresses
    Observer_SocketStatus
    Socket_LowLevelAPIs
}

// Socket_LowLevelAPIs is low level APIs, don't use them in the services layer, if you don't know how it can be effect the application.
// It will use in chunks managing packages e.g. sRPC, QUIC, TCP, UDP, ... or Application layer protocols e.g. HTTP, ...
tp Socket_LowLevelAPIs ab {
    Observer_OSI_Physical
    Observer_OSI_DataLink
    Observer_OSI_Network
    Observer_OSI_Transport
    Observer_OSI_Session
    Observer_OSI_Presentation
    Observer_OSI_Application
    Mutator_SocketStatus
    Observer_Net_Socket_Buffers
    Operation_Timeout
}

// Socket term in many textbooks refers to an entity that is uniquely identified by the socket number.
// In the original definition of socket given in RFC 147,[2] as it was related to the ARPA network in 1971,
// "the socket is specified as a 32-bit number with even sockets identifying receiving sockets and odd sockets identifying sending sockets."
// Today, however, socket communications are bidirectional.
// Any stateful network need to be implement a socket.
// https://en.wikipedia.org/wiki/Network_socket
tp Socket ab {
// string form of full address of socket to dial any time later.
    Observer_NetworkAddresses
    Observer_SocketStatus
    Socket_LowLevelAPIs
}

