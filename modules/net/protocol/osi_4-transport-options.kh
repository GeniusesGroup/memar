tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Duration in "modules/time/duration/protocol/duration.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp OSI_Transport_Options ab
tp SetLinger mt (self OSI_Transport_Options) (d Duration) (e Error)

tp SetKeepAlivePeriod mt (self OSI_Transport_Options) (d Duration) (e Error)

tp SetNoDelay mt (self OSI_Transport_Options) (noDelay Boolean) (e Error)

