tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp SRPC_Frame_OpenStream in "modules/net/srpc/protocol/frame-open_stream.kh"

tp Domain mt (self SRPC_Frame_OpenStream) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self SRPC_Frame_OpenStream) () (s String) {
    CharacterRun_From.FromCharacterRun("Open a stream")(s, VoidError)
}

tp Overview mt (self SRPC_Frame_OpenStream) () (s String) {
    CharacterRun_From.FromCharacterRun("Carries complete Identifiers for the selected service, compression and payload protocol declarations. Their presence in this frame guarantees identity values only. DataLength is the expected number of payload octets. Weight supplies scheduling information; the creator supplies the retained stream identity.")(s, VoidError)
}

tp UserActionNote mt (self SRPC_Frame_OpenStream) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self SRPC_Frame_OpenStream) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
