tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp SRPC_Frame_DataSignature in "modules/net/srpc/protocol/frame-data_signature.kh"

tp Domain mt (self SRPC_Frame_DataSignature) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self SRPC_Frame_DataSignature) () (s String) {
    CharacterRun_From.FromCharacterRun("Signature over stream data")(s, VoidError)
}

tp Overview mt (self SRPC_Frame_DataSignature) () (s String) {
    CharacterRun_From.FromCharacterRun("Carries the signature content associated with the identified stream.")(s, VoidError)
}

tp UserActionNote mt (self SRPC_Frame_DataSignature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self SRPC_Frame_DataSignature) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
