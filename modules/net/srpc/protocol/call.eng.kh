tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Call_Identifier in "modules/net/srpc/protocol/call.kh"

tp Domain mt (self Call_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self Call_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identity of one invocation")(s, VoidError)
}

tp Overview mt (self Call_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("The creator uses the shared identifier generator once. Peers retain the complete identity for requests, responses and control messages referring to this invocation.")(s, VoidError)
}

tp UserActionNote mt (self Call_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Call_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
