tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp SRPC_Frame in "modules/net/srpc/protocol/frame.kh"

tp Domain mt (self SRPC_Frame) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self SRPC_Frame) () (s String) {
    CharacterRun_From.FromCharacterRun("Common sRPC frame surface")(s, VoidError)
}

tp Overview mt (self SRPC_Frame) () (s String) {
    CharacterRun_From.FromCharacterRun("FrameLength counts octets following the common networking frame identity. A frame fits within the underlying packet MTU; fragmentation is unsupported. Prefer frames at most 8192 octets long when the underlying limit permits.")(s, VoidError)
}

tp UserActionNote mt (self SRPC_Frame) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self SRPC_Frame) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
