tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp SRPC_Payload in "modules/net/srpc/protocol/payload.kh"

tp Domain mt (self SRPC_Payload) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self SRPC_Payload) () (s String) {
    CharacterRun_From.FromCharacterRun("Encoded application payload")(s, VoidError)
}

tp Overview mt (self SRPC_Payload) () (s String) {
    CharacterRun_From.FromCharacterRun("The selected service defines the request or response content. Syllab is the default codec; the declared application contract may select another codec.")(s, VoidError)
}

tp UserActionNote mt (self SRPC_Payload) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self SRPC_Payload) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
