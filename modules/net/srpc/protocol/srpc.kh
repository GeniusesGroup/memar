tp Error in "modules/process/error/protocol/error.kh"
tp Net_Socket_2 in "modules/net/protocol/socket.kh"

// Handler is any object to be sRPC service handler.
tp Net_Handler ab
// ServeSRPC method is sRPC handler of the service with Syllab codec data in the payload.
tp ServeSRPC mt (self Net_Handler) (sk Net_Socket_2) (err Error)

