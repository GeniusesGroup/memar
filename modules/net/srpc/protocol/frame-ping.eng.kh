tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp SRPC_Frame_Ping in "modules/net/srpc/protocol/frame-ping.kh"

tp Domain mt (self SRPC_Frame_Ping) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self SRPC_Frame_Ping) () (s String) {
    CharacterRun_From.FromCharacterRun("Ping frame")(s, VoidError)
}

tp Overview mt (self SRPC_Frame_Ping) () (s String) {
    CharacterRun_From.FromCharacterRun("Carries the common frame surface.")(s, VoidError)
}

tp UserActionNote mt (self SRPC_Frame_Ping) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self SRPC_Frame_Ping) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
