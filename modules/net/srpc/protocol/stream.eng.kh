tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Stream_Identifier in "modules/net/srpc/protocol/stream.kh"

tp Domain mt (self Stream_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("sRPC")(s, VoidError)
}

tp Summary mt (self Stream_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("Identity of one stream")(s, VoidError)
}

tp Overview mt (self Stream_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("The creator uses the shared identifier generator once when opening a stream. Peers retain the complete identity for the stream lifetime.")(s, VoidError)
}

tp UserActionNote mt (self Stream_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Stream_Identifier) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
