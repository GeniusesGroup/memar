// GetLastOrganizationsIDSRPC is sRPC handler of GetLastOrganizationsID service.
func GetLastOrganizationsIDSRPC(st protocol.Stream) {
	var res *getLastOrganizationsIDRes
	res, err = getLastOrganizationsID(st)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength+res.LenAsSyllab())
	res.ToSyllab(srpc.GetPayload(st.OutcomePayload))
}

// GetLastOrganizationsIDHTTP is HTTP handler of GetLastOrganizationsID service.
func GetLastOrganizationsIDHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var res *getLastOrganizationsIDRes
	res, err = getLastOrganizationsID(st)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
	httpRes.SetBody(json.NewCodec(res))
}

type getLastOrganizationsIDRes struct {
	IDs [][32]byte
}

func getLastOrganizationsID(st protocol.Stream) (res *getLastOrganizationsIDRes, err protocol.Error) {
	res = &getLastOrganizationsIDRes{}
	var oa = data.OrganizationAuthentication{
		WriteTime: time.Now(),
	}
	res.IDs, err = oa.FindLastIDs(18446744073709551615, 9, 30)
	if err.Equal(ganjine.ErrRecordNotFound) {
		err = nil
	}
	return
}

