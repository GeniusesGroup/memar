func (res *getLastOrganizationsIDRes) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < res.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	res.IDs = syllab.UnsafeGet32ByteArraySlice(buf, 0)
	return
}

func (res *getLastOrganizationsIDRes) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	syllab.Set32ByteArrayArray(buf, res.IDs, 0, heapIndex)
	return
}

func (res *getLastOrganizationsIDRes) LenOfSyllabStack() uint32 {
	return 8
}

func (res *getLastOrganizationsIDRes) LenOfSyllabHeap() (ln uint32) {
	ln = uint32(len(res.IDs) * 32)
	return
}

func (res *getLastOrganizationsIDRes) LenAsSyllab() uint64 {
	return uint64(res.LenOfSyllabStack() + res.LenOfSyllabHeap())
}

func (res *getLastOrganizationsIDRes) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
