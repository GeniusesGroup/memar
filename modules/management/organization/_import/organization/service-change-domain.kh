package org

import (
	"libgo/achaemenid"
	"libgo/authorization"
	"libgo/http"
	"libgo/json"
	"libgo/protocol"
	"libgo/service"
	"libgo/srpc"
	"libgo/syllab"
	"libgo/uuid"
)

var updateOrganizationService = service.Service{
	URN:                "urn:giti:sabz.city:service:update-organization",
	Domain:             DomainName,
	ID:                 10606019130074578397,
	IssueDate:          1604472326,
	ExpiryDate:         0,
	ExpireInFavorOfURN: "",
	ExpireInFavorOfID:  0,
	Status:             protocol.Software_PreAlpha,

	Authorization: authorization.Service{
		CRUD:     authorization.CRUDUpdate,
		UserType: protocol.UserType_Org | protocol.UserType_Person, // TODO::: remove person when register org free by everyone.
	},

	Name: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "Update Organization",
	},
	Description: map[protocol.LanguageID]string{
		protocol.LanguageEnglish: "",
	},
	TAGS: []string{
		"OrganizationAuthentication",
	},

	SRPCHandler: UpdateOrganizationSRPC,
	ServeHTTP:   UpdateOrganizationHTTP,
}

// UpdateOrganizationSRPC is sRPC handler of UpdateOrganization service.
func UpdateOrganizationSRPC(st protocol.Stream) {
	var req = &updateOrganizationReq{}
	err = req.FromSyllab(srpc.GetPayload(st.IncomePayload))
	if err != nil {
		return
	}

	err = updateOrganization(st, req)
	// Check if any error occur in business logic
	if err != nil {
		return
	}

	st.OutcomePayload = make([]byte, srpc.MinLength)
}

// UpdateOrganizationHTTP is HTTP handler of UpdateOrganization service.
func UpdateOrganizationHTTP(st protocol.Stream, httpReq *http.Request, httpRes *http.Response) {
	var req = &updateOrganizationReq{}
	err = req.FromJSON(httpReq.Body().Marshal())
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}

	err = updateOrganization(st, req)
	// Check if any error occur in business logic
	if err != nil {
		httpRes.SetStatus(http.StatusBadRequestCode, http.StatusBadRequestPhrase)
		return
	}
	httpRes.SetStatus(http.StatusOKCode, http.StatusOKPhrase)
}

type updateOrganizationReq struct {
	ID           [32]byte `json:",string"`
	SocietyID    [32]byte `json:",string"`
	ServicesType data.OrganizationAuthenticationType

	LeaderPersonID [32]byte `json:",string"` // not empty just if need to change leader and make new connection for this person as leader!s
}

func updateOrganization(st protocol.Stream, req *updateOrganizationReq) (err protocol.Error) {
	err = st.Authorize()
	if err != nil {
		return
	}
	// Validate data here due to service use internally by other services!
	err = req.validator()
	if err != nil {
		return
	}

	var oa = data.OrganizationAuthentication{
		ID: req.ID,
	}
	err = oa.GetLastByID()
	if err != nil {
		return
	}

	if oa.Status == data.OrganizationStatusBlocked {
		err = ErrBlockedByJustice
		return
	}
	if req.SocietyID != oa.SocietyID {
		oa.Status = data.OrganizationStatusTransferred
	}

	oa = data.OrganizationAuthentication{
		AppInstanceID:    achaemenid.App.Nodes.LocalNode.InstanceID,
		UserConnectionID: st.Connection.ID,
		ID:               req.ID,
		SocietyID:        req.SocietyID,
		QuiddityID:       oa.QuiddityID,
		ServicesType:     req.ServicesType,
		Status:           oa.Status,
	}
	err = oa.Set()
	if err != nil {
		return
	}
	oa.IndexRecordIDForID()

	if req.LeaderPersonID != [32]byte{} {
		// make new connection for leader
		var uac = data.UserAppConnection{
			Status:      data.UserAppConnectionIssued,
			Description: "Leader connection created in update organization",

			ID: uuid.Random32Byte(),

			// ThingID:          st.Connection.ThingID,
			UserID:           oa.ID,
			UserType:         protocol.UserType_Org,
			DelegateUserID:   req.LeaderPersonID,
			DelegateUserType: st.Connection.UserType,
		}
		err = uac.SaveNew()
		if err != nil {
			return
		}
	}

	return
}

func (req *updateOrganizationReq) validator() (err protocol.Error) {
	return
}

/*
	Request Encoders & Decoders
* /

func (req *updateOrganizationReq) FromSyllab(payload []byte, stackIndex uint32) {
	if uint32(len(buf)) < req.LenOfSyllabStack() {
		err = syllab.ErrShortArrayDecode
		return
	}

	copy(req.ID[:], buf[0:])
	copy(req.SocietyID[:], buf[32:])
	req.ServicesType = data.OrganizationAuthenticationType(syllab.GetUInt8(buf, 64))
	copy(req.LeaderPersonID[:], buf[65:])
	return
}

func (req *updateOrganizationReq) ToSyllab(payload []byte, stackIndex, heapIndex uint32) (freeHeapIndex uint32) {
	copy(buf[0:], req.ID[:])
	copy(buf[32:], req.SocietyID[:])
	syllab.SetUInt8(buf, 64, uint8(req.ServicesType))
	copy(buf[65:], req.LeaderPersonID[:])
	return
}

func (req *updateOrganizationReq) LenOfSyllabStack() uint32 {
	return 97
}

func (req *updateOrganizationReq) LenOfSyllabHeap() (ln uint32) {
	return
}

func (req *updateOrganizationReq) LenAsSyllab() uint64 {
	return uint64(req.LenOfSyllabStack() + req.LenOfSyllabHeap())
}

func (req *updateOrganizationReq) FromJSON(payload []byte) (remaining []byte, err protocol.Error) {
	var decoder = json.DecoderUnsafeMinified{Buf: payload}
	for err == nil {
		var keyName = decoder.DecodeKey()
		switch keyName {
		case "ID":
			err = decoder.DecodeByteArrayAsBase64(req.ID[:])
		case "SocietyID":
			err = decoder.DecodeByteArrayAsBase64(req.SocietyID[:])
		case "ServicesType":
			var num uint8
			num, err = decoder.DecodeUInt8()
			req.ServicesType = data.OrganizationAuthenticationType(num)
		case "LeaderPersonID":
			err = decoder.DecodeByteArrayAsBase64(req.LeaderPersonID[:])
		default:
			err = decoder.NotFoundKeyStrict()
		}

		if decoder.End() {
			return
		}
	}
	return
}

func (req *updateOrganizationReq) ToJSON(payload []byte) (added []byte, err protocol.Error) {
	var encoder = json.Encoder{Buf: payload}

	encoder.EncodeString(`{"ID":"`)
	encoder.EncodeByteSliceAsBase64(req.ID[:])

	encoder.EncodeString(`","SocietyID":"`)
	encoder.EncodeByteSliceAsBase64(req.SocietyID[:])

	encoder.EncodeString(`","ServicesType":`)
	encoder.EncodeUInt8(uint8(req.ServicesType))

	encoder.EncodeString(`,"LeaderPersonID":"`)
	encoder.EncodeByteSliceAsBase64(req.LeaderPersonID[:])

	encoder.EncodeString(`"}`)
	return encoder.Buf
}

func (req *updateOrganizationReq) LenAsJSON() (ln int) {
	ln = 192
	return
}
