tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Timeline_Place in "modules/management/timeline/services/timeline-place/timeline-place.kh"

tp Domain mt (self Timeline_Place) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Timeline_Place) () (s String) {
    CharacterRun_From.FromCharacterRun("Places a content in a timeline")(s, VoidError)
}

tp Overview mt (self Timeline_Place) () (s String) {
    CharacterRun_From.FromCharacterRun("Places a content in the timeline of the given UUID, whatever the content holds and whoever the timeline is of: a task, a group or a person. It stamps the instant of the placement and passes it to the store. The number returned is the placement's, the next number of the timeline across all kinds. Refused with Timeline_Error_Changed when another placer placed one of the same kind after the number the caller read, and with Timeline_Error_NotFound when the UUID is no node; nothing is then placed.")(s, VoidError)
}

tp UserActionNote mt (self Timeline_Place) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Timeline_Place) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
