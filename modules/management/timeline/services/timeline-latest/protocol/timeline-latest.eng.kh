tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Get_Latest in "modules/management/timeline/services/timeline-latest/protocol/timeline-latest.kh"

tp Domain mt (self Get_Latest) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Get_Latest) () (s String) {
    CharacterRun_From.FromCharacterRun("Answers the latest placement of a kind in a timeline")(s, VoidError)
}

tp Overview mt (self Get_Latest) () (s String) {
    CharacterRun_From.FromCharacterRun("Answers the latest placement of the named kind on the timeline. Found is false when none of that kind is placed. It reads the content of nothing and changes nothing. Timeline_Error_NotFound when the timeline is no node.")(s, VoidError)
}

tp UserActionNote mt (self Get_Latest) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Get_Latest) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
