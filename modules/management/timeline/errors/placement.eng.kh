tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Timeline_Error_NotFound in "modules/management/timeline/errors/placement.kh"
tp Timeline_Error_Changed in "modules/management/timeline/errors/placement.kh"

tp Domain mt (self Timeline_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Timeline_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("The timeline does not exist")(s, VoidError)
}

tp Overview mt (self Timeline_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("A timeline exists once its UUID is a node of any kind; this UUID is no node, so nothing can be read from it or placed in it.")(s, VoidError)
}

tp UserActionNote mt (self Timeline_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("Check the UUID of the timeline.")(s, VoidError)
}

tp DevActionNote mt (self Timeline_Error_NotFound) () (s String) {
    CharacterRun_From.FromCharacterRun("A caller fault; nothing was placed.")(s, VoidError)
}

tp Domain mt (self Timeline_Error_Changed) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Timeline_Error_Changed) () (s String) {
    CharacterRun_From.FromCharacterRun("The timeline changed since it was read")(s, VoidError)
}

tp Overview mt (self Timeline_Error_Changed) () (s String) {
    CharacterRun_From.FromCharacterRun("A later placement of the same kind exists than the one the caller read; nothing was placed over what another placer put.")(s, VoidError)
}

tp UserActionNote mt (self Timeline_Error_Changed) () (s String) {
    CharacterRun_From.FromCharacterRun("Read the timeline again and decide again.")(s, VoidError)
}

tp DevActionNote mt (self Timeline_Error_Changed) () (s String) {
    CharacterRun_From.FromCharacterRun("Another placer placed first; nothing was placed.")(s, VoidError)
}
