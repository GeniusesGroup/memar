tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Timeline_Placement_Store in "modules/management/timeline/protocol/timeline-placement-store.kh"

tp Domain mt (self Timeline_Placement_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Timeline")(s, VoidError)
}

tp Summary mt (self Timeline_Placement_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Where the placements of a timeline are kept, read and added")(s, VoidError)
}

tp Overview mt (self Timeline_Placement_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The only way a placement is read or added, given to a service; a store calls no other store. A placement is the timeline's UUID, the content placed, its kind, the placer and the instant it was placed; the kind is the label of the content's template. A timeline exists once its UUID is a node of any kind; Timeline_Error_NotFound means the UUID is no node. ReadLatestPlacement returns the number and content of the latest placement of a kind, found being false when the timeline holds none of that kind. AddPlacement puts the content as the next placement, numbered after every placement of the timeline whatever its kind, so a number is unique in the timeline, ordered by instant and then by number, and never over one that is there. after is the number of the latest placement of the same kind that the caller read, zero when it read none; a store that holds a later one of that same kind refuses with Timeline_Error_Changed, and a placement of another kind does not make it refuse. How a placement is kept is the realization's.")(s, VoidError)
}

tp UserActionNote mt (self Timeline_Placement_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Timeline_Placement_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
