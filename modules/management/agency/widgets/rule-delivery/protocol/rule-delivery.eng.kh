tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Rule_Delivery in "modules/management/agency/widgets/rule-delivery/protocol/rule-delivery.kh"

tp Domain mt (self Rule_Delivery) () (s String) {
    CharacterRun_From.FromCharacterRun("Agency")(s, VoidError)
}

tp Summary mt (self Rule_Delivery) () (s String) {
    CharacterRun_From.FromCharacterRun("Delivers the rules that bear on the subject of a step")(s, VoidError)
}

tp Overview mt (self Rule_Delivery) () (s String) {
    CharacterRun_From.FromCharacterRun("Takes the subject of the step an agent is about to take, reads the Topic labels from its words, and returns the rules that bear on it: each with its document, anchor and Why line. The agent opens the rules that govern the step and follows them.")(s, VoidError)
}

tp UserActionNote mt (self Rule_Delivery) () (s String) {
    CharacterRun_From.FromCharacterRun("Call ForSubject with the subject before an act; open and follow the rules it returns.")(s, VoidError)
}

tp DevActionNote mt (self Rule_Delivery) () (s String) {
    CharacterRun_From.FromCharacterRun("Task 20261108-T114321Z-21456. Composes the text widget that reads Topic labels from words with the rule domain's Find_Rules.")(s, VoidError)
}
