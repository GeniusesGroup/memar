tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Group_Membership_Store in "modules/management/group/protocol/group-membership-store.kh"

tp Domain mt (self Group_Membership_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Group")(s, VoidError)
}

tp Summary mt (self Group_Membership_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("Where the memberships of groups are kept, read and changed")(s, VoidError)
}

tp Overview mt (self Group_Membership_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("The only way a membership is read or changed, given to a service; a store calls no other store. A membership is one joined edge from the group to the member for each role it has, the role in the edge's key, each with its reverse joined_to written in the same batch and the instant the membership began. A group is any node whose address is given; the group of a thing has the thing's address and needs no node of its own, and takes nothing from the group of any other node, whatever edge or placement joins the two. The store reads no edge of another domain on that node: not any part of another domain kept at the same address. AddJoined writes the edges of one or more roles and refuses a member already joined in any role with Group_Error_AlreadyMember; SetJoinedRoles replaces the member's role edges, and RemoveJoined removes them all; both refuse a user who is no member with Group_Error_NotMember, and ReadJoined answers found false for one. ReadMemberAfter and ReadGroupAfter page the members of a group and the groups of a member, and ReadMemberOfRoleAfter the members of a group in one role, the zero UUID giving the first. How a membership is kept is the realization's.")(s, VoidError)
}

tp UserActionNote mt (self Group_Membership_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Group_Membership_Store) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
