tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Group_Joined in "modules/management/group/edges/joined/protocol/group-joined.kh"

tp Domain mt (self Group_Joined) () (s String) {
    CharacterRun_From.FromCharacterRun("Group")(s, VoidError)
}

tp Summary mt (self Group_Joined) () (s String) {
    CharacterRun_From.FromCharacterRun("One joined membership from a group to a user")(s, VoidError)
}

tp Overview mt (self Group_Joined) () (s String) {
    CharacterRun_From.FromCharacterRun("One joined edge from a group to a user, written with its reverse joined_to. The group and the user are Group_Identifier and User_Identifier composed here, and GetJoinedAt is the instant the membership began. This edge does not carry a role. Who accepted the membership is the Request of the join.")(s, VoidError)
}

tp UserActionNote mt (self Group_Joined) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Group_Joined) () (s String) {
    CharacterRun_From.FromCharacterRun("The identifiers are the domain types, not MemoryAddress and not Identifier. A role is not a value of this edge.")(s, VoidError)
}
