tp Field_GroupID in "modules/management/group/protocol/dt-uuid.kh"
tp Observer_RequestID in "modules/process/request/protocol/uuid.observers.kh"
tp Observer_Time_Request in "modules/process/time/protocol/request.observers.kh"

tp Observer_GroupMemberLimit_Minimum ab

tp GetMinimum mt (self Observer_GroupMemberLimit_Minimum) () (n W32)

tp Observer_GroupMemberLimit_Expected ab

tp GetExpected mt (self Observer_GroupMemberLimit_Expected) () (n W32)

tp Observer_GroupMemberLimit_Maximum ab

tp GetMaximum mt (self Observer_GroupMemberLimit_Maximum) () (n W32)

tp GroupMemberLimitDataModel ab {
	Field_GroupID
	Observer_GroupMemberLimit_Minimum
	Observer_GroupMemberLimit_Expected
	Observer_GroupMemberLimit_Maximum
	Observer_RequestID
	Observer_Time_Request
}

