tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Group_Membership_Read in "modules/management/group/services/group-membership-read/group-membership-read.kh"

tp Domain mt (self Group_Membership_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Group")(s, VoidError)
}

tp Summary mt (self Group_Membership_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("Reads who is in a group now, the groups of a member, and a member's roles")(s, VoidError)
}

tp Overview mt (self Group_Membership_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("ReadMemberAfter answers the next member of the group after the given one, and ReadGroupAfter the next group of the member through the reverse edge, the zero UUID giving the first and found being false when there is none; ReadMemberOfRoleAfter does the same over the members in one role, through that role's edges. ReadMembership answers one member's roles and when it joined, found being false when the user is no member. It reads only the joined edge: it changes nothing.")(s, VoidError)
}

tp UserActionNote mt (self Group_Membership_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Group_Membership_Read) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
