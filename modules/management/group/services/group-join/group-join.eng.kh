tp String in "modules/computer/codec/string/protocol/string.kh"
tp CharacterRun_From in "modules/computer/codec/string/protocol/character-run-from.kh"
vr VoidError in "modules/process/error/protocol/void-error.kh"
tp Group_Join in "modules/management/group/services/group-join/group-join.kh"

tp Domain mt (self Group_Join) () (s String) {
    CharacterRun_From.FromCharacterRun("Group")(s, VoidError)
}

tp Summary mt (self Group_Join) () (s String) {
    CharacterRun_From.FromCharacterRun("Makes a user a member of a group with roles, changes its roles, and ends its membership")(s, VoidError)
}

tp Overview mt (self Group_Join) () (s String) {
    CharacterRun_From.FromCharacterRun("Join writes one joined edge from the group to the member for each of one or more roles, each with its reverse and the instant; a member already joined in any role is refused with Group_Error_AlreadyMember. SetRoles replaces the role edges of a member, and Leave ends the membership; both refuse a user who is no member with Group_Error_NotMember. Joining a thing is joining the group that has its address. It writes nothing but the join, and it does not judge whether the user may join: holding the thing is Ownership's claimer_is, and who may join is Rights', composed with this service by a widget.")(s, VoidError)
}

tp UserActionNote mt (self Group_Join) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}

tp DevActionNote mt (self Group_Join) () (s String) {
    CharacterRun_From.FromCharacterRun("")(s, VoidError)
}
