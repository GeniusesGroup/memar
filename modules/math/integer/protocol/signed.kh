tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp String in "modules/codec/string/protocol/string.kh"

// https://en.wikipedia.org/wiki/Integer_(computer_science)
tp Signed ab
//memar:impl memar/math/logic/protocol.Equivalence
tp Signed_Equal mt (self Signed) (with Signed) (b Boolean)

//memar:impl memar/codec/string/protocol.Stringer
tp ToString mt (self Signed) () (str String, err Error)

tp FromString mt (self Signed) (str String) (err Error)

