tp Observer_MemoryAddress in "modules/memory/address/protocol/address.observers.kh"
tp Mutator_SetMemoryAddress in "modules/memory/address/protocol/address.mutators.kh"

tp Logic_Equivalence in "modules/math/logic/protocol/equivalence.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"

tp Equivalence mt (self MemoryAddress) (with MemoryAddress) (b Boolean)

tp Equivalence mt (self Memory_Pointer) (with Memory_Pointer) (b Boolean)

tp MemoryAddress ab {
    Logic_Equivalence
}

// Pointers are the most primitive type of reference.
// A pointer is a simple, more concrete implementation of the more abstract reference data type.
// Pointer is underlying memory structure for any datatype or capsule.
// But it CAN implement auto by compiler like `Deinit()`, `Drop()`, ...
//
// https://en.wikipedia.org/wiki/Pointer_(computer_programming)
tp Memory_Pointer ab {
    Observer_MemoryAddress
    Mutator_SetMemoryAddress
// container_p.Container[]
    Logic_Equivalence
}

