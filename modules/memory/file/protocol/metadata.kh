tp Observer_Container_AvailableLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_Capacity in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_Container_OccupiedLength in "modules/computer/adt/container/protocol/length.observers.kh"
tp Observer_File_URI in "modules/memory/file/protocol/uri.observers.kh"
tp Observer_File_URI_Parsed in "modules/memory/file/protocol/uri.observers.kh"
tp Observer_Time_Access in "modules/process/time/protocol/dt-access.observers.kh"
tp Observer_Time_Creation in "modules/process/time/protocol/dt-creation.observers.kh"
tp Observer_Time_Modification in "modules/process/time/protocol/dt-modification.observers.kh"

// Metadata is the interface that must implement by any file and directory.
tp File_Metadata ab {
    Observer_File_URI
    Observer_File_URI_Parsed
// Capacity use in sparse file usage.
// In computer science, a sparse file is a type of computer file that attempts to use file system space more efficiently when the file itself is partially empty.
// https://en.wikipedia.org/wiki/Sparse_file
    Observer_Container_Capacity
    Observer_Container_OccupiedLength
    Observer_Container_AvailableLength
    Observer_Time_Creation
    Observer_Time_Modification
    Observer_Time_Access
}

