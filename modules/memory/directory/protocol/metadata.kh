tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp File_Metadata in "modules/memory/file/protocol/metadata.kh"

// Metadata is the interface that must implement by any file and directory.
tp Directory_Metadata ab {
    File_Metadata
}
tp DirNumber mt (self Directory_Metadata) () (n NumberOfElement)

tp FileNumber mt (self Directory_Metadata) () (n NumberOfElement)

