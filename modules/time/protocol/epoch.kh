tp DataType in "modules/computer/datatype/protocol/data-type.kh"
tp Logic_Equivalence in "modules/math/logic/protocol/equivalence.kh"
tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp Stringer_To in "modules/codec/string/protocol/stringer.kh"

// Epoch is the interface that must implement by any time capsule.
// It is base on Epoch and Second terms to work anywhere (in any planet in the universe).
// https://en.wikipedia.org/wiki/Epoch
tp Epoch ab {
    DataType
    Stringer_To
    Logic_Equivalence
}

tp Equivalence mt (self Epoch) (with Epoch) (b Boolean)

