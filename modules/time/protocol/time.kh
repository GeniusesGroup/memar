tp Duration in "modules/time/duration/protocol/duration.kh"
tp Time_Stringer in "modules/time/protocol/time_stringer.kh"
tp Observer_Epoch in "modules/time/protocol/epoch.observers.kh"
tp Epoch in "modules/time/protocol/epoch.kh"
tp Signed in "modules/math/integer/protocol/signed.kh"
tp Unsigned in "modules/math/integer/protocol/unsigned.kh"
tp Error in "modules/process/error/protocol/error.kh"

tp Time ab {
    Observer_Epoch
}

tp SecondElapsed mt (self Time) () (d Duration)
tp NanoInSecondElapsed mt (self Time) () (d Duration)
tp PartsInEpoch mt (self Time) (reference Epoch) (seconds Signed, nanosecondRemainder Unsigned, err Error)
