tp Boolean in "modules/math/boolean/protocol/boolean.kh"
tp NumberOfElement in "modules/computer/adt/container/protocol/length.kh"
tp Error in "modules/process/error/protocol/error.kh"
tp Function_Access in "modules/computer/function/protocol/access.kh"
tp String in "modules/codec/string/protocol/string.kh"

tp Domain ab
//memar:impl computer/capsule/protocol.Accessor
tp App_Domain_Get mt (self Domain) () (s String)

//memar:impl computer/capsule/protocol.Assignment
tp App_Domain_Set mt (self Domain) (value String) ()

tp App_Domain_Name mt (self Domain) () (s String)

tp Abbreviation mt (self Domain) () (s String)

tp App_Domain_Access mt (self Domain) () (a Function_Access)

tp App_Domain_Optional mt (self Domain) () (b Boolean)

tp Validate mt (self Domain) () (e Error)

tp SetDefault mt (self Domain) () ()

//memar:impl memar/protocol.Len
tp App_Domain_Length mt (self Domain) () (n NumberOfElement)

//memar:impl memar/codec/string/protocol.Stringer
tp ToString mt (self Domain) () (str String, err Error)

tp FromString mt (self Domain) (str String) (err Error)

