{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Khayyam",
  "scopeName": "source.khayyam",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#import-declaration" },
    { "include": "#vr-declaration" },
    { "include": "#tp-declaration" },
    { "include": "#keywords-control" },
    { "include": "#typed-pairs" },
    { "include": "#illegal-numbers" },
    { "include": "#illegal-operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "import-declaration": {
      "patterns": [
        {
          "match": "\\b(tp)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.khayyam" },
            "2": { "name": "entity.name.type.khayyam" },
            "3": { "name": "keyword.control.import.khayyam" }
          },
          "comment": "Matches 'tp Name in' -> tp(Purple) Name(Green) in(Purple)"
        },
        {
          "match": "\\b(vr)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.khayyam" },
            "2": { "name": "variable.other.khayyam" },
            "3": { "name": "keyword.control.import.khayyam" }
          },
          "comment": "Matches 'vr name in' -> vr(Purple) name(Blue/White) in(Purple)"
        }
      ]
    },
    "vr-declaration": {
      "match": "\\b(vr)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.khayyam" },
        "2": { "name": "variable.other.khayyam" },
        "3": { "name": "entity.name.type.khayyam" }
      },
      "comment": "Matches 'vr name type' -> vr(Purple) name(Blue/White) type(Green)"
    },
    "tp-declaration": {
      "match": "\\b(tp)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.khayyam" },
        "2": { "name": "entity.name.type.khayyam" }
      }
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.khayyam",
          "match": "\\b(in|cp|mt|ab|sc)\\b"
        }
      ]
    },
    "typed-pairs": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "variable.parameter.khayyam" },
        "2": { "name": "entity.name.type.khayyam" }
      },
      "comment": "Matches any 'name type' pair, like inside method args (mt) -> name(Blue/White) type(Green)"
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.khayyam",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.khayyam",
          "match": "//.*$"
        },
        {
          "name": "comment.block.slash-star.khayyam",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.khayyam",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.khayyam",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "illegal-numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.numeric.khayyam",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "illegal-operators": {
      "patterns": [
        {
          "name": "invalid.illegal.operator.khayyam",
          "match": "(\\+|\\-|\\*|\\/|\\=|\\==|\\!|\\<|\\>)"
        }
      ]
    }
  }
}