{
  "name": "Khayyam",
  "displayName": "Khayyam Language",
  "description": "Rich language support for the Khayyam Programming Language",
  "publisher": "Geniuses.Group",
  "homepage": "https://github.com/GeniusesGroup/memar/",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "./images/khayyam-icon.png",
  "galleryBanner": {
    "color": "green",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GeniusesGroup/memar.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "khayyam",
        "aliases": [
          "Khayyam",
          "khayyam"
        ],
        "extensions": [
          ".kh"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/khayyam-file-icon.png",
          "dark": "./images/khayyam-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "khayyam",
        "scopeName": "source.khayyam",
        "path": "./syntaxes/khayyam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "khayyam",
        "path": "./snippets/khayyam.code-snippets"
      }
    ],
    "configurationDefaults": {
      "[khayyam]": {
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    }
  }
}